---
// src/pages/cafe/[slug].astro
import { cafesExpanded, cafesCercanos, type CafeExpanded } from '../../lib/cafes';
import mercadoRaw from '../../data/mercado.json';

interface DatosMercado {
  poblacion_500m: number;
  pea_porcentaje: number;
  competidores_500m: number;
  indice_oportunidad: number;
  nivel_socioeconomico: string;
  atractores_500m: number;
  nivel_circulacion?: string;
  comercios_500m?: number;
  turismo_500m?: number;
  transporte_500m?: number;
  fecha_actualizacion: string;
}

export function getStaticPaths() {
  return cafesExpanded.map(c => ({
    params: { slug: c.slug },
    props: { cafe: c }
  }));
}

const { cafe } = Astro.props as { cafe: CafeExpanded };
const cercanos = cafesCercanos(cafe);
const ciudadDisplay = cafe.ciudadReal || cafe.ciudad;
const urlMapa = `/?c=${encodeURIComponent(cafe.ciudad)}&q=${encodeURIComponent(cafe.nombre)}`;

const mercadoMap = mercadoRaw as Record<string, DatosMercado>;
const mercado = mercadoMap[cafe.slug] ?? null;

const datosCiudad = cafesExpanded
  .filter(c => c.ciudad === cafe.ciudad && mercadoMap[c.slug])
  .map(c => mercadoMap[c.slug]);

const promPobCiudad = datosCiudad.length
  ? Math.round(datosCiudad.reduce((acc, d) => acc + d.poblacion_500m, 0) / datosCiudad.length)
  : 0;

const promCompCiudad = datosCiudad.length
  ? Number((datosCiudad.reduce((acc, d) => acc + d.competidores_500m, 0) / datosCiudad.length).toFixed(1))
  : 0;

const diffPobPct = (mercado && promPobCiudad > 0)
  ? Math.round(((mercado.poblacion_500m - promPobCiudad) / promPobCiudad) * 100)
  : 0;

const comercios = mercado?.comercios_500m ?? 0;
const turismo = mercado?.turismo_500m ?? 0;
const transporte = mercado?.transporte_500m ?? 0;
const totalPuntosFlujo = mercado?.atractores_500m ?? (comercios + turismo + transporte);
const nivelCirculacion = mercado?.nivel_circulacion ?? (
  totalPuntosFlujo >= 80 ? 'Muy Alta' : totalPuntosFlujo >= 35 ? 'Alta' : totalPuntosFlujo >= 12 ? 'Media' : 'Baja'
);

function diagnosticarZona(m: DatosMercado, circ: string) {
  const esCluster = m.competidores_500m >= 6;
  const altoFlujo = circ === 'Muy Alta' || circ === 'Alta';

  if (esCluster && altoFlujo) {
    return {
      etiqueta: 'Polo gastronómico consolidado',
      resumen: 'Altísimo tránsito comercial/turístico y público cafetero habitual, pero con fuerte competencia directa (exige propuesta diferencial).'
    };
  }
  if (!esCluster && altoFlujo) {
    return {
      etiqueta: 'Oportunidad de expansión',
      resumen: 'Alto movimiento comercial y turístico con baja saturación de cafeterías de especialidad.'
    };
  }
  if (!esCluster && m.poblacion_500m >= 5000) {
    return {
      etiqueta: 'Oportunidad barrial',
      resumen: 'Buena masa de vecinos estables con poca competencia cercana; ideal para fidelización diaria y take-away.'
    };
  }
  if (esCluster) {
    return {
      etiqueta: 'Alta densidad de oferta',
      resumen: 'Muchos locales concentrados en pocas cuadras; clave analizar horario y diferencial de producto.'
    };
  }
  return {
    etiqueta: 'Zona de nicho / emergente',
    resumen: 'Menor densidad urbana y comercial; funciona mejor como local de destino o punto de paso puntual.'
  };
}

function describirPerfilResidencial(pob: number, diffPct: number, circ: string) {
  if (diffPct <= -15 && (circ === 'Muy Alta' || circ === 'Alta')) {
    return `${diffPct}% vs. prom. ${cafe.ciudad} · Perfil comercial/turístico (casas bajas y locales; el público principal es de paso y turismo).`;
  }
  if (diffPct >= 15) {
    return `+${diffPct}% vs. prom. ${cafe.ciudad} · Perfil residencial denso (edificios y fuerte base de vecinos fijos).`;
  }
  return `${diffPct >= 0 ? `+${diffPct}%` : `${diffPct}%`} vs. prom. ${cafe.ciudad} (${promPobCiudad.toLocaleString('es-AR')} hab. en 500 m).`;
}

function clasificarCompetencia(comp: number, prom: number) {
  if (comp === 0) return 'Sin competidores directos registrados en 500 m.';
  if (comp >= 15) return `Clúster muy alto (prom. ${cafe.ciudad}: ${prom} locales).`;
  if (comp > prom * 1.3) return `Alta vs. prom. ${cafe.ciudad} (${prom} locales).`;
  if (comp >= prom * 0.7) return `En línea con prom. ${cafe.ciudad} (${prom} locales).`;
  return `Baja vs. prom. ${cafe.ciudad} (${prom} locales).`;
}

const diagnostico = mercado ? diagnosticarZona(mercado, nivelCirculacion) : null;
const textoResidencial = mercado ? describirPerfilResidencial(mercado.poblacion_500m, diffPobPct, nivelCirculacion) : '';
const textoCompetencia = mercado ? clasificarCompetencia(mercado.competidores_500m, promCompCiudad) : '';

const esquema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  "name": cafe.nombre,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": cafe.ubicacion || '',
    "addressLocality": ciudadDisplay,
    "addressRegion": cafe.ciudad,
    "addressCountry": "AR"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": cafe.lat, "longitude": cafe.lon }
};
if (cafe.instagram) esquema.sameAs = [cafe.instagram];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f5f0e8" />
  <title>{cafe.nombre} · {ciudadDisplay} | Cofiteca</title>
  <meta name="description" content={`${cafe.nombre}, cafetería de especialidad en ${ciudadDisplay}. ${cafe.ubicacion}. Dirección, ubicación y contacto.`} />

  <meta property="og:title" content={`${cafe.nombre} · Cofiteca`} />
  <meta property="og:description" content={`Cafetería de especialidad en ${ciudadDisplay}.`} />
  <meta property="og:type" content="place" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

  <script type="application/ld+json" set:html={JSON.stringify(esquema)}></script>

  <style is:global>
    :root {
      --coffee-900: #1a0f0a; --coffee-700: #3d2317; --coffee-500: #5c3d2e;
      --tan-500: #c4a77d; --cream-100: #f5f0e8; --cream-50: #faf7f2;
      --accent: #e86a33;
      --radius-sm: 6px; --radius-md: 10px;
      --shadow-sm: 0 1px 3px rgba(26,15,10,.06);
      --shadow-md: 0 4px 15px rgba(26,15,10,.08);
      --font-display: 'Fraunces', Georgia, serif;
      --font-body: 'Inter', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
    html, body { margin: 0; padding: 0; background: var(--cream-100); color: var(--coffee-900); font-family: var(--font-body); overflow-x: hidden; }
    h1, h2, h3, p { overflow-wrap: anywhere; }

    .nav-bar { padding: .9rem 2rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(196,167,125,.3); background: rgba(245,240,232,.92); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 100; }
    .btn-back { display: inline-flex; align-items: center; min-height: 40px; text-decoration: none; color: var(--coffee-900); font-weight: 600; font-size: .85rem; text-transform: uppercase; letter-spacing: .05em; }
    .btn-back:hover { color: var(--accent); }
    .nav-cta { background: var(--coffee-900); color: white; padding: 10px 18px; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; font-size: .8rem; letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; }
    .nav-cta:hover { background: var(--coffee-700); }
    @media (max-width: 600px) {
      .nav-bar { padding: .7rem 1rem; }
      .btn-back { font-size: .75rem; }
      .nav-cta { padding: 9px 12px; font-size: .72rem; }
    }

    .container { max-width: 900px; margin: 2.5rem auto 4rem; padding: 0 1.5rem; }
    @media (max-width: 600px) { .container { margin-top: 1.5rem; padding: 0 1rem; } }

    .hero { margin-bottom: 2rem; }
    .hero .crumbs { font-size: .75rem; color: var(--coffee-500); text-transform: uppercase; letter-spacing: .1em; font-weight: 600; margin-bottom: .6rem; }
    .hero .crumbs a { color: inherit; text-decoration: none; }
    .hero .crumbs a:hover { color: var(--accent); }
    .hero h1 { font-family: var(--font-display); font-variation-settings: 'opsz' 100; font-size: clamp(1.9rem, 6vw, 3.2rem); font-weight: 800; letter-spacing: -.025em; margin: 0 0 1rem; line-height: 1.1; }
    .hero .address { font-size: 1.05rem; color: var(--coffee-700); margin: 0 0 1.2rem; line-height: 1.5; }
    .hero .address b { color: var(--coffee-900); }
    .hero .actions { display: flex; gap: .6rem; flex-wrap: wrap; }
    .hero .actions a,
    .hero .actions button { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 44px; padding: 11px 20px; border-radius: var(--radius-sm); font-family: var(--font-body); font-weight: 600; font-size: .85rem; text-decoration: none; cursor: pointer; transition: .2s; border: 1px solid; }
    @media (max-width: 600px) {
      .hero .actions a,
      .hero .actions button { flex: 1 1 100%; }
    }
    .btn-primary { background: var(--coffee-900); color: white; border-color: var(--coffee-900); }
    .btn-primary:hover { background: var(--coffee-700); border-color: var(--coffee-700); }
    .btn-outline { background: transparent; color: var(--coffee-900); border-color: var(--coffee-900); }
    .btn-outline:hover { background: var(--coffee-900); color: white; }
    .btn-market { background: var(--cream-50); color: var(--coffee-900); border-color: var(--tan-500); }
    .btn-market:hover,
    .btn-market[aria-expanded="true"] { background: var(--accent); color: white; border-color: var(--accent); }

    .market-panel {
      margin-top: 1.1rem;
      padding: 1.35rem;
      border-radius: var(--radius-md);
      background: var(--cream-50);
      border: 1px solid rgba(196,167,125,.45);
      box-shadow: var(--shadow-sm);
    }
    .market-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: .75rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
      padding-bottom: .85rem;
      border-bottom: 1px solid rgba(196,167,125,.3);
    }
    .market-title {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--coffee-900);
      margin: 0 0 .25rem;
    }
    .market-subtitle {
      margin: 0;
      font-size: .82rem;
      color: var(--coffee-500);
      line-height: 1.4;
    }
    .market-badges {
      display: flex;
      gap: .4rem;
      flex-wrap: wrap;
    }
    .market-badge {
      background: rgba(232,106,51,.12);
      color: var(--accent);
      border: 1px solid rgba(232,106,51,.3);
      padding: .3rem .75rem;
      border-radius: 999px;
      font-size: .78rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .market-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: .75rem;
    }
    .market-card {
      background: var(--cream-100);
      padding: .95rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid rgba(196,167,125,.3);
      display: flex;
      flex-direction: column;
      gap: .3rem;
    }
    .market-label {
      font-size: .75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--coffee-500);
    }
    .market-value {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--coffee-900);
      line-height: 1.15;
    }
    .market-value small {
      font-family: var(--font-body);
      font-size: .82rem;
      font-weight: 700;
      color: var(--accent);
    }
    .market-context {
      font-size: .78rem;
      color: var(--coffee-700);
      line-height: 1.4;
    }
    .market-guide {
      margin-top: 1rem;
      padding: .9rem 1rem;
      border-radius: var(--radius-sm);
      background: rgba(196,167,125,.14);
      border-left: 3px solid var(--tan-500);
      font-size: .8rem;
      color: var(--coffee-700);
      line-height: 1.5;
    }
    .market-guide strong {
      color: var(--coffee-900);
      display: block;
      margin-bottom: .3rem;
    }
    .market-guide ul {
      margin: 0;
      padding-left: 1.1rem;
    }
    .market-guide li {
      margin-bottom: .25rem;
    }
    .market-footer {
      margin-top: .85rem;
      font-size: .73rem;
      color: var(--coffee-500);
      display: flex;
      justify-content: space-between;
      gap: .5rem;
      flex-wrap: wrap;
    }

    .map-frame { width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-md); overflow: hidden; border: 1px solid rgba(196,167,125,.4); box-shadow: var(--shadow-md); margin-bottom: 2.5rem; }
    @media (max-width: 600px) { .map-frame { aspect-ratio: 4/3; } }
    .map-frame iframe { width: 100%; height: 100%; border: 0; display: block; }

    .cercanos-title { font-family: var(--font-display); font-variation-settings: 'opsz' 40; font-size: 1.5rem; font-weight: 800; letter-spacing: -.02em; margin: 0 0 1.2rem; }
    .cercanos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(220px,100%), 1fr)); gap: 1rem; }
    .cercano-card { background: var(--cream-50); padding: 1.2rem; border-radius: var(--radius-md); border: 1px solid rgba(196,167,125,.25); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; display: block; transition: .2s; }
    .cercano-card:hover { transform: translateY(-3px); border-color: var(--tan-500); box-shadow: var(--shadow-md); }
    .cercano-card h3 { font-family: var(--font-display); font-size: 1.05rem; margin: 0 0 .4rem; color: var(--coffee-900); font-weight: 800; }
    .cercano-card p { margin: 0; font-size: .85rem; color: var(--coffee-500); line-height: 1.5; }
  </style>
</head>
<body>
  <nav class="nav-bar">
    <a href="/" class="btn-back">← Volver al mapa</a>
    <a href={urlMapa} class="nav-cta">Ver en el mapa</a>
  </nav>

  <main class="container">
    <header class="hero">
      <div class="crumbs">
        <a href="/">Cofiteca</a> · {cafe.ciudad}
      </div>
      <h1>{cafe.nombre}</h1>
      <p class="address">
        📍 <b>{cafe.ubicacion || 'Dirección no informada'}</b>
        {ciudadDisplay && cafe.ubicacion ? `, ${ciudadDisplay}` : ciudadDisplay}
      </p>
      <div class="actions">
        {cafe.instagram && (
          <a href={cafe.instagram} target="_blank" rel="noopener noreferrer" class="btn-primary">Instagram</a>
        )}
        <a href={`https://www.google.com/maps/search/?api=1&query=${cafe.lat},${cafe.lon}`} target="_blank" rel="noopener noreferrer" class="btn-outline">Cómo llegar</a>
        <a href={urlMapa} class="btn-outline">Ver en el mapa interactivo</a>
        {mercado && (
          <button id="btn-mercado" type="button" class="btn-market" aria-expanded="false" aria-controls="panel-mercado">
            📊 Datos de mercado
          </button>
        )}
      </div>

      {mercado && diagnostico && (
        <section id="panel-mercado" class="market-panel" hidden>
          <div class="market-header">
            <div>
              <h2 class="market-title">Radiografía comercial · Radio 500 m (~6 cuadras)</h2>
              <p class="market-subtitle">
                Benchmark de entorno para evaluar apertura de locales, saturación y flujo turístico en <b>{cafe.ciudad}</b>.
              </p>
            </div>
            <div class="market-badges">
              <span class="market-badge">Circulación: {nivelCirculacion}</span>
              <span class="market-badge">{diagnostico.etiqueta}</span>
            </div>
          </div>

          <div class="market-grid">
            <div class="market-card">
              <span class="market-label">Circulación y turismo</span>
              <span class="market-value">{nivelCirculacion} <small>({totalPuntosFlujo} polos)</small></span>
              <span class="market-context">
                <b>{comercios}</b> comercios/gastro · <b>{turismo}</b> hoteles/turismo · <b>{transporte}</b> paradas/polos diarios.
              </span>
            </div>

            <div class="market-card">
              <span class="market-label">Residentes fijos (500 m)</span>
              <span class="market-value">{mercado.poblacion_500m.toLocaleString('es-AR')} <small>hab.</small></span>
              <span class="market-context">{textoResidencial}</span>
            </div>

            <div class="market-card">
              <span class="market-label">Competencia cercana</span>
              <span class="market-value">{mercado.competidores_500m} <small>locales</small></span>
              <span class="market-context">{textoCompetencia}</span>
            </div>

            <div class="market-card">
              <span class="market-label">Diagnóstico e índice ({mercado.indice_oportunidad} pts)</span>
              <span class="market-value" style="font-size: 1.1rem;">{diagnostico.etiqueta}</span>
              <span class="market-context">{diagnostico.resumen}</span>
            </div>
          </div>

          <div class="market-guide">
            <strong>¿A qué apunta este análisis y cómo leerlo?</strong>
            <ul>
              <li><b>Objetivo:</b> Medir el equilibrio entre residentes estables, tránsito comercial/turístico y cafeterías competidoras registradas en Cofiteca dentro de 6 cuadras.</li>
              <li><b>Clúster vs. barrio:</b> En polos como Palermo o Güemes, tener muchos competidores juntos confirma que hay demanda probada, pero exige diferenciación fuerte; en zonas residenciales con pocos cafés prima la captación de vecinos diarios.</li>
              <li><b>Escala del índice:</b> Combina población fija + densidad comercial/turística dividida por la oferta cafetera activa (más de <b>12 pts</b> indica margen de expansión; menos de <b>6 pts</b> indica alta competencia por local).</li>
            </ul>
          </div>

          <div class="market-footer">
            <span>Fuentes: INDEC Censo 2022, OpenStreetMap Argentina (Geofabrik) y base Cofiteca</span>
            <span>Actualizado: {mercado.fecha_actualizacion}</span>
          </div>
        </section>
      )}
    </header>

    <div class="map-frame">
      <iframe
        src={`https://maps.google.com/maps?q=${cafe.lat},${cafe.lon}&z=16&output=embed`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Mapa de ${cafe.nombre}`}>
      </iframe>
    </div>

    {cercanos.length > 0 && (
      <section>
        <h2 class="cercanos-title">Cerca de {cafe.nombre}</h2>
        <div class="cercanos-grid">
          {cercanos.map(c => (
            <a href={`/cafe/${c.slug}`} class="cercano-card">
              <h3>{c.nombre}</h3>
              <p>📍 {c.ubicacion || 'Sin dirección'} · {c.ciudadReal || c.ciudad}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <script>
    const btnMercado = document.getElementById('btn-mercado');
    const panelMercado = document.getElementById('panel-mercado');
    btnMercado?.addEventListener('click', () => {
      if (!panelMercado) return;
      const abierto = !panelMercado.hidden;
      panelMercado.hidden = abierto;
      btnMercado.setAttribute('aria-expanded', String(!abierto));
    });
  </script>
</body>
</html>
