        window.cofiEnfocarOportunidad = function (idx) {
          var item = marcadoresOppPorIdx[idx];
          if (!item || !mapaMercado) return;
          document.querySelector('#vista-mercado .map-wrapper').scrollIntoView({ behavior: 'smooth', block: 'center' });
          mapaMercado.setView([item.lat, item.lon], 15);
          item.marker.openPopup();
        };

        function calcularPerCapita(nLocales, poblacion) {
          if (!poblacion || poblacion <= 0 || nLocales <= 0) return null;
          return {
            poblacion: poblacion,
            habPorCafe: Math.round(poblacion / nLocales),
            cada100k: Number(((nLocales / poblacion) * 100000).toFixed(1))
          };
        }

        function resumirGrupoMercado(items, poblacion) {
          var n = items.length || 1;
          var promTicket = Number((items.reduce(function (s, x) { return s + x.mkt.t; }, 0) / n).toFixed(2));
          var promOp = Number((items.reduce(function (s, x) { return s + x.mkt.o; }, 0) / n).toFixed(1));
          var promComp = Number((items.reduce(function (s, x) { return s + x.mkt.k; }, 0) / n).toFixed(1));
          var nivelGasto = promTicket >= 1.32 ? 'Muy Alto' : promTicket >= 1.18 ? 'Alto' : promTicket < 1.04 ? 'Medio' : 'Medio-Alto';
          return { n: items.length, promTicket: promTicket, nivelGasto: nivelGasto, promOp: promOp, promComp: promComp, perCap: calcularPerCapita(items.length, poblacion) };
        }

        function obtenerColorTendencia(capa, stats) {
          if (capa === 'ticket') {
            if (stats.promTicket >= 1.32) return { hex: '#1b7f5c', label: 'Ticket Muy Alto (≥ ×1.32)' };
            if (stats.promTicket >= 1.18) return { hex: '#e86a33', label: 'Ticket Alto (×1.18 – ×1.31)' };
            if (stats.promTicket >= 1.06) return { hex: '#d49b35', label: 'Ticket Medio-Alto (×1.06 – ×1.17)' };
            return { hex: '#5c3d2e', label: 'Ticket Medio (< ×1.06)' };
          }
          if (capa === 'densidad') {
            if (!stats.perCap) return { hex: '#8c7a6b', label: 'Sin dato censal de barrio' };
            if (stats.perCap.habPorCafe >= 10000) return { hex: '#1b7f5c', label: 'Baja saturación (1 c/ +10k hab.)' };
            if (stats.perCap.habPorCafe >= 4500) return { hex: '#e86a33', label: 'Presencia media (1 c/ 4.5k–10k hab.)' };
            if (stats.perCap.habPorCafe >= 2000) return { hex: '#d49b35', label: 'Alta presencia (1 c/ 2k–4.5k hab.)' };
            return { hex: '#5c3d2e', label: 'Polo muy denso (1 c/ <2k hab.)' };
          }
          if (stats.promOp >= 12.0) return { hex: '#1b7f5c', label: 'Alta oportunidad (≥ 12.0 pts)' };
          if (stats.promOp >= 8.5) return { hex: '#e86a33', label: 'Buen potencial (8.5 – 11.9 pts)' };
          if (stats.promOp >= 5.5) return { hex: '#d49b35', label: 'Equilibrado (5.5 – 8.4 pts)' };
          return { hex: '#5c3d2e', label: 'Alta competencia (< 5.5 pts)' };
        }

        function renderLeyendaMercado(capa, tituloPlaza) {
          if (capa === 'potencial') {
            $('mkt-legend').innerHTML =
              '<div class="mkt-legend-title">Análisis · ' + esc(tituloPlaza) + '</div>' +
              '<div class="mkt-legend-items">' +
                '<div class="mkt-legend-row"><span class="mkt-dot" style="background:#e86a33"></span><span>Zona en desarrollo (expansión)</span></div>' +
                '<div class="mkt-legend-row"><span class="mkt-dot" style="background:#1b7f5c"></span><span>Polo gastronómico consolidado</span></div>' +
                '<div class="mkt-legend-row"><span class="mkt-dot" style="background:#c4a77d;opacity:.6"></span><span>Locales existentes (referencia)</span></div>' +
              '</div>';
            return;
          }
          var titulos = { ticket: 'Nivel de Gasto por Local', densidad: 'Saturación · Cafés / Habitante' };
          var escalas = {
            ticket: [['#1b7f5c', 'Muy Alto (≥ ×1.32)'], ['#e86a33', 'Alto (×1.18 – ×1.31)'], ['#d49b35', 'Medio-Alto (×1.06 – ×1.17)'], ['#5c3d2e', 'Medio (< ×1.06)']],
            densidad: [['#1b7f5c', 'Baja saturación (+10k hab./café)'], ['#e86a33', 'Media (4.5k – 10k hab./café)'], ['#d49b35', 'Alta (2k – 4.5k hab./café)'], ['#5c3d2e', 'Muy denso (< 2k hab./café)']]
          };
          $('mkt-legend').innerHTML =
            '<div class="mkt-legend-title">' + titulos[capa] + '</div>' +
            '<div class="mkt-legend-items">' +
              escalas[capa].map(function (par) {
                return '<div class="mkt-legend-row"><span class="mkt-dot" style="background:' + par[0] + '"></span><span>' + par[1] + '</span></div>';
              }).join('') +
            '</div>';
        }

        window.cofiRenderMercado = function (recentrar) {
          var ciu = $('select-mercado-ciudad').value;
          var zon = $('select-mercado-zona').value;
          var capa = $('select-mercado-capa').value;
          var esNacional = ciu === 'Todas';

          var scopeItems = esNacional
            ? baseDatos
            : baseDatos.filter(function (c) { return c.ciudad === ciu && (zon === 'Todas' || c.zona === zon); });

          var pobScope = null;
          var notaPob = '';
          if (esNacional) {
            pobScope = POB_PAIS_TOTAL;
            notaPob = 'Base total país Censo 2022 (~46,0M hab.).';
          } else if (zon !== 'Todas') {
            var pobBarrio = POB_ZONAS.get(norm(zon));
            if (pobBarrio) {
              pobScope = pobBarrio;
              notaPob = 'Población censal de ' + zon + ': ' + pobBarrio.toLocaleString('es-AR') + ' hab.';
            } else {
              var itemsCiu = baseDatos.filter(function (c) { return c.ciudad === ciu; });
              var perCapCiu = calcularPerCapita(itemsCiu.length, POB_REGIONES.get(norm(ciu)));
              notaPob = perCapCiu
                ? 'Sin censo de barrio · Total ' + ciu + ': 1 café c/ ' + perCapCiu.habPorCafe.toLocaleString('es-AR') + ' hab.'
                : 'Sin desagregación censal individual para este barrio.';
            }
          } else {
            pobScope = POB_REGIONES.get(norm(ciu)) || null;
            notaPob = pobScope ? 'Población Censo 2022: ' + pobScope.toLocaleString('es-AR') + ' hab.' : '';
          }

          var agg = resumirGrupoMercado(scopeItems.length ? scopeItems : baseDatos, pobScope);
          var colorKpiTicket = obtenerColorTendencia('ticket', agg);
          var colorKpiPot = obtenerColorTendencia('potencial', agg);
          var colorKpiDen = obtenerColorTendencia('densidad', agg);

          var pctTicket = Math.min(100, Math.round(((agg.promTicket - 0.8) / 0.7) * 100));
          var pctPot = Math.min(100, Math.round((agg.promOp / 20) * 100));
          var pctDen = agg.perCap ? Math.min(100, Math.round((agg.perCap.cada100k / 45) * 100)) : 20;

          var htmlPerCapVal = agg.perCap
            ? '1 café c/ ' + agg.perCap.habPorCafe.toLocaleString('es-AR') + ' <small>hab. (' + agg.perCap.cada100k + ' / 100k)</small>'
            : 'Sin dato de barrio';

          $('mkt-kpis').innerHTML =
            '<div class="mkt-kpi-card"><span class="mkt-kpi-lbl">Ticket y Poder de Gasto</span><span class="mkt-kpi-val">' + esc(agg.nivelGasto) + ' <small>· ×' + agg.promTicket.toFixed(2) + '</small></span><div class="mkt-bar-bg"><div class="mkt-bar-fill" style="width:' + pctTicket + '%;background:' + colorKpiTicket.hex + '"></div></div><span class="mkt-kpi-sub">Capacidad de consumo promedio frente a la media nacional (×1.00).</span></div>' +
            '<div class="mkt-kpi-card"><span class="mkt-kpi-lbl">Potencial de Expansión</span><span class="mkt-kpi-val">' + agg.promOp + ' pts <small>· ' + agg.n + ' locales</small></span><div class="mkt-bar-bg"><div class="mkt-bar-fill" style="width:' + pctPot + '%;background:' + colorKpiPot.hex + '"></div></div><span class="mkt-kpi-sub">' + (agg.promOp >= 11 ? 'Buen margen de demanda frente a competencia directa.' : 'Plaza madura con competencia activa; requiere diferencial.') + '</span></div>' +
            '<div class="mkt-kpi-card"><span class="mkt-kpi-lbl">Cafeterías por Habitante</span><span class="mkt-kpi-val">' + htmlPerCapVal + '</span><div class="mkt-bar-bg"><div class="mkt-bar-fill" style="width:' + pctDen + '%;background:' + colorKpiDen.hex + '"></div></div><span class="mkt-kpi-sub">' + esc(notaPob) + '</span></div>';

          var etiquetaPlazaActual = esNacional ? 'Todo el País' : (zon !== 'Todas' ? zon + ' · ' + ciu : ciu);
          renderLeyendaMercado(capa, etiquetaPlazaActual);

          var gruposMap = new Map();
          if (esNacional) {
            baseDatos.forEach(function (c) {
              if (!gruposMap.has(c.ciudad)) gruposMap.set(c.ciudad, []);
              gruposMap.get(c.ciudad).push(c);
            });
          } else {
            baseDatos.filter(function (c) { return c.ciudad === ciu; }).forEach(function (c) {
              var z = (c.zona && c.zona !== '-' && c.zona !== 'Sin Zona') ? c.zona : 'Otras zonas';
              if (!gruposMap.has(z)) gruposMap.set(z, []);
              gruposMap.get(z).push(c);
            });
          }

          var listaGrupos = Array.from(gruposMap.entries()).map(function (entry) {
            var nombre = entry[0], items = entry[1];
            var pobG = esNacional ? POB_REGIONES.get(norm(nombre)) : POB_ZONAS.get(norm(nombre));
            var st = resumirGrupoMercado(items, pobG);
            var col = obtenerColorTendencia(capa === 'potencial' ? 'ticket' : capa, st);
            return Object.assign({ nombre: nombre, color: col.hex }, st);
          }).sort(function (a, b) { return b.n - a.n; });

          var zonasRec = obtenerZonasRecomendadasDinamicas(ciu, zon);

          if (mapaMercado && capaPuntosMercado && capaOportunidadMercado) {
            capaPuntosMercado.clearLayers();
            capaOportunidadMercado.clearLayers();
            marcadoresOppPorIdx = [];
            var puntosMostrar = scopeItems.length ? scopeItems : baseDatos;

            if (capa === 'potencial') {
              puntosMostrar.forEach(function (c) {
                var dot = L.circleMarker([c.lat, c.lon], { radius: esNacional ? 3.5 : 5, color: '#ffffff', weight: 1, fillColor: '#b89f82', fillOpacity: 0.55 });
                dot.bindPopup('<div class="popup-cafe"><b>' + esc(c.nombre) + '</b><small>' + esc(c.zona || c.ciudadReal || c.ciudad) + '</small><br>Local existente · Ticket ×' + c.mkt.t.toFixed(2) + '</div>');
                capaPuntosMercado.addLayer(dot);
              });

              zonasRec.forEach(function (z, idx) {
                var colorPin = z.esEnDesarrollo ? '#e86a33' : '#1b7f5c';
                if (!esNacional) {
                  capaOportunidadMercado.addLayer(L.circle([z.latitud, z.longitud], { radius: 350, color: colorPin, weight: 2, dashArray: '5, 5', fillColor: colorPin, fillOpacity: 0.14 }));
                }
                var pinIcon = L.divIcon({
                  html: '<div style="background:' + colorPin + ';color:#fff;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;border:2.5px solid #fff;box-shadow:0 3px 10px rgba(0,0,0,.35);">#' + (idx + 1) + '</div>',
                  className: 'custom-opp-pin', iconSize: [30, 30], iconAnchor: [15, 15]
                });
                var markerOpp = L.marker([z.latitud, z.longitud], { icon: pinIcon }).bindPopup(
                  '<div class="popup-cafe" style="text-align:left;min-width:235px;">' +
                    '<div style="font-size:.68rem;font-weight:800;color:' + colorPin + ';text-transform:uppercase;">★ #' + (idx + 1) + ' · ' + esc(z.tipoCorredor) + ' (' + z.score_potencial + ' pts)</div>' +
                    '<b style="text-align:left;margin-top:2px;">' + esc(z.corredor) + '</b>' +
                    '<small style="display:block;color:#5c3d2e;margin-bottom:6px;">' + esc(z.plaza) + '</small>' +
                    '• <b>Ecosistema (1.5 km):</b> ' + z.vecinos_1500m + ' café(s) de especialidad<br>' +
                    '• <b>Competencia directa (350 m):</b> ' + z.vecinos_350m + ' local(es)<br>' +
                    '• <b>Gasto promedio:</b> ' + esc(z.nivel_gasto) + ' (×' + z.indice_ticket + ')<br>' +
                    '• <b>Perfil:</b> ' + esc(z.publico_objetivo) +
                  '</div>'
                );
                capaOportunidadMercado.addLayer(markerOpp);
                marcadoresOppPorIdx.push({ lat: z.latitud, lon: z.longitud, marker: markerOpp });
              });
            } else {
              puntosMostrar.forEach(function (c) {
                var pobZ = POB_ZONAS.get(norm(c.zona)) || POB_REGIONES.get(norm(c.ciudad));
                var cantZ = (c.zona && gruposMap.has(c.zona)) ? gruposMap.get(c.zona).length : (gruposMap.get(c.ciudad) ? gruposMap.get(c.ciudad).length : 1);
                var perCapPunto = calcularPerCapita(cantZ, pobZ);
                var colPunto = obtenerColorTendencia(capa, { promTicket: c.mkt.t, promOp: c.mkt.o, perCap: perCapPunto });
                var dot = L.circleMarker([c.lat, c.lon], { radius: esNacional ? 5 : 7.5, color: '#ffffff', weight: 1.5, fillColor: colPunto.hex, fillOpacity: 0.95 });
                var habHtml = perCapPunto ? '<br>👥 Zona: <b>1 c/ ' + perCapPunto.habPorCafe.toLocaleString('es-AR') + ' hab.</b>' : '';
                dot.bindPopup('<div class="popup-cafe"><b>' + esc(c.nombre) + '</b><small>' + esc(c.zona || c.ciudadReal || c.ciudad) + '</small><br>💳 Ticket: <b>×' + c.mkt.t.toFixed(2) + '</b> (' + esc(c.mkt.g) + ')<br>🚶 Circulación: <b>' + esc(c.mkt.c || 'Media') + '</b> · Comp. 500m: <b>' + c.mkt.k + '</b>' + habHtml + '<div class="popup-acciones"><a href="/cafe/' + esc(c.slug) + '" class="popup-link">Ver ficha completa</a></div></div>');
                capaPuntosMercado.addLayer(dot);
              });
            }

            if (recentrar) {
              if (esNacional) mapaMercado.setView(VISTA_ARGENTINA, zoomInicial());
              else if (puntosMostrar.length) mapaMercado.fitBounds(L.latLngBounds(puntosMostrar.map(function (c) { return [c.lat, c.lon]; })), { padding: [45, 45], maxZoom: 15 });
            }
          }

          var resetBtn = $('mkt-reset-btn');
          var grid = $('mkt-zones-grid');

          if (capa === 'potencial') {
            resetBtn.classList.toggle('hidden', esNacional);
            $('mkt-zones-title').textContent = esNacional
              ? 'Polos gastronómicos y zonas en desarrollo a nivel nacional'
              : 'Polos gastronómicos y zonas en desarrollo en ' + etiquetaPlazaActual;
            grid.className = 'mkt-opp-grid';
            grid.innerHTML = zonasRec.map(function (z, idx) {
              var claseCard = z.esEnDesarrollo ? 'mkt-opp-card en-desarrollo' : 'mkt-opp-card';
              return (
                '<div class="' + claseCard + '">' +
                  '<div>' +
                    '<div class="mkt-opp-badge">★ #' + (idx + 1) + ' · Puntaje ' + z.score_potencial + ' / 20</div>' +
                    '<div><span class="mkt-opp-tag">' + esc(z.tipoCorredor) + '</span></div>' +
                    '<div class="mkt-opp-title">' + esc(z.corredor) + '</div>' +
                    '<div class="mkt-opp-sub">' + esc(z.plaza) + (z.direccionRef ? ' · Ref: ' + esc(z.direccionRef) : '') + '</div>' +
                    '<ul class="mkt-opp-criteria">' +
                      '<li>🏘️ <b>Ecosistema cercano (1.5 km):</b> ' + z.vecinos_1500m + ' cafetería(s) de especialidad activas</li>' +
                      '<li>☕ <b>Saturación inmediata (350 m):</b> ' + z.vecinos_350m + ' local(es) en el radio directo</li>' +
                      '<li>💳 <b>Poder de gasto del entorno:</b> ' + esc(z.nivel_gasto) + ' (ticket promedio ×' + z.indice_ticket + ')</li>' +
                      '<li>🎯 <b>Dinámica de demanda:</b> ' + esc(z.publico_objetivo) + '</li>' +
                    '</ul>' +
                  '</div>' +
                  '<button type="button" class="mkt-opp-btn" onclick="cofiEnfocarOportunidad(' + idx + ')">Ver microzona en el mapa</button>' +
                '</div>'
              );
            }).join('');
            return;
          }

          grid.className = 'mkt-zones-grid';
          if (esNacional) {
            resetBtn.classList.add('hidden');
            $('mkt-zones-title').textContent = 'Comparativa por Ciudad / Región (clic para ver barrios)';
            grid.innerHTML = listaGrupos.map(function (g) {
              var perCapLine = g.perCap ? '👥 1 café c/ ' + g.perCap.habPorCafe.toLocaleString('es-AR') + ' hab. <span>(' + g.perCap.cada100k + '/100k)</span>' : '👥 ' + g.n + ' cafeterías en la región';
              return '<button type="button" class="mkt-zone-card" style="border-left-color:' + g.color + '" onclick="cofiSeleccionarCiudadMercado(\'' + esc(g.nombre) + '\')"><div class="mkt-zone-top"><span class="mkt-zone-name">' + esc(g.nombre.replace(' y Gran Buenos Aires', '')) + '</span><span class="mkt-zone-count">' + g.n + ' loc.</span></div><div class="mkt-zone-percap">' + perCapLine + '</div><div class="mkt-zone-stats"><span>💳 Ticket: <b>×' + g.promTicket.toFixed(2) + '</b></span><span>📈 Potencial: <b>' + g.promOp + ' pts</b></span></div></button>';
            }).join('');
          } else {
            resetBtn.classList.remove('hidden');
            $('mkt-zones-title').textContent = 'Barrios y Zonas en ' + ciu + ' (clic para enfocar)';
            var barriosMostrar = listaGrupos.filter(function (g) { return g.nombre !== 'Otras zonas'; });
            if (!barriosMostrar.length) {
              grid.innerHTML = '<div style="font-size:.82rem;color:var(--coffee-500);">Esta región aún no tiene barrios subdivididos en la base.</div>';
              return;
            }
            grid.innerHTML = barriosMostrar.map(function (g) {
              var activo = zon === g.nombre ? ' active' : '';
              var perCapLine = g.perCap ? '👥 1 café c/ ' + g.perCap.habPorCafe.toLocaleString('es-AR') + ' hab. <span>(' + g.perCap.cada100k + '/100k)</span>' : '<span>Sin dato censal de barrio</span>';
              return '<button type="button" class="mkt-zone-card' + activo + '" style="border-left-color:' + g.color + '" onclick="cofiSeleccionarZonaMercado(\'' + esc(g.nombre) + '\')"><div class="mkt-zone-top"><span class="mkt-zone-name">' + esc(g.nombre) + '</span><span class="mkt-zone-count">' + g.n + ' loc.</span></div><div class="mkt-zone-percap">' + perCapLine + '</div><div class="mkt-zone-stats"><span>💳 Ticket: <b>×' + g.promTicket.toFixed(2) + '</b></span><span>📈 Potencial: <b>' + g.promOp + ' pts</b></span></div></button>';
            }).join('');
          }
        };

        // ---------- Mapa Principal ----------
        function initMapa() {
          if (typeof L === 'undefined' || mapaCofiteca) return;
          mapaCofiteca = L.map('cofiteca-map', { minZoom: 3, maxZoom: 19, zoomSnap: 0.5 }).setView(VISTA_ARGENTINA, zoomInicial());
          agregarCapaBase(mapaCofiteca);
          markerCluster = crearGrupoMarcadores(mapaCofiteca, { maxClusterRadius: 40, disableClusteringAtZoom: 14, spiderfyOnMaxZoom: true, showCoverageOnHover: false, chunkedLoading: true });
          mapaCofiteca.on('zoomend moveend', actualizarEtiquetas);

          baseDatos.forEach(function (c) {
            var m = L.circleMarker([c.lat, c.lon], Object.assign({}, ESTILO_BASE));
            m._nombre = c.nombre;
            m.bindPopup(function () { return popupHTML(baseDatos[c.id]); }, { maxWidth: 260 });
            m.on('click', function () { registrarVisto(c.id); resaltarCard(c.id); renderRecientes(); });
            m.on('popupopen', function () { resaltarMarker(c.id); });
            m.on('popupclose', quitarResaltadoMarker);
            markersPorId.set(c.id, m);
          });
          setTimeout(function () { mapaCofiteca.invalidateSize(); }, 200);
          var vieneConFiltro = $('input-busqueda').value.trim() !== '' || $('select-ciudad').value !== 'Todas';
          dibujarMapa(listaActual, vieneConFiltro);
        }

        function popupHTML(c) {
          var ig = c.instagram ? '<a href="' + esc(c.instagram) + '" target="_blank" rel="noopener noreferrer" class="popup-btn">Instagram</a>' : '';
          var enLista = idsEnLista.has(c.id) ? '<a href="#" class="popup-link" onclick="cofiVerEnLista(' + c.id + '); return false;">Ver en la lista ↓</a>' : '';
          var detalle = '<a href="/cafe/' + esc(c.slug) + '" class="popup-link">Ver ficha completa</a>';
          return '<div class="popup-cafe"><b>' + esc(c.nombre) + '</b><small>' + esc(c.ubicacion) + '</small><div class="popup-acciones">' + ig + detalle + enLista + '</div></div>';
        }

        function quitarResaltadoMarker() {
          if (!mapaCofiteca) return;
          if (markerActivoId !== null) {
            var m = markersPorId.get(markerActivoId);
            if (m) m.setStyle(Object.assign({}, estiloBase(markerActivoId)));
            markerActivoId = null;
          }
          if (haloActivo) { mapaCofiteca.removeLayer(haloActivo); haloActivo = null; }
        }
        function resaltarMarker(id) {
          if (!mapaCofiteca) return;
          quitarResaltadoMarker();
          var m = markersPorId.get(id);
          if (!m) return;
          markerActivoId = id;
          m.setStyle(Object.assign({}, ESTILO_ACTIVO));
          haloActivo = L.circleMarker(m.getLatLng(), { radius: 22, weight: 0, fillColor: '#e86a33', fillOpacity: .3, interactive: false, className: 'cofi-halo' }).addTo(mapaCofiteca);
          if (m._map) m.bringToFront();
        }

        function actualizarEtiquetas() {
          if (!mapaCofiteca) return;
          if (mapaCofiteca.getZoom() < ZOOM_ETIQUETAS) {
            marcadoresConEtiqueta.forEach(function (m) { m.unbindTooltip(); m._tt = false; });
            marcadoresConEtiqueta = [];
            return;
          }
          var area = mapaCofiteca.getBounds().pad(0.2);
          marcadoresActuales.forEach(function (m) {
            if (!m._tt && area.contains(m.getLatLng())) {
              m.bindTooltip(esc(m._nombre), { permanent: true, direction: 'top', className: 'cafe-label', offset: [0, -10] });
              m._tt = true;
              marcadoresConEtiqueta.push(m);
            }
          });
        }

        function dibujarMapa(lista, recentrar) {
          if (!mapaCofiteca || !markerCluster) return;
          quitarResaltadoMarker();
          marcadoresConEtiqueta.forEach(function (m) { m.unbindTooltip(); m._tt = false; });
          marcadoresConEtiqueta = [];

          var nuevoSet = new Set(lista.map(function (c) { return c.id; }));
          var idsQuitar = [], aAgregar = [];
          idsEnMapa.forEach(function (id) { if (!nuevoSet.has(id)) idsQuitar.push(id); });
          nuevoSet.forEach(function (id) { if (!idsEnMapa.has(id)) aAgregar.push(markersPorId.get(id)); });
          var aQuitar = idsQuitar.map(function (id) { return markersPorId.get(id); });

          if (typeof markerCluster.removeLayers === 'function') {
            if (aQuitar.length) markerCluster.removeLayers(aQuitar);
            if (aAgregar.length) markerCluster.addLayers(aAgregar);
          } else {
            aQuitar.forEach(function (m) { markerCluster.removeLayer(m); });
            aAgregar.forEach(function (m) { markerCluster.addLayer(m); });
          }
          idsEnMapa = nuevoSet;
          marcadoresActuales = lista.map(function (c) { return markersPorId.get(c.id); });

          idsQuitar.forEach(function (id) { markersPorId.get(id).setStyle(Object.assign({}, ESTILO_BASE)); });
          lista.forEach(function (c) { markersPorId.get(c.id).setStyle(Object.assign({}, estiloBase(c.id))); });

          if (recentrar) {
            var ciu = $('select-ciudad').value, zon = $('select-zona').value;
            if (ciu === 'Todas' && zon === 'Todas' && !busquedaActiva && !origen && !soloFavoritos) {
              mapaCofiteca.setView(VISTA_ARGENTINA, zoomInicial());
            } else if (lista.length) {
              mapaCofiteca.fitBounds(L.latLngBounds(lista.map(function (c) { return [c.lat, c.lon]; })), { padding: [40, 40], maxZoom: 17 });
            }
          }
          if (busquedaActiva && lista.length === 1) resaltarMarker(lista[0].id);
          actualizarEtiquetas();
        }

        // ---------- Lista ----------
        function setLista(lista) {
          listaActual = lista;
          idsEnLista = new Set(lista.map(function (c) { return c.id; }));
          mostrados = PAGINA;
          idDestacado = null;
          renderizarLista();
        }

        function crearCard(c) {
          var div = document.createElement('div');
          div.className = 'cafe-card' + (c.id === idDestacado ? ' destacada' : '');
          div.dataset.id = c.id;

          var dist = c.dist !== undefined ? '<br><b>📍 ' + textoDistancia(c.dist) + '</b>' : '';
          var ig = c.instagram ? '<a href="' + esc(c.instagram) + '" target="_blank" rel="noopener noreferrer">Instagram</a>' : '';
          var rank = rankMap.get(c.id);
          var badge = rank ? ' <span class="card-badge">#' + rank + ' top</span>' : '';
          var favActivo = favoritos.has(c.id) ? 'is-fav' : '';
          var favIcon = favoritos.has(c.id) ? '★' : '☆';

          div.innerHTML =
            '<button class="fav-btn ' + favActivo + '" data-fav="' + c.id + '" aria-label="Favorito">' + favIcon + '</button>' +
            '<div><h3><a href="/cafe/' + esc(c.slug) + '">' + esc(c.nombre) + '</a>' + badge + '</h3>' +
            '<p>' + esc(c.ubicacion) + ' • <b>' + esc(c.ciudadReal || c.ciudad) + '</b>' + dist + '</p></div>' +
            '<div class="cafe-actions"><button type="button" data-ver-mapa>Ver en mapa</button>' + ig + '<a href="' + urlComoLlegar(c) + '" target="_blank" rel="noopener noreferrer">Cómo llegar</a></div>';

          div.querySelector('.fav-btn').addEventListener('click', function (e) {
            e.stopPropagation();
            window.cofiToggleFav(c.id, e.currentTarget);
          });
          div.querySelector('[data-ver-mapa]').addEventListener('click', function () { verEnMapa(c.id); });
          return div;
        }

        function renderizarLista() {
          var cont = $('cofi-resultados');
          var frag = document.createDocumentFragment();
          if (!listaActual.length) {
            var empty = document.createElement('div');
            empty.className = 'msg-vacio';
            empty.innerHTML = '<span class="emoji">☕</span><h3>Sin resultados</h3><p>Probá con menos filtros o buscá cerca tuyo.</p><button onclick="cofiUsarMiGPS()">Cerca de mi ubicación</button>';
            frag.appendChild(empty);
          } else {
            listaActual.slice(0, mostrados).forEach(function (c) { frag.appendChild(crearCard(c)); });
            if (listaActual.length > mostrados) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'btn-ver-mas';
              btn.textContent = 'Ver más (' + (listaActual.length - mostrados) + ' restantes)';
              btn.addEventListener('click', function () { mostrados += PAGINA; renderizarLista(); });
              frag.appendChild(btn);
            }
          }
          cont.replaceChildren(frag);
          $('cofi-count').textContent = listaActual.length
            ? 'Mostrando ' + Math.min(mostrados, listaActual.length) + ' de ' + listaActual.length + ' locales'
            : '';
        }

        function verEnMapa(id) {
          var c = baseDatos[id];
          var m = markersPorId.get(id);
          registrarVisto(id);
          renderRecientes();
          resaltarCard(id);
          if (!mapaCofiteca || !m) return;
          document.querySelector('#vista-mapa .map-wrapper').scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (typeof markerCluster.zoomToShowLayer === 'function' && markerCluster.hasLayer(m)) {
            markerCluster.zoomToShowLayer(m, function () { m.openPopup(); });
          } else {
            mapaCofiteca.setView([c.lat, c.lon], 16);
            m.openPopup();
          }
        }

        function resaltarCard(id) {
          idDestacado = id;
          document.querySelectorAll('#cofi-resultados .cafe-card.destacada').forEach(function (el) { el.classList.remove('destacada'); });
          var el = document.querySelector('#cofi-resultados .cafe-card[data-id="' + id + '"]');
          if (el) el.classList.add('destacada');
        }

        window.cofiVerEnLista = function (id) {
          var idx = listaActual.findIndex(function (c) { return c.id === id; });
          if (idx === -1) return;
          if (idx >= mostrados) { mostrados = idx + 1; renderizarLista(); }
          resaltarCard(id);
          var el = document.querySelector('#cofi-resultados .cafe-card[data-id="' + id + '"]');
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        };

        window.cofiActualizarZonas = function () {
          var ciu = $('select-ciudad').value;
          var base = ciu === 'Todas' ? baseDatos : baseDatos.filter(function (c) { return c.ciudad === ciu; });
          var zonas = Array.from(new Set(base.map(function (c) { return c.zona; }))).filter(function (z) { return z && z !== '-' && z !== 'Sin Zona'; }).sort(function (a, b) { return a.localeCompare(b, 'es'); });
          $('select-zona').innerHTML = '<option value="Todas">Zona / Barrio</option>' + zonas.map(function (z) { return '<option value="' + esc(z) + '">' + esc(z) + '</option>'; }).join('');
        };

        function filtrarDatos() {
          var ciu = $('select-ciudad').value;
          var zon = $('select-zona').value;
          var tokens = norm($('input-busqueda').value).trim().split(/\s+/).filter(Boolean);
          var filtrados = baseDatos.filter(function (c) {
            return (ciu === 'Todas' || c.ciudad === ciu) &&
              (zon === 'Todas' || c.zona === zon) &&
              (!soloFavoritos || favoritos.has(c.id)) &&
              tokens.every(function (t) { return c._q.indexOf(t) !== -1; });
          });
          if (origen) {
            filtrados = filtrados.slice().sort(function (a, b) {
              return calcularD(origen.lat, origen.lon, a.lat, a.lon) - calcularD(origen.lat, origen.lon, b.lat, b.lon);
            });
          }
          return filtrados;
        }

        function limpiarOrigen() {
          if (markerOrigen && mapaCofiteca) { mapaCofiteca.removeLayer(markerOrigen); markerOrigen = null; }
          origen = null;
          $('cofi-status').classList.add('hidden');
        }

        function aplicarFiltros(recentrar) {
          busquedaActiva = $('input-busqueda').value.trim().length > 0;
          var filtrados = filtrarDatos();
          setLista(filtrados);
          dibujarMapa(filtrados, recentrar);
          sincronizarURL();
        }

        var debounceFiltro = null;
        window.cofiFiltrar = function (modo) {
          clearTimeout(debounceFiltro);
          debounceFiltro = setTimeout(function () {
            if (modo === true) limpiarOrigen();
            aplicarFiltros(modo === true || modo === 'texto');
          }, 200);
        };
        window.cofiQuitarOrigen = function () { limpiarOrigen(); aplicarFiltros(true); };

        function sincronizarURL() {
          var p = new URLSearchParams(location.search);
          var c = $('select-ciudad').value;
          var q = $('input-busqueda').value.trim();
          var activeBtn = document.querySelector('.view-tab-btn.active');
          var tab = activeBtn ? activeBtn.id.replace('btn-tab-', '') : 'mapa';
          if (c !== 'Todas') p.set('c', c); else p.delete('c');
          if (q) p.set('q', q); else p.delete('q');
          if (tab !== 'mapa') p.set('v', tab); else p.delete('v');
          history.replaceState(null, '', p.toString() ? '?' + p : location.pathname);
        }

        function hidratarDesdeURL() {
          var p = new URLSearchParams(location.search);
          var c = p.get('c'), q = p.get('q'), v = p.get('v');
          if (c) {
            var opt = Array.from($('select-ciudad').options).find(function (o) { return o.value === c; });
            if (opt) { $('select-ciudad').value = c; window.cofiActualizarZonas(); }
          }
          if (q) $('input-busqueda').value = q;
          if (v && ['ranking', 'tostadores', 'mercado'].indexOf(v) !== -1) {
            window.cofiSwitchTab(v);
          }
        }

        // ---------- Rankings ----------
        function getRankingColor(rank) {
          if (!rank || isNaN(rank)) return '#34495e';
          if (rank <= 3) return '#D4AF37';
          if (rank <= 10) return '#E86A33';
          if (rank <= 20) return '#009FBD';
          if (rank <= 30) return '#8e44ad';
          if (rank <= 40) return '#27ae60';
          if (rank <= 50) return '#f39c12';
          if (rank <= 60) return '#d35400';
          if (rank <= 70) return '#c0392b';
          if (rank <= 80) return '#16a085';
          if (rank <= 90) return '#7f8c8d';
          return '#2c3e50';
        }

        function initMapaRanking() {
          if (typeof L === 'undefined') return;
          mapaRanking = L.map('ranking-map', { minZoom: 2, maxZoom: 19 }).setView(VISTA_ARGENTINA, 4);
          agregarCapaBase(mapaRanking);
          markerClusterRanking = crearGrupoMarcadores(mapaRanking, { maxClusterRadius: 35, disableClusteringAtZoom: 12, spiderfyOnMaxZoom: true });
          setTimeout(function () { mapaRanking.invalidateSize(); }, 200);
        }

        window.cofiActualizarRankingCiudades = function () {
          var tipo = $('select-ranking-tipo').value;
          var data = rankingDatos[tipo] || [];
          var lugares = Array.from(new Set(data.map(function (c) { return c.lugar; }))).sort(function (a, b) { return a.localeCompare(b, 'es'); });
          var texto = tipo === 'arg' ? 'Todas las Ciudades' : 'Todos los Países';
          $('select-ranking-ciudad').innerHTML = '<option value="Todas">' + texto + '</option>' + lugares.map(function (c) { return '<option value="' + esc(c) + '">' + esc(c) + '</option>'; }).join('');
        };

        window.cofiFiltrarRanking = function () {
          var tipo = $('select-ranking-tipo').value;
          var lugar = $('select-ranking-ciudad').value;
          var filtrados = (rankingDatos[tipo] || []).filter(function (c) { return lugar === 'Todas' || c.lugar === lugar; });

          if (markerClusterRanking && mapaRanking) {
            var markers = filtrados.map(function (c) {
              var color = getRankingColor(c.rank);
              var icon = L.divIcon({
                html: '<div style="background-color:' + color + '; color:white; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; font-weight:800; border:2px solid white; box-shadow:0 3px 6px rgba(0,0,0,.3); font-size:13px; font-family:Inter,sans-serif;">' + esc(c.rank) + '</div>',
                className: 'custom-ranking-icon', iconSize: [28, 28], iconAnchor: [14, 14]
              });
              var ig = c.ig ? '<div class="popup-acciones"><a href="' + esc(c.ig) + '" target="_blank" rel="noopener noreferrer" class="popup-btn">Instagram</a></div>' : '';
              return L.marker([c.lat, c.lon], { icon: icon }).bindPopup(
                '<div class="popup-cafe"><span class="rank-badge" style="background:' + color + ';">#' + esc(c.rank) + '</span><br><b>' + esc(c.nombre) + '</b><small>' + esc(c.ubicacion) + ' • ' + esc(c.lugar) + '</small>' + ig + '</div>',
                { maxWidth: 260 }
              );
            });
            markerClusterRanking.clearLayers();
            if (typeof markerClusterRanking.addLayers === 'function') markerClusterRanking.addLayers(markers);
            else markers.forEach(function (m) { markerClusterRanking.addLayer(m); });

            if (filtrados.length) {
              var zoom = lugar === 'Todas' ? (tipo === 'mun' ? 2 : 4) : (tipo !== 'arg' ? 5 : 12);
              var lat = filtrados.reduce(function (s, c) { return s + c.lat; }, 0) / filtrados.length;
              var lon = filtrados.reduce(function (s, c) { return s + c.lon; }, 0) / filtrados.length;
              mapaRanking.setView([lat, lon], zoom);
            }
          }

          var frag = document.createDocumentFragment();
          filtrados.forEach(function (c) {
            var color = getRankingColor(c.rank);
            var div = document.createElement('div');
            div.className = 'cafe-card';
            var ig = c.ig ? '<a href="' + esc(c.ig) + '" target="_blank" rel="noopener noreferrer">Instagram</a>' : '';
            div.innerHTML =
              '<div><h3 style="padding-right:0"><span class="rank-badge" style="background:' + color + ';">#' + esc(c.rank) + '</span> ' + esc(c.nombre) + '</h3>' +
              '<p>' + esc(c.ubicacion) + ' • <b>' + esc(c.lugar) + '</b></p></div>' +
              '<div class="cafe-actions">' + ig + '<a href="' + urlComoLlegar(c) + '" target="_blank" rel="noopener noreferrer">Cómo llegar</a></div>';
            frag.appendChild(div);
          });
          $('ranking-resultados').replaceChildren(frag);
        };

        // ---------- Tostadores ----------
        window.cofiRenderizarTostadores = function () {
          var ciudad = $('select-ciudad-tostadores').value;
          var filtrados = tostadoresDatos.filter(function (t) { return ciudad === 'Todas' || t.ciudad === ciudad; });
          var cont = $('lista-tostadores');
          if (!filtrados.length) {
            cont.innerHTML = '<p class="msg-vacio"><span class="emoji">🌱</span>Todavía no hay tostadores registrados en esta ciudad.</p>';
            return;
          }
          var frag = document.createDocumentFragment();
          filtrados.forEach(function (t) {
            var div = document.createElement('div');
            div.className = 'tostador-card';
            var img = t.foto || IMG_FALLBACK;
            var botones = '';
            if (t.ig) botones += '<a href="' + esc(t.ig) + '" target="_blank" rel="noopener noreferrer" class="btn-outline-mad" style="margin-bottom:8px;display:flex;">Instagram</a>';
            if (t.tienda) botones += '<a href="' + esc(t.tienda) + '" target="_blank" rel="noopener noreferrer" class="btn-primary-mad" style="display:flex;">Tienda Online</a>';
            div.innerHTML =
              '<img src="' + esc(img) + '" class="tostador-img" width="400" height="200" loading="lazy" decoding="async" alt="' + esc(t.nombre) + '" onerror="this.onerror=null;this.src=\'' + IMG_FALLBACK + '\'">' +
              '<div class="tostador-content"><div><h3>' + esc(t.nombre) + '</h3><p>📍 ' + esc(t.ciudad) + '</p></div><div>' + botones + '</div></div>';
            frag.appendChild(div);
          });
          cont.replaceChildren(frag);
        };

        // ---------- Ubicación y Modales ----------
        function cofiProcesarOrigen(lat, lon, label) {
          $('select-ciudad').value = 'Todas';
          window.cofiActualizarZonas();
          $('input-busqueda').value = '';
          busquedaActiva = false;
          limpiarOrigen();

          origen = { lat: lat, lon: lon, label: label };
          if (mapaCofiteca) {
            markerOrigen = L.circleMarker([lat, lon], { radius: 9, color: '#1a0f0a', fillColor: '#fff', weight: 3, fillOpacity: 1 })
              .addTo(mapaCofiteca).bindPopup(esc(label)).openPopup();
          }

          var conDist = baseDatos.map(function (c) { return Object.assign({}, c, { dist: calcularD(lat, lon, c.lat, c.lon) }); })
            .sort(function (a, b) { return a.dist - b.dist; });
          setLista(conDist);
          dibujarMapa(baseDatos, false);
          if (mapaCofiteca) mapaCofiteca.setView([lat, lon], 15);
          document.querySelector('#vista-mapa .map-wrapper').scrollIntoView({ behavior: 'smooth', block: 'center' });

          var st = $('cofi-status');
          st.innerHTML = '📍 Más cercanos a <b>' + esc(label) + '</b> · <a onclick="cofiFiltrarRadio(1)">1 km</a> · <a onclick="cofiFiltrarRadio(5)">5 km</a> · <a onclick="cofiFiltrarRadio(15)">15 km</a> · <a onclick="cofiFiltrarRadio(50)">50 km</a> · <a onclick="cofiQuitarOrigen()">Quitar</a>';
          st.classList.remove('hidden');
          sincronizarURL();
        }

        window.cofiFiltrarRadio = function (km) {
          if (!origen) return;
          var dentro = baseDatos.map(function (c) { return Object.assign({}, c, { dist: calcularD(origen.lat, origen.lon, c.lat, c.lon) }); })
            .filter(function (c) { return c.dist <= km; }).sort(function (a, b) { return a.dist - b.dist; });
          setLista(dentro);
          dibujarMapa(dentro, false);
          $('cofi-status').innerHTML = '📍 A menos de <b>' + km + ' km</b> de <b>' + esc(origen.label) + '</b> · <a onclick="cofiQuitarOrigen()">Quitar</a>';
        };

        window.cofiUsarMiGPS = function () {
          if (!navigator.geolocation) { ensureSwal().then(function () { Swal.fire('Error', 'Tu navegador no soporta GPS.', 'error'); }); return; }
          navigator.geolocation.getCurrentPosition(
            function (p) { cofiProcesarOrigen(p.coords.latitude, p.coords.longitude, 'tu ubicación'); },
            function () { ensureSwal().then(function () { Swal.fire('Aviso', 'No pudimos obtener tu ubicación. Revisá los permisos.', 'warning'); }); },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
          );
        };

        window.cofiMedirDesdeDireccion = function () {
          ensureSwal().then(function () {
            Swal.fire({
              title: '¿Dónde estás?',
              html: '<p style="font-size:.9rem;color:#5c3d2e;margin-bottom:15px;">Escribí tu calle y ciudad (Ej: Güemes, Mar del Plata)</p><input id="swal-autocomplete-input" class="swal-custom-input" placeholder="Escribir..." autocomplete="off"><div id="autocomplete-results" style="text-align:left;margin-top:10px;max-height:200px;overflow-y:auto;"></div>',
              showConfirmButton: false, showCancelButton: true, cancelButtonText: 'Cerrar',
              customClass: { popup: 'swal-custom-popup', cancelButton: 'swal-custom-btn-cancel' },
              didOpen: function () {
                var input = $('swal-autocomplete-input');
                var resultsContainer = $('autocomplete-results');
                var timeout = null, solicitudId = 0;
                input.focus();
                input.addEventListener('input', function () {
                  clearTimeout(timeout);
                  var val = input.value.trim();
                  if (val.length < 4) { resultsContainer.innerHTML = ''; return; }
                  resultsContainer.innerHTML = '<div style="padding:10px;color:#1a0f0a;font-weight:bold;text-align:center;">Buscando...</div>';
                  timeout = setTimeout(function () {
                    var miId = ++solicitudId;
                    fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(val) + '&countrycodes=ar&addressdetails=1&limit=6')
                      .then(function (res) { return res.json(); })
                      .then(function (data) {
                        if (miId !== solicitudId) return;
                        resultsContainer.innerHTML = '';
                        if (!data.length) { resultsContainer.innerHTML = '<div style="padding:10px;opacity:.7;text-align:center;">No encontramos la dirección.</div>'; return; }
                        data.forEach(function (item) {
                          var partes = [];
                          if (item.address.road) partes.push(item.address.road + (item.address.house_number ? ' ' + item.address.house_number : ''));
                          var localidad = item.address.city || item.address.town || item.address.village;
                          if (localidad) partes.push(localidad);
                          var nombreStr = partes.length ? partes.join(', ') : item.display_name.split(',').slice(0, 3).join(', ');
                          var btn = document.createElement('button');
                          btn.style.cssText = 'width:100%;text-align:left;background:rgba(255,255,255,.7);color:#1a0f0a;border:1px solid rgba(196,167,125,.5);padding:12px;border-radius:6px;cursor:pointer;margin-bottom:8px;font-family:Inter,sans-serif;font-size:.9rem;';
                          btn.innerHTML = '📍 <b>' + esc(nombreStr) + '</b>';
                          btn.onclick = function () { Swal.close(); cofiProcesarOrigen(parseFloat(item.lat), parseFloat(item.lon), nombreStr); };
                          resultsContainer.appendChild(btn);
                        });
                      })
                      .catch(function () { if (miId === solicitudId) resultsContainer.innerHTML = '<div style="padding:10px;color:red;text-align:center;">Error con el mapa.</div>'; });
                  }, 800);
                });
              }
            });
          });
        };

        window.cofiAbrirReporte = function () {
          ensureSwal().then(function () {
            return Swal.fire({
              title: 'Soporte',
              customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
              html: '<div style="text-align:left;"><select id="swal-tipo" class="swal-custom-input" style="margin-bottom:10px;"><option value="Dato Incorrecto">Corrección de datos</option><option value="Local Cerrado">Local cerrado</option></select><input id="swal-local" class="swal-custom-input" placeholder="Nombre del local o tu teléfono" style="margin-bottom:10px;"><textarea id="swal-detalle" class="swal-custom-input" placeholder="Detalle de la solicitud..." style="height:80px;resize:none;"></textarea></div>',
              showCancelButton: true, confirmButtonText: 'Enviar', cancelButtonText: 'Cancelar',
              preConfirm: function () {
                var local = $('swal-local').value.trim();
                if (!local) { Swal.showValidationMessage('Ingresá una referencia válida'); return false; }
                return { tipo: $('swal-tipo').value, local: local, detalle: $('swal-detalle').value.trim() };
              }
            });
          }).then(function (res) { if (res && res.value) window.cofiEnviarReporteEmail(res.value); });
        };

        window.cofiAbrirSumate = function () {
          ensureSwal().then(function () {
            return Swal.fire({
              title: 'Añadir Local',
              customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
              html: '<div style="text-align:left;"><select id="sumate-tipo" class="swal-custom-input" style="margin-bottom:10px;"><option value="Cafetería / Tostaduría">Cafetería / Tostaduría</option></select><input id="sumate-nombre" class="swal-custom-input" placeholder="Nombre comercial" style="margin-bottom:10px;"><input id="sumate-link" class="swal-custom-input" placeholder="Link a Instagram o Web" style="margin-bottom:10px;"></div>',
              showCancelButton: true, confirmButtonText: 'Enviar Solicitud', cancelButtonText: 'Cancelar',
              preConfirm: function () {
                var nombre = $('sumate-nombre').value.trim();
                if (!nombre) { Swal.showValidationMessage('Ingresá el nombre comercial'); return false; }
                return { tipo: 'ALTA NUEVA: ' + $('sumate-tipo').value, local: nombre, detalle: 'Link/IG: ' + $('sumate-link').value.trim() };
              }
            });
          }).then(function (res) { if (res && res.value) window.cofiEnviarReporteEmail(res.value); });
        };

        window.cofiEnviarReporteEmail = function (datosForm) {
          fetch('/api/reporte?t=' + Date.now(), {
            method: 'POST', mode: 'no-cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(datosForm)
          }).then(function () {
            Swal.fire({ title: 'Enviado', text: 'Tu solicitud fue recibida.', icon: 'success', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
          }).catch(function () {
            Swal.fire({ title: 'Error', text: 'Problemas de conexión con el servidor.', icon: 'error', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
          });
        };

        document.addEventListener('keydown', function (e) {
          if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA' && document.activeElement.tagName !== 'SELECT') {
            e.preventDefault();
            $('input-busqueda').focus();
          }
          if (e.key === 'Escape' && document.activeElement.id === 'input-busqueda') {
            $('input-busqueda').value = '';
            window.cofiFiltrar('texto');
          }
        });

        // 1. ARRANQUE INMEDIATO DE LA UI
        var ciudades = Array.from(new Set(baseDatos.map(function (c) { return c.ciudad; }))).sort(function (a, b) { return a.localeCompare(b, 'es'); });
        var opcionesCiudades = ciudades.map(function (c) { return '<option value="' + esc(c) + '">' + esc(c) + '</option>'; }).join('');
        $('select-ciudad').innerHTML = '<option value="Todas">Región / Ciudad</option>' + opcionesCiudades;
        $('select-mercado-ciudad').innerHTML = '<option value="Todas">Todo el país (Región / Ciudad)</option>' + opcionesCiudades;

        var ciudadesTost = Array.from(new Set(tostadoresDatos.map(function (t) { return t.ciudad; }))).sort(function (a, b) { return a.localeCompare(b, 'es'); });
        $('select-ciudad-tostadores').innerHTML = '<option value="Todas">Todas las Ciudades</option>' + ciudadesTost.map(function (c) { return '<option value="' + esc(c) + '">' + esc(c) + '</option>'; }).join('');

        var GRANDES = ['CABA y Gran Buenos Aires', 'Córdoba', 'Mar del Plata', 'Mendoza', 'La Plata'];
        $('quick-chips').innerHTML = GRANDES
          .filter(function (r) { return ciudades.indexOf(r) !== -1; })
          .map(function (r) { return '<button class="quick-chip" onclick="cofiQuickRegion(\'' + esc(r) + '\')">' + esc(r.replace(' y Gran Buenos Aires', '')) + '</button>'; })
          .join('');

        window.cofiQuickRegion = function (r) {
          $('select-ciudad').value = r;
          window.cofiActualizarZonas();
          window.cofiFiltrar(true);
        };

        persistirFavs();
        renderRecientes();
        window.cofiActualizarZonas();
        window.cofiActualizarMercadoZonas();
        window.cofiActualizarMetricas();
        hidratarDesdeURL();
        var vieneConFiltro = $('input-busqueda').value.trim() !== '' || $('select-ciudad').value !== 'Todas';
        aplicarFiltros(vieneConFiltro);

        // 2. CARGA ASÍNCRONA DE LIBRERÍAS DE MAPA
        function cargarScript(src) {
          return new Promise(function (resolve) {
            var s = document.createElement('script');
            s.src = src;
            s.onload = function () { resolve(true); };
            s.onerror = function () { resolve(false); };
            document.head.appendChild(s);
          });
        }

        cargarScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js').then(function (okLeaflet) {
          if (!okLeaflet || typeof L === 'undefined') return;
          return Promise.all([
            cargarScript('https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js'),
            cargarScript('https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js')
          ]).then(function () {
            return cargarScript('https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.0.22/leaflet-maplibre-gl.js');
          }).then(function () {
            initMapa();
            var tabActiva = document.querySelector('.view-tab-btn.active');
            if (tabActiva && tabActiva.id === 'btn-tab-mercado' && !mercadoIniciado) {
              initMapaMercado();
              mercadoIniciado = true;
              window.cofiRenderMercado(true);
            }
            if (tabActiva && tabActiva.id === 'btn-tab-ranking' && !rankingIniciado) {
              initMapaRanking();
              rankingIniciado = true;
              window.cofiFiltrarRanking();
            }
          });
        });

        window.addEventListener('resize', function () {
          if (mapaCofiteca) mapaCofiteca.invalidateSize();
          if (mapaRanking) mapaRanking.invalidateSize();
          if (mapaMercado) mapaMercado.invalidateSize();
        });
      }

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
      else boot();
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</body>
</html>
