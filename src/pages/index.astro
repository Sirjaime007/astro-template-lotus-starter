        'san juan, san luis, la rioja y la pampa',
        'chubut, santa cruz y tierra del fuego',
        'interior de bs as'
      ]);

      const PLAZAS_TURISTICAS_INTERIOR = /(pinamar|carilo|gesell|tandil|miramar|necochea|bahia blanca|san nicolas|zarate|campana|lujan|junin|pergamino|olavarria)/;

      function esPlazaRecomendable(c) {
