        };

        // ---------- Mercado: Motor Universal de Polos Gastronómicos y Zonas en Desarrollo ----------
        function obtenerNucleoComercialZona(ciudad, zona) {
          var delBarrio = baseDatos.filter(function (x) {
            return x.ciudad === ciudad && x.zona === zona;
          });
          if (!delBarrio.length) return null;

          // Medoid comercial: elige el local real del barrio con mayor concentración de vecinos en 650 m.
          // Evita que un local aislado o la mediana caigan en zonas residenciales sin comercio.
          var mejor = delBarrio[0];
          var maxVecinos = -1;

          for (var i = 0; i < delBarrio.length; i++) {
            var cand = delBarrio[i];
            var vecinos = 0;
            for (var j = 0; j < baseDatos.length; j++) {
              if (cand.id === baseDatos[j].id) continue;
              if (calcularD(cand.lat, cand.lon, baseDatos[j].lat, baseDatos[j].lon) <= 0.65) {
                vecinos++;
              }
            }
            if (vecinos > maxVecinos || (vecinos === maxVecinos && cand.mkt.t > mejor.mkt.t)) {
              maxVecinos = vecinos;
              mejor = cand;
            }
          }
          return { lat: mejor.lat, lon: mejor.lon, total: delBarrio.length, densidadCore: maxVecinos };
        }

        function obtenerZonasRecomendadasDinamicas(ciu, zon) {
          var esNacional = ciu === 'Todas';

          // Filtro universal de entornos sin frente comercial apto o periféricos residenciales/industriales
          var EXCLUSION_UNIVERSAL = /(terminal|ferroautomotora|estacion norte|estacion sur|estacion terminal|parque industrial|zona industrial|ruta nacional|ruta provincial|autopista|colectora|cementerio|puerto industrial|mercado central|mercado de abasto|aeropuerto|aeroparque|las avenidas|cerrito|san salvador|juramento|puerto comercial|villa soldati|villa lugano|villa riachuelo|nueva pompeya)/;

          var pool = baseDatos.filter(function (c) {
            var txt = norm([c.zona, c.ciudadReal, c.ubicacion, c.nombre].join(' '));
            if (EXCLUSION_UNIVERSAL.test(txt)) return false;
            if (esNacional) return esPlazaRecomendable(c);
            if (c.ciudad !== ciu) return false;
            if (zon !== 'Todas' && c.zona !== zon) return false;

            // Descarta puntos aislados a más de 1.1 km del núcleo comercial real de su propio barrio
            if (c.zona && c.zona !== '-' && c.zona !== 'Sin Zona') {
              var core = obtenerNucleoComercialZona(c.ciudad, c.zona);
              if (core && core.total >= 2 && calcularD(c.lat, c.lon, core.lat, core.lon) > 1.1) {
                return false;
              }
            }
            return true;
          });

          if (!pool.length) {
            pool = baseDatos.filter(function (c) {
              var txt = norm([c.zona, c.ciudadReal, c.ubicacion].join(' '));
              return !EXCLUSION_UNIVERSAL.test(txt) && (esNacional ? true : c.ciudad === ciu);
            });
          }

          // Análisis espacial multi-escala en el entorno real de cada punto:
          // - vecinos350m: saturación en las mismas 3 cuadras
          // - vecinos650m: continuidad comercial inmediata del corredor
          // - vecinos1500m: escala del polo gastronómico barrial
          var analizados = pool.map(function (c) {
            var vecinos350m = 0;
            var vecinos650m = 0;
            var vecinos1500m = 0;
            var sumaTicketEntorno = c.mkt.t;

            for (var i = 0; i < baseDatos.length; i++) {
              var otro = baseDatos[i];
              if (otro.id === c.id) continue;
              var d = calcularD(c.lat, c.lon, otro.lat, otro.lon);
              if (d <= 0.35) vecinos350m++;
              if (d <= 0.65) vecinos650m++;
              if (d <= 1.50) {
                vecinos1500m++;
                sumaTicketEntorno += otro.mkt.t;
              }
            }

            var ticketEntorno = Number((sumaTicketEntorno / (vecinos1500m + 1)).toFixed(2));
            return {
              cafe: c,
              vecinos350m: vecinos350m,
              vecinos650m: vecinos650m,
              vecinos1500m: vecinos1500m,
              ticketEntorno: ticketEntorno
            };
          });

          // Exigencia de continuidad comercial real (<= 650 m): impide que zonas residenciales linderas
          // hereden puntaje de un polo lejano sin tener actividad comercial propia.
          var conEcosistema = analizados.filter(function (item) {
            return (item.vecinos650m >= 2 || (item.vecinos650m >= 1 && item.ticketEntorno >= 1.22)) && item.vecinos350m <= 6;
          });
          var candidatos = conEcosistema.length >= 2 ? conEcosistema : analizados;

          var evaluados = candidatos.map(function (item) {
            var c = item.cafe;
            var nombreBarrio = (c.zona && c.zona !== '-' && c.zona !== 'Sin Zona')
              ? c.zona
              : (c.ciudadReal || c.ciudad);
            var plazaNombre = c.ciudadReal && c.ciudadReal !== c.ciudad
              ? c.ciudadReal + ' (' + c.ciudad.replace(' y Gran Buenos Aires', '') + ')'
              : c.ciudad;

            // Zona en desarrollo: continuidad comercial inmediata (2-5 cafés a 650m) con baja saturación en la cuadra (0-1 a 350m)
            var esEnDesarrollo = item.vecinos650m >= 2 && item.vecinos650m <= 5 && item.vecinos350m <= 1;
            var tipoCorredor = esEnDesarrollo ? 'Zona en desarrollo' : 'Polo gastronómico';

            var pinLat = c.lat;
            var pinLon = c.lon;
            var v350Final = item.vecinos350m;
            var v1500Final = item.vecinos1500m;

            // Anclamos los polos consolidados al medoid comercial real del barrio
            if (!esEnDesarrollo && c.zona && c.zona !== '-' && c.zona !== 'Sin Zona') {
              var coreBarrio = obtenerNucleoComercialZona(c.ciudad, c.zona);
              if (coreBarrio && coreBarrio.total >= 2) {
                pinLat = coreBarrio.lat;
                pinLon = coreBarrio.lon;
                v350Final = 0;
                v1500Final = 0;
                for (var k = 0; k < baseDatos.length; k++) {
                  var dCore = calcularD(pinLat, pinLon, baseDatos[k].lat, baseDatos[k].lon);
                  if (dCore <= 0.35) v350Final++;
                  if (dCore <= 1.50) v1500Final++;
                }
              }
            }

            var pobZ = POB_ZONAS.get(norm(nombreBarrio)) || POB_REGIONES.get(norm(c.ciudad)) || 60000;
            var esTuristica = /(pinamar|carilo|gesell|bariloche|angostura|san martin de los andes|ushuaia|calafate|iguazu|cafayate|carlos paz|calamuchita|merlo|chapadmalal|playa grande|alem|base naval|guemes|mendoza|salta|jujuy)/.test(
              norm(c.ciudad + ' ' + c.ciudadReal + ' ' + nombreBarrio)
            );

            var publico = esEnDesarrollo
              ? 'Expansión comercial lindera a corredor activo con margen para nueva apertura'
              : esTuristica
                ? 'Polo gastronómico y turístico de alto poder adquisitivo y rotación'
                : pobZ >= 120000
                  ? 'Polo gastronómico consolidado, oficinas, estudiantes y hábito diario'
                  : 'Corredor comercial activo con flujo peatonal y demanda de cercanía';

            var bonoEcosistema = Math.min(4.5, (item.vecinos650m * 0.65) + (v1500Final * 0.18));
            var bonoDesarrollo = esEnDesarrollo ? 2.2 : 0.9;
            var penalizacionCercana = 1 + (v350Final * 0.42);
            var rawScore = (((9.0 + bonoEcosistema + (c.mkt.a * 0.08)) * item.ticketEntorno) / penalizacionCercana) + bonoDesarrollo;
            var score = Number(Math.min(19.5, Math.max(7.5, rawScore)).toFixed(1));

            return {
              latitud: pinLat,
              longitud: pinLon,
              plaza: plazaNombre,
              corredor: nombreBarrio,
              direccionRef: c.ubicacion,
              tipoCorredor: tipoCorredor,
              esEnDesarrollo: esEnDesarrollo,
              score_potencial: score,
              vecinos_350m: v350Final,
              vecinos_1500m: v1500Final,
              atractores_cercanos: c.mkt.a || 18,
              nivel_gasto: c.mkt.g,
              indice_ticket: item.ticketEntorno,
              circulacion: c.mkt.c || (v1500Final >= 6 ? 'Muy Alta' : v1500Final >= 2 ? 'Alta' : 'Media'),
              publico_objetivo: publico,
              claveUnica: esNacional ? norm(c.ciudad) : norm(nombreBarrio)
            };
          }).sort(function (a, b) { return b.score_potencial - a.score_potencial; });

          var top = [];
          var clavesUsadas = new Set();
          var maxItems = esNacional ? 6 : 4;
          var distMinima = esNacional ? 0.25 : 0.006;

          for (var i = 0; i < evaluados.length; i++) {
            var cand = evaluados[i];
            var muyCerca = top.some(function (s) { return Math.hypot(cand.latitud - s.latitud, cand.longitud - s.longitud) < distMinima; });
            if (muyCerca) continue;
            if (zon === 'Todas' && clavesUsadas.has(cand.claveUnica) && evaluados.length > maxItems * 2) continue;
            top.push(cand);
            clavesUsadas.add(cand.claveUnica);
            if (top.length >= maxItems) break;
          }
          if (top.length < Math.min(3, evaluados.length)) {
            for (var j = 0; j < evaluados.length; j++) {
              if (top.indexOf(evaluados[j]) === -1) top.push(evaluados[j]);
              if (top.length >= Math.min(4, evaluados.length)) break;
            }
          }
          return top;
        }

        function initMapaMercado() {
          if (typeof L === 'undefined') return;
          mapaMercado = L.map('mercado-map', { minZoom: 3, maxZoom: 18, zoomSnap: 0.5 }).setView(VISTA_ARGENTINA, zoomInicial());
          agregarCapaBase(mapaMercado);
          capaPuntosMercado = L.layerGroup().addTo(mapaMercado);
          capaOportunidadMercado = L.layerGroup().addTo(mapaMercado);
          setTimeout(function () { mapaMercado.invalidateSize(); }, 200);
        }

        window.cofiActualizarMercadoZonas = function () {
          var ciu = $('select-mercado-ciudad').value;
          var base = ciu === 'Todas' ? baseDatos : baseDatos.filter(function (c) { return c.ciudad === ciu; });
          var zonas = Array.from(new Set(base.map(function (c) { return c.zona; })))
            .filter(function (z) { return z && z !== '-' && z !== 'Sin Zona'; })
            .sort(function (a, b) { return a.localeCompare(b, 'es'); });
          $('select-mercado-zona').innerHTML = '<option value="Todas">Todos los Barrios / Zonas</option>' +
            zonas.map(function (z) { return '<option value="' + esc(z) + '">' + esc(z) + '</option>'; }).join('');
        };

