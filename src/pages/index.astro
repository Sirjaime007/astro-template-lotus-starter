          if (reg === 'santa fe' || (enSantaFeCoords && reg !== 'caba y gran buenos aires' && reg !== 'entre rios')) {
            provincia = 'Santa Fe';
            municipio = c.ciudadReal || c.zona || 'Rosario';
          } else if (reg === 'caba y gran buenos aires') {
            var esBarrioCaba = BARRIO_A_COMUNA.has(z) || BARRIO_A_COMUNA.has(cr);
            var dentroRectCaba = (c.lat >= -34.706 && c.lat <= -34.526 && c.lon >= -58.532 && c.lon <= -58.335 &&
              !/(vicente lopez|olivos|florida|munro|martinez|san isidro|avellaneda|lanus|valentin alsina|caseros|ciudadela|ramos mejia|lomas del mirador|saenz pena|santos lugares|villa lynch|san martin)/.test(txt));

            if (esBarrioCaba || dentroRectCaba) {
              provincia = 'CABA';
              barrioCaba = BARRIO_A_COMUNA.has(z) ? c.zona : (BARRIO_A_COMUNA.has(cr) ? c.ciudadReal : 'Otros barrios CABA');
              comunaCaba = BARRIO_A_COMUNA.get(norm(barrioCaba)) || 'Sin Comuna';
              municipio = barrioCaba;
            } else {
              provincia = 'Buenos Aires';
              municipio = c.ciudadReal || c.zona || 'Gran Buenos Aires';
            }
          } else if (reg === 'mar del plata') {
            provincia = 'Buenos Aires';
            municipio = 'General Pueyrredón';
          } else if (reg === 'la plata') {
            provincia = 'Buenos Aires';
            municipio = 'La Plata';
          } else if (reg === 'interior de bs as') {
            provincia = 'Buenos Aires';
            municipio = c.ciudadReal || c.zona || 'Interior Buenos Aires';
          } else if (reg === 'cordoba') {
            provincia = 'Córdoba';
            municipio = c.ciudadReal || c.zona || 'Capital';
          } else if (reg === 'mendoza') {
            provincia = 'Mendoza';
            municipio = c.ciudadReal || c.zona || 'Capital';
          } else if (reg.indexOf('tucuman') !== -1) {
            if (/(catamarca|valle viejo|belen|fiambala)/.test(txt)) provincia = 'Catamarca';
            else if (/(santiago del estero|la banda|termas de rio hondo|rio hondo)/.test(txt)) provincia = 'Santiago del Estero';
            else provincia = 'Tucumán';
            municipio = c.ciudadReal || c.zona || provincia;
          } else if (reg.indexOf('corrientes') !== -1) {
            if (/(misiones|posadas|iguazu|obera|eldorado)/.test(txt)) provincia = 'Misiones';
            else if (/(entre rios|parana|concordia|gualeguaychu|colon|concepcion del uruguay|uruguay)/.test(txt)) provincia = 'Entre Ríos';
            else if (/(formosa|clorinda)/.test(txt)) provincia = 'Formosa';
            else if (/(chaco|resistencia|saenz pena|barranqueras|san fernando)/.test(txt)) provincia = 'Chaco';
            else provincia = 'Corrientes';
            municipio = c.ciudadReal || c.zona || provincia;
          } else if (reg.indexOf('salta') !== -1) {
            if (/(jujuy|purmamarca|tilcara|humahuaca|palpala|perico|libertador|manuel belgrano|el carmen)/.test(txt)) provincia = 'Jujuy';
            else provincia = 'Salta';
            municipio = c.ciudadReal || c.zona || provincia;
          } else if (reg.indexOf('neuquen') !== -1) {
            if (/(rio negro|bariloche|cipolletti|general roca|viedma|bolson|las grutas|villa regina|adolfo alsina)/.test(txt)) provincia = 'Río Negro';
            else provincia = 'Neuquén';
            municipio = c.ciudadReal || c.zona || provincia;
          } else if (reg.indexOf('san juan') !== -1) {
            if (/(san luis|merlo|villa mercedes|juana koslay|potrero de los funes|pueyrredon|pedernera)/.test(txt)) provincia = 'San Luis';
            else if (/(la rioja|chilecito)/.test(txt)) provincia = 'La Rioja';
            else if (/(la pampa|santa rosa|general pico|maraco)/.test(txt)) provincia = 'La Pampa';
            else provincia = 'San Juan';
            municipio = c.ciudadReal || c.zona || provincia;
          } else if (reg.indexOf('chubut') !== -1) {
            if (/(santa cruz|calafate|rio gallegos|chalten|caleta olivia|guer aike|lago argentino)/.test(txt)) provincia = 'Santa Cruz';
            else if (/(tierra del fuego|ushuaia|rio grande|tolhuin)/.test(txt)) provincia = 'Tierra del Fuego';
            else provincia = 'Chubut';
            municipio = c.ciudadReal || c.zona || provincia;
          }

          return {
            provincia: provincia,
            municipio: (municipio && municipio !== '-' && municipio !== 'Sin Zona') ? municipio : provincia,
            barrioCaba: barrioCaba,
            comunaCaba: comunaCaba
          };
