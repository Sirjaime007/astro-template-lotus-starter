      // ---------- Pestaña Mercado (Dinámica según Región/Ciudad y Barrio/Zona) ----------
      function obtenerZonasRecomendadasDinamicas(ciu, zon) {
        const esNacional = ciu === 'Todas';

        // 1. Filtrar según los mismos selectores de Región/Ciudad y Barrio/Zona
        let pool = baseDatos.filter(c => {
          if (esNacional) return esPlazaRecomendable(c);
          if (c.ciudad !== ciu) return false;
          if (zon !== 'Todas' && c.zona !== zon) return false;
          return true;
        });

        if (!pool.length) pool = baseDatos.filter(c => esNacional ? true : c.ciudad === ciu);

        // 2. Priorizar menor saturación (<= 3 competidores en 500m), relajando si el barrio es muy denso
        let candidatos = pool.filter(c => c.mkt.k <= 3);
        if (candidatos.length < 3) candidatos = pool;

        // 3. Calcular puntaje de oportunidad real por microzona
        const evaluados = candidatos.map(c => {
          const nombreBarrio = (c.zona && c.zona !== '-' && c.zona !== 'Sin Zona')
            ? c.zona
            : (c.ciudadReal || c.ciudad);
          const plazaNombre = c.ciudadReal && c.ciudadReal !== c.ciudad
            ? `${c.ciudadReal} (${c.ciudad.replace(' y Gran Buenos Aires', '')})`
            : c.ciudad;

          const pobZ = POB_ZONAS.get(norm(nombreBarrio)) || POB_REGIONES.get(norm(c.ciudad)) || 60000;
          const esTuristica = /(pinamar|carilo|gesell|bariloche|angostura|san martin de los andes|ushuaia|calafate|iguazu|cafayate|carlos paz|calamuchita|merlo|chapadmalal|playa grande|guemes|mendoza|salta|jujuy)/.test(
            norm(`${c.ciudad} ${c.ciudadReal} ${nombreBarrio}`)
          );

          const publico = esTuristica
            ? 'Turismo receptivo/interno, escapadas y consumo de especialidad'
            : pobZ >= 120000
              ? 'Público residencial habitual, home-office y vecinos de cercanía'
              : 'Flujo comercial barrial, oficinas, estudiantes y visitantes';

          // Recalcular score equilibrando demanda, ticket y baja competencia
          const factorComp = 1 + (c.mkt.k * 0.45);
          const rawScore = ((10.5 + (c.mkt.a * 0.12)) * c.mkt.t) / factorComp;
          const score = Number(Math.min(19.2, Math.max(6.8, Math.max(c.mkt.o, rawScore))).toFixed(1));

          return {
            latitud: c.lat,
            longitud: c.lon,
            plaza: plazaNombre,
            corredor: nombreBarrio,
            direccionRef: c.ubicacion,
            score_potencial: score,
            competidores_cercanos: c.mkt.k,
            atractores_cercanos: c.mkt.a || 18,
            nivel_gasto: c.mkt.g,
            indice_ticket: c.mkt.t,
            circulacion: c.mkt.c || (c.mkt.a >= 30 ? 'Muy Alta' : c.mkt.a >= 15 ? 'Alta' : 'Media'),
            publico_objetivo: publico,
            claveUnica: esNacional ? norm(c.ciudad) : norm(nombreBarrio)
          };
        }).sort((a, b) => b.score_potencial - a.score_potencial);

        // 4. Evitar duplicar exactamente la misma esquina o el mismo barrio/ciudad cuando hay variedad
        const top = [];
        const clavesUsadas = new Set();
        const maxItems = esNacional ? 6 : 4;
        const distMinima = esNacional ? 0.25 : 0.006; // ~25km a nivel país, ~600m dentro de una misma ciudad

        for (const cand of evaluados) {
          const muyCerca = top.some(s => Math.hypot(cand.latitud - s.latitud, cand.longitud - s.longitud) < distMinima);
          if (muyCerca) continue;
          if (zon === 'Todas' && clavesUsadas.has(cand.claveUnica) && evaluados.length > maxItems * 2) continue;

          top.push(cand);
          clavesUsadas.add(cand.claveUnica);
          if (top.length >= maxItems) break;
        }

        // Si en un barrio específico quedaron menos de 3 por distancia, completar con los mejores puntos del filtro
        if (top.length < Math.min(3, evaluados.length)) {
          for (const cand of evaluados) {
            if (!top.includes(cand)) top.push(cand);
            if (top.length >= Math.min(4, evaluados.length)) break;
          }
        }

        return top;
      }

