            if (sub.indexOf('COMUNA:') === 0) return c.geo.comunaCaba === sub.slice(7);
            if (sub.indexOf('BARRIO:') === 0) return norm(c.geo.barrioCaba) === norm(sub.slice(7));
            if (sub.indexOf('MUNI:') === 0) return norm(c.geo.municipio) === norm(sub.slice(5));
