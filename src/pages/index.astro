            pobSeleccion = POB_PAIS_TOTAL;
          } else if (sub === 'Todas') {
            pobSeleccion = pobProvinciaRef;
          } else if (sub.indexOf('COMUNA:') === 0) {
            pobSeleccion = COMUNA_POB_MAP.get(norm(sub.slice(7))) || null;
          } else if (sub.indexOf('BARRIO:') === 0) {
            pobSeleccion = BARRIO_POB_MAP.get(norm(sub.slice(7))) || null;
