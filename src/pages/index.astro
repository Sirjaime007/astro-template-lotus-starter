---
// src/pages/index.astro
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Cofiteca | Estudio Creativo de Café de Especialidad</title>
  <meta name="description" content="Datos reales. Diseño con propósito. Buen café. El primer estudio creativo exclusivo para el mundo del café de especialidad en Argentina, creadores del Mapa Nacional." />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  
  <style is:global>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; scroll-behavior: smooth; overflow-x: hidden; }
    body { background-color: #f5f0e8; color: #2c1810; font-family: 'Georgia', 'Times New Roman', serif; line-height: 1.7; }
    #video-fondo { position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -998; opacity: 0.15; pointer-events: none; }
    strong { color: #1a0f0a; }
    a { color: #8b4513; text-decoration: none; transition: all 0.3s ease; }
    main { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    
    /* NAVEGACIÓN SUPERIOR SUTIL */
    .top-nav { position: absolute; top: 0; left: 0; width: 100%; padding: 2rem; display: flex; justify-content: flex-end; gap: 2rem; z-index: 10; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.95rem; }
    .top-nav a { color: #3d2317; text-transform: uppercase; letter-spacing: 0.05em; }
    .top-nav a:hover { color: #8b4513; }
    @media (max-width: 768px) { .top-nav { justify-content: center; padding: 1.5rem; gap: 1.5rem; font-size: 0.85rem; } }

    .section-title { text-align: center; font-size: 3.5rem; font-weight: 800; color: #1a0f0a; letter-spacing: -0.03em; margin: 4rem 0 2rem; line-height: 1.1; font-family: 'Georgia', 'Times New Roman', serif; }

    /* HERO REDISEÑADO */
    .brand-hero { text-align: center; padding: 9rem 1rem 6rem; position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 85vh; }
    .brand-title { font-size: 5.5rem; font-weight: 800; color: #1a0f0a; letter-spacing: -0.04em; margin-bottom: 0.5rem; line-height: 1; text-shadow: 0 4px 30px rgba(255, 255, 255, 0.9); }
    .brand-subtitle { display: block; font-size: 1.1rem; font-family: 'Inter', sans-serif; font-weight: 600; letter-spacing: 0.2em; color: #8b4513; text-transform: uppercase; margin-bottom: 2rem; }
    .brand-tagline { font-size: 1.3rem; color: #2c1810; font-weight: 500; max-width: 700px; margin: 0 auto 3rem; background: rgba(255, 255, 255, 0.7); padding: 1.2rem 2.5rem; border-radius: 12px; backdrop-filter: blur(10px); border: 1px solid rgba(196, 167, 125, 0.4); box-shadow: 0 10px 30px rgba(44, 24, 16, 0.05); line-height: 1.6; }
    
    .brand-actions { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; }
    .btn-hero-primary, .btn-hero-secondary { padding: 1rem 2.5rem; border-radius: 8px; font-size: 1.05rem; font-weight: 700; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 0.5rem; font-family: 'Inter', sans-serif; cursor: pointer; }
    .btn-hero-primary { background-color: #1a0f0a; color: #ffffff; border: 2px solid #1a0f0a; box-shadow: 0 8px 25px rgba(26, 15, 10, 0.2); }
    .btn-hero-primary:hover { background-color: #3d2317; border-color: #3d2317; transform: translateY(-3px); color: white; }
    .btn-hero-secondary { background-color: rgba(255, 255, 255, 0.9); color: #1a0f0a; border: 2px solid #c4a77d; backdrop-filter: blur(5px); }
    .btn-hero-secondary:hover { transform: translateY(-3px); background-color: #ffffff; border-color: #8b4513; color: #1a0f0a; }

    /* QUIÉNES SOMOS / MANIFIESTO */
    .about-container { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(15px); border: 1px solid rgba(196, 167, 125, 0.3); border-radius: 16px; padding: 4rem; margin: 0 auto 5rem; box-shadow: 0 15px 40px rgba(44, 24, 16, 0.06); text-align: left; max-width: 900px; }
    .about-manifesto-title { font-size: 2.2rem; font-family: 'Georgia', serif; font-weight: 800; color: #1a0f0a; text-align: center; margin-bottom: 3rem; line-height: 1.3; }
    
    .about-grid { display: grid; gap: 2rem; }
    .about-block { border-left: 3px solid #c4a77d; padding-left: 1.5rem; }
    .about-label { color: #8b4513; margin: 0 0 0.5rem 0; font-family: 'Inter', sans-serif; text-transform: uppercase; font-size: 0.85rem; font-weight: 800; letter-spacing: 0.1em; }
    .about-text { font-size: 1.15rem; color: #3d2317; line-height: 1.7; margin: 0; font-family: 'Inter', sans-serif; }
    
    @media (max-width: 768px) { 
        .brand-title { font-size: 4rem; } 
        .about-container { padding: 2.5rem 1.5rem; } 
        .about-manifesto-title { font-size: 1.8rem; }
        .about-text { font-size: 1.05rem; }
        .btn-hero-primary, .btn-hero-secondary { width: 100%; justify-content: center; }
    }
    
    /* SERVICIOS */
    .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; margin: 3rem 0; }
    @media (max-width: 768px) { .services-grid { grid-template-columns: 1fr; } }
    .service-card { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; background: rgba(255, 255, 255, 0.65); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.8); border-radius: 12px; padding: 1.5rem; min-height: 250px; box-shadow: 0 10px 30px rgba(44, 24, 16, 0.05); transition: transform 0.3s ease, box-shadow 0.3s ease; position: relative; overflow: hidden; cursor: pointer; }
    .service-thumb { width: 100%; height: 220px; border-radius: 8px; overflow: hidden; margin-bottom: 1.5rem; }
    .service-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
    .service-card h3 { color: #1a0f0a; font-size: 1.6rem; margin: 0 0 1rem 0; text-align: center; font-weight: 700; transition: transform 0.4s ease; }
    .service-card::after { content: ""; position: absolute; bottom: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, transparent, rgba(26, 15, 10, 0.95)); transform: translateY(100%); transition: transform 0.4s ease; z-index: 1; pointer-events: none; }
    .service-hover-text { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%) translateY(20px); opacity: 0; transition: all 0.4s ease; color: #c4a77d; font-size: 1.1rem; font-weight: bold; z-index: 2; font-family: 'Inter', sans-serif;}
    .service-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(44, 24, 16, 0.15); border-color: #c4a77d; }
    .service-card:hover::after { transform: translateY(0); }
    .service-card:hover h3 { transform: translateY(-15px); color: #f5f0e8; z-index: 2; }
    .service-card:hover .service-hover-text { transform: translateX(-50%) translateY(0); opacity: 1; }
    .service-card:hover .service-thumb img { transform: scale(1.05); }
    
    /* PROCESO */
    .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin: 3rem 0; }
    @media (max-width: 992px) { .process-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 576px) { .process-grid { grid-template-columns: 1fr; } }
    .process-step { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); border: 1px solid rgba(196, 167, 125, 0.3); border-radius: 12px; padding: 2.5rem 2rem; position: relative; box-shadow: 0 10px 30px rgba(44, 24, 16, 0.05); text-align: left; overflow: hidden; }
    .step-number { font-size: 8rem; font-weight: 900; color: rgba(196, 167, 125, 0.12); position: absolute; top: -25px; right: 5px; line-height: 1; z-index: 0; pointer-events: none; font-family: 'Inter', sans-serif;}
    .process-step h4 { color: #1a0f0a; font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem; position: relative; z-index: 2; }
    .process-step p { color: #4a332a; font-size: 1.05rem; margin: 0; position: relative; z-index: 2; line-height: 1.6; font-family: 'Inter', sans-serif;}

    /* PORTAFOLIO */
    .portfolio-grid { column-count: 3; column-gap: 1.5rem; margin: 1.5rem 0 4rem; }
    @media (max-width: 992px) { .portfolio-grid { column-count: 2; } }
    @media (max-width: 768px) { .portfolio-grid { column-count: 1; } }
    .portfolio-item { display: block; position: relative; overflow: hidden; border-radius: 12px; box-shadow: 0 4px 15px rgba(44, 24, 16, 0.1); background: transparent; margin-bottom: 1.5rem; break-inside: avoid; transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: pointer; border: 1px solid rgba(196, 167, 125, 0.2); }
    .portfolio-item:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(44, 24, 16, 0.2); border-color: #c4a77d; }
    .portfolio-item::after { content: attr(data-title); position: absolute; bottom: 0; left: 0; width: 100%; padding: 3rem 1.5rem 1.5rem; background: linear-gradient(to bottom, transparent, rgba(26, 15, 10, 0.95)); color: #f5f0e8; font-size: 1.3rem; font-weight: bold; text-align: left; transform: translateY(100%); transition: transform 0.4s ease; pointer-events: none; z-index: 10; font-family: 'Inter', sans-serif;}
    .portfolio-item:hover::after { transform: translateY(0); }
    .portfolio-item img, .thumbnail-video { width: 100%; height: auto; display: block; transition: transform 0.6s ease; }
    .portfolio-item:hover img, .video-trigger:hover .thumbnail-video { transform: scale(1.08); }
    .play-indicator { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 3rem; color: rgba(255,255,255,0.9); pointer-events: none; text-shadow: 0 4px 10px rgba(0,0,0,0.5); }
    
    /* LIGHTBOX */
    #lightbox { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; }
    #lightbox.active { display: flex; align-items: center; justify-content: center; }
    .lightbox-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(26, 15, 10, 0.95); display: flex; align-items: center; justify-content: center; padding: 1rem; backdrop-filter: blur(5px); }
    .lightbox-content-wrapper { position: relative; display: flex; flex-direction: column; background: #f5f0e8; border-radius: 12px; overflow: hidden; width: 100%; max-width: 1000px; max-height: 90vh; box-shadow: 0 20px 60px rgba(0,0,0,0.6); }
    @media (min-width: 768px) { .lightbox-content-wrapper { flex-direction: row; } }
    #lightbox-media-container { flex: 1; background: #1a0f0a; display: flex; align-items: center; justify-content: center; min-height: 300px; }
    .lightbox-media { max-width: 100%; max-height: 70vh; object-fit: contain; }
    .lightbox-text-panel { padding: 3rem 2.5rem; flex-basis: 400px; overflow-y: auto; }
    .lightbox-text-panel h3 { margin-top: 0; color: #1a0f0a; font-size: 1.8rem; border-bottom: 2px solid #c4a77d; padding-bottom: 0.5rem; display: inline-block; font-weight: 800; }
    .lightbox-text-panel p { color: #3d2317; font-size: 1.1rem; font-family: 'Inter', sans-serif; line-height: 1.6; }
    .lightbox-close { position: absolute; top: -3rem; right: 0; color: #e8dcc8; font-size: 3rem; cursor: pointer; line-height: 1; z-index: 10; font-family: 'Inter', sans-serif; transition: color 0.3s; }
    .lightbox-close:hover { color: white; }
    @media (min-width: 768px) { .lightbox-close { top: 1rem; right: 2rem; } }
    .lightbox-content-wrapper.text-only-mode #lightbox-media-container { display: none; }
    .lightbox-content-wrapper.text-only-mode .lightbox-text-panel { flex-basis: 100%; max-width: 700px; padding: 4rem 3rem; text-align: left; }
    
    /* CONTACTO */
    .contact-info { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(15px); border: 1px solid rgba(196, 167, 125, 0.3); display: inline-block; border-radius: 12px; padding: 3rem 5rem; margin: 0 auto 5rem; box-shadow: 0 15px 40px rgba(44, 24, 16, 0.06); text-align: center; }
    .contact-intro { font-size: 1.3rem; color: #1a0f0a; margin-bottom: 2.5rem; font-family: 'Georgia', serif; font-style: italic; }
    .contact-text { margin: 1rem 0; font-size: 1.15rem; color: #3d2317; font-family: 'Inter', sans-serif;}
    .contact-text a { font-weight: 600; }
    
    .fade-on-scroll { opacity: 0; transform: translateY(25px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
    .fade-on-scroll.is-visible { opacity: 1; transform: translateY(0); }
  </style>
</head>
<body>

  <video id="video-fondo" autoplay muted playsinline loop>
    <source src="/video-1.mp4" type="video/mp4" />
  </video>

  <nav class="top-nav">
    <a href="#servicios">Servicios</a>
    <a href="#portafolio">Portafolio</a>
    <a href="#contacto">Contacto</a>
  </nav>

  <div class="brand-hero fade-on-scroll">
    <h1 class="brand-title">Cofiteca</h1>
    <span class="brand-subtitle">by Mad Diseño</span>
    <p class="brand-tagline">El primer estudio creativo exclusivo para el mundo del café de especialidad en Argentina. Creadores del Mapa Nacional.</p>
    
    <div class="brand-actions">
      <a href="#servicios" class="btn-hero-primary">Transformá tu marca</a>
      <a href="/buscador" class="btn-hero-secondary">📍 Explorar el Mapa</a>
    </div>
  </div>

  <main>
    <!-- SECCIÓN: NOSOTROS / MANIFIESTO -->
    <div id="nosotros"></div>
    <div class="about-container fade-on-scroll">
      <h2 class="about-manifesto-title">Datos reales. Diseño con propósito. Buen café.</h2>
      
      <div class="about-grid">
        <div class="about-block">
          <p class="about-label">El Origen</p>
          <p class="about-text">Nacimos con la idea de crear el primer mapa nacional del café de especialidad, una herramienta basada en datos reales para destacar tanto a los referentes del sector como a los que recién empiezan.</p>
        </div>
        
        <div class="about-block">
          <p class="about-label">El Problema</p>
          <p class="about-text">Recorriendo cafeterías descubrimos un patrón: muchos lugares con un producto excepcional no lograban reflejar esa calidad en su identidad visual. Decidimos cambiar eso.</p>
        </div>
        
        <div class="about-block">
          <p class="about-label">La Solución</p>
          <p class="about-text">Combinamos el análisis de datos con más de 10 años de experiencia en diseño gráfico para crear un estudio creativo exclusivo. Si vos tenés la pasión por el producto, nosotros tenemos las herramientas para construir una imagen de marca sólida que refleje fielmente la calidad de lo que hacés.</p>
        </div>
      </div>
    </div>

    <!-- SECCIÓN: SERVICIOS -->
    <div id="servicios"></div>
    <h2 class="section-title fade-on-scroll">Nuestros Servicios</h2>
    <div class="services-grid fade-on-scroll">
      <a href="#" class="service-card media-trigger" data-type="image" data-src="/tio1.jpg" data-title="Identidad Visual" data-desc="Hacemos branding pensado para proyectos gastronómicos con alma. Ya sea que tengas una cafetería, una heladería artesanal, un proyecto de pastelería o tuestes tu propio café; construimos la identidad de cero (o hacemos un rebranding) para que tu marca se despegue del ruido y tenga una voz gráfica única, coherente y profesional.">
        <div class="service-thumb"><img src="/tio1.jpg" alt="Identidad Visual" loading="lazy" /></div>
        <h3>Identidad Visual</h3>
        <span class="service-hover-text">Leer más ✦</span>
      </a>
      
      <a href="#" class="service-card media-trigger" data-type="image" data-src="/black-bean.jpg" data-title="Piezas para tu Negocio" data-desc="Después de relevar miles de locales en todo el país, sabemos qué funciona. Cruzamos nuestra investigación gráfica con tus ideas para lograr piezas únicas y con identidad propia. Diseñamos menús a medida, packaging para tus productos (desde bolsas de café hasta cajas de cookies o donas) y todos los detalles físicos que acompañan y elevan la experiencia.">
        <div class="service-thumb"><img src="/black-bean.jpg" alt="Piezas para tu Negocio" loading="lazy" /></div>
        <h3>Piezas para tu Negocio</h3>
        <span class="service-hover-text">Leer más ✦</span>
      </a>
      
      <a href="#" class="service-card media-trigger" data-type="image" data-src="/cafe-de-obra.jpg" data-title="Señalética y Espacio" data-desc="Hacemos que tu espacio comunique por vos. Cubrimos toda la pata gráfica y de circulación: desde la fachada de tu local hasta la comunicación visual adentro de tu academia o la cartelería para ferias y eventos del rubro.">
        <div class="service-thumb"><img src="/cafe-de-obra.jpg" alt="Señalética y Espacio" loading="lazy" /></div>
        <h3>Señalética y Espacio</h3>
        <span class="service-hover-text">Leer más ✦</span>
      </a>
      
      <a href="#" class="service-card media-trigger" data-type="image" data-src="/Sara.jpg" data-title="Diseño con Data Real" data-desc="Diseñamos con respaldo técnico. Aprovechamos el mapeo masivo de Cofiteca para investigar y entender el ecosistema a nivel nacional. Esta data nos permite darle a cada diseño un contexto real, asegurando que el resultado final le otorgue a tu proyecto una identidad propia, auténtica y bien plantada en su rubro.">
        <div class="service-thumb"><img src="/Sara.jpg" alt="Diseño con Data Real" loading="lazy" /></div>
        <h3>Diseño con Data Real</h3>
        <span class="service-hover-text">Leer más ✦</span>
      </a>
    </div>

    <!-- SECCIÓN: PROCESO -->
    <div id="proceso"></div>
    <h2 class="section-title fade-on-scroll">Nuestro Proceso</h2>
    <div class="process-grid fade-on-scroll">
      <div class="process-step">
        <div class="step-number">1</div>
        <h4>Auditoría y Contexto</h4>
        <p>Analizamos cada caso particular integrando tus ideas con nuestra experiencia. Cruzamos esta información con la base de datos de Cofiteca para sumar contexto real.</p>
      </div>
      <div class="process-step">
        <div class="step-number">2</div>
        <h4>Conceptualización</h4>
        <p>Búsqueda de un diseño con propósito. Desarrollamos la identidad visual creando marcas sólidas que representan genuinamente tu propuesta.</p>
      </div>
      <div class="process-step">
        <div class="step-number">3</div>
        <h4>Despliegue</h4>
        <p>Aplicación estratégica. Bajamos el concepto aprobado a los distintos puntos de contacto: desde packaging y etiquetas hasta la cartelería.</p>
      </div>
      <div class="process-step">
        <div class="step-number">4</div>
        <h4>Revisión Final</h4>
        <p>Siempre hay detalles visuales por afinar. Hacemos un control de las piezas que entregamos para asegurarnos de que la calidad se mantenga impecable.</p>
      </div>
    </div>

    <!-- SECCIÓN: PORTAFOLIO -->
    <div id="portafolio"></div>
    <h2 class="section-title fade-on-scroll">Casos de Éxito</h2>
    <div class="portfolio-grid fade-on-scroll">
      <a href="#" class="portfolio-item media-trigger" data-type="image" data-src="/cafe-ina-4.png" data-title="Café Ina" data-desc="<strong>Identidad Visual y Experiencia de Barra</strong><br/><em>El Desafío:</em> Crear una identidad sólida para una cafetería de especialidad que logre destacarse en el circuito local.">
        <img src="/cafe-ina-4.png" alt="Café Ina" loading="lazy" />
      </a>
      <a href="#" class="portfolio-item media-trigger" data-type="image" data-src="/cafe-ina-5.jpg" data-title="Café Ina" data-desc="<strong>Aplicación de Marca</strong><br/>Detalle de la identidad visual en los puntos de contacto del local.">
        <img src="/cafe-ina-5.jpg" alt="Café Ina Detalle" loading="lazy" />
      </a>
      <a href="#" class="portfolio-item media-trigger" data-type="image" data-src="/cafe-de-obra.jpg" data-title="Café de Obra" data-desc="<strong>Branding Institucional</strong><br/><em>El Desafío:</em> Integrar una cafetería de especialidad dentro del Centro de Constructores, respetando el entorno histórico.">
        <img src="/cafe-de-obra.jpg" alt="Café de Obra" loading="lazy" />
      </a>
      <a href="#" class="portfolio-item media-trigger" data-type="image" data-src="/black-bean.jpg" data-title="Black Bean" data-desc="<strong>Producto B2B y Packaging</strong><br/><em>El Desafío:</em> Introducir brownies a base de porotos negros diseñados para maridar con café de especialidad.">
        <img src="/black-bean.jpg" alt="Black Bean" loading="lazy" />
      </a>
      <a href="#" class="portfolio-item media-trigger" data-type="image" data-src="/Sara.jpg" data-title="Sara Coffee Shop" data-desc="<strong>Identidad y Redes</strong><br/>Concepto visual, paleta tipográfica y piezas de comunicación.">
        <img src="/Sara.jpg" alt="Sara" loading="lazy" />
      </a>
      <a href="#" class="portfolio-item media-trigger video-trigger" data-type="video" data-src="/luccianos.mp4" data-title="Luccianos" data-desc="<strong>Producción Audiovisual</strong><br/>Registro dinámico de la experiencia y el flujo de trabajo en el local.">
        <video src="/luccianos.mp4" muted loop playsinline autoplay class="thumbnail-video"></video>
        <div class="play-indicator">▶</div>
      </a>
      <a href="#" class="portfolio-item media-trigger" data-type="image" data-src="/tio1.jpg" data-title="Proyecto Tio" data-desc="<strong>Diseño y Aplicación</strong><br/>Exploración visual y desarrollo de estética.">
        <img src="/tio1.jpg" alt="Tio" loading="lazy" />
      </a>
      <a href="#" class="portfolio-item media-trigger" data-type="image" data-src="/tio2.jpg" data-title="Proyecto Tio" data-desc="<strong>Diseño y Aplicación</strong><br/>Variación de las piezas visuales.">
        <img src="/tio2.jpg" alt="Tio 2" loading="lazy" />
      </a>
    </div>

    <!-- SECCIÓN: CONTACTO -->
    <div id="contacto"></div>
    <h2 class="section-title fade-on-scroll">Contacto</h2>
    <div style="text-align: center;">
      <div class="contact-info fade-on-scroll">
        <p class="contact-intro">¿Listos para elevar la experiencia de su café? Hablemos.</p>
        <p class="contact-text"><strong>Email:</strong> <a href="mailto:buscadordecafe@gmail.com">buscadordecafe@gmail.com</a></p>
        <p class="contact-text"><strong>Instagram:</strong> <a href="https://instagram.com/cofiteca_" target="_blank" rel="noopener noreferrer">@cofiteca_</a></p>
        <p class="contact-text"><strong>Sede:</strong> Mar del Plata, Argentina</p>
      </div>
    </div>
  </main>

  <!-- LIGHTBOX -->
  <div id="lightbox">
    <div class="lightbox-overlay">
      <span class="lightbox-close">&times;</span>
      <div class="lightbox-content-wrapper">
        <div id="lightbox-media-container"></div>
        <div class="lightbox-text-panel">
          <h3 id="lightbox-title"></h3>
          <p id="lightbox-desc"></p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Rotación de video
      const video = document.getElementById('video-fondo');
      const playlist = ['/video-1.mp4', '/video-2.mp4', '/video-3.mp4'];
      let currentVideo = 0;
      if (video) {
        video.addEventListener('ended', () => {
          currentVideo = (currentVideo + 1) % playlist.length;
          video.src = playlist[currentVideo];
          video.play();
        });
      }
      
      // 2. Animación de scroll
      const fadeElements = document.querySelectorAll('.fade-on-scroll');
      const fadeObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            fadeObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      fadeElements.forEach(el => fadeObserver.observe(el));

      // 3. Lógica del Lightbox (Ventana emergente)
      const lightbox = document.getElementById('lightbox');
      const overlay = lightbox.querySelector('.lightbox-overlay');
      const wrapper = lightbox.querySelector('.lightbox-content-wrapper');
      const mediaContainer = document.getElementById('lightbox-media-container');
      const titleEl = document.getElementById('lightbox-title');
      const descEl = document.getElementById('lightbox-desc');
      const close = lightbox.querySelector('.lightbox-close');
      
      document.querySelectorAll('.media-trigger').forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault(); 
          
          const type = trigger.getAttribute('data-type');
          const src = trigger.getAttribute('data-src');
          
          titleEl.textContent = trigger.getAttribute('data-title');
          descEl.innerHTML = trigger.getAttribute('data-desc');
          mediaContainer.innerHTML = '';
          
          if (type === 'text') {
            wrapper.classList.add('text-only-mode');
          } else {
            wrapper.classList.remove('text-only-mode');
            if (type === 'video') {
              mediaContainer.innerHTML = `<video src="${src}" autoplay controls playsinline class="lightbox-media"></video>`;
            } else {
              mediaContainer.innerHTML = `<img src="${src}" class="lightbox-media" alt="Ampliación" />`;
            }
          }
          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden';
        });
      });
      
      const closeLightbox = () => {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
        mediaContainer.innerHTML = '';
      };
      
      close.addEventListener('click', closeLightbox);
      overlay.addEventListener('click', (e) => { if (e.target === overlay) closeLightbox(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
    });
  </script>
</body>
</html>
