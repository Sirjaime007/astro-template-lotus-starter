---
// src/pages/index.astro
import {
  cafesCompact, cafesExpanded, regiones, zonasDict, ciudadesRealesDict,
  tostadores, ranking, meta
} from '../lib/cafes';
import mercadoRaw from '../data/mercado.json';

interface DatosMercado {
  latitud?: number;
  longitud?: number;
  poblacion_500m: number;
  publico_diurno_500m?: number;
  competidores_500m: number;
  indice_oportunidad: number;
  nivel_socioeconomico: string;
  atractores_500m: number;
  indice_ticket?: number;
  gasto_turista_usd?: number;
  nivel_circulacion?: string;
}

const mercadoMap = mercadoRaw as Record<string, DatosMercado>;
const mercadoEntries = Object.entries(mercadoMap).map(([slug, val]) => ({
  slug: slug.trim().toLowerCase(),
  ...val
}));

const mercadoCompact = cafesExpanded.map(c => {
  const slugNorm = c.slug.trim().toLowerCase();
  let m: DatosMercado | undefined = mercadoMap[c.slug] ?? mercadoMap[slugNorm];

  if (!m && mercadoEntries.length) {
    let mejorDist = 0.0012;
    for (const item of mercadoEntries) {
      if (item.latitud == null || item.longitud == null) continue;
      const d = Math.hypot(item.latitud - c.lat, item.longitud - c.lon);
      if (d < mejorDist) {
        mejorDist = d;
        m = item;
      }
    }
  }

  const zonaTexto = `${c.ciudad} ${c.ciudadReal || ''} ${c.zona || ''} ${c.ubicacion || ''} ${c.slug}`
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

  const ticket = m?.indice_ticket ?? (
    zonaTexto.includes('puerto madero') ? 1.45 :
    /(palermo|belgrano|recoleta|pinamar|carilo|bariloche)/.test(zonaTexto) ? 1.32 :
    /(guemes|playa grande|mendoza)/.test(zonaTexto) ? 1.24 : 1.08
  );
  const gasto = m?.nivel_socioeconomico ?? (ticket >= 1.35 ? 'Muy Alto' : ticket >= 1.18 ? 'Alto' : 'Medio-Alto');
  const comp = m?.competidores_500m ?? 2;
  const circ = m?.nivel_circulacion ?? 'Media';
  const atr = m?.atractores_500m ?? 18;
  const op = m?.indice_oportunidad ?? Number(Math.min(18.5, Math.max(3.2, (11.5 * ticket) / (1 + comp * 0.45))).toFixed(1));

  return {
    t: ticket,
    g: gasto,
    o: op,
    k: comp,
    c: circ,
    a: atr
  };
});

const datosJSON = JSON.stringify({
  cafes: cafesCompact,
  mercado: mercadoCompact,
  regiones, zonas: zonasDict, ciudadesReales: ciudadesRealesDict,
  tostadores, ranking, meta
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f5f0e8" />
  <title>Cofiteca | Mapa de cafeterías de especialidad de Argentina</title>
  <meta name="description" content="Mapa y buscador de cafeterías de especialidad y tostadores de Argentina. Encontrá cafés por ciudad, zona o cerca tuyo." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin>
  <link rel="dns-prefetch" href="https://nominatim.openstreetmap.org">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  <script is:inline defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline defer src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
  <script is:inline defer src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.0.22/leaflet-maplibre-gl.js"></script>
  <script is:inline defer src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.js"></script>

  <style is:global>
    :root {
      --coffee-900: #1a0f0a; --coffee-700: #3d2317; --coffee-500: #5c3d2e;
      --tan-500: #c4a77d; --tan-300: #dfc9a8; --cream-100: #f5f0e8; --cream-50: #faf7f2;
      --accent: #e86a33; --accent-hover: #c85520;
      --radius-sm: 6px; --radius-md: 10px; --radius-lg: 16px;
      --shadow-sm: 0 1px 3px rgba(26,15,10,.06);
      --shadow-md: 0 4px 15px rgba(26,15,10,.08);
      --shadow-lg: 0 15px 40px rgba(26,15,10,.10);
      --font-display: 'Fraunces', Georgia, serif; --font-body: 'Inter', system-ui, sans-serif;
      --transition: 0.2s cubic-bezier(.4,0,.2,1);
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
    html, body { margin: 0; padding: 0; background: var(--cream-100); color: var(--coffee-900); font-family: var(--font-body); overflow-x: hidden; }
    button, input, select, textarea { font-family: inherit; }
    h1, h2, h3, p { overflow-wrap: anywhere; }

    /* ===== Barra superior ===== */
    .nav-bar { padding: .9rem 2rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(196,167,125,.3); background: rgba(245,240,232,.92); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 1000; }
    .nav-brand { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; letter-spacing: -.02em; color: var(--coffee-900); margin: 0; line-height: 1; }
    .nav-actions { display: flex; gap: 1.2rem; }
    .nav-action-link { font-size: .8rem; font-weight: 600; color: var(--coffee-500); text-decoration: none; cursor: pointer; transition: var(--transition); text-transform: uppercase; letter-spacing: .05em; padding: 8px 0; background: none; border: none; }
    .nav-action-link:hover { color: var(--coffee-900); }
    @media (max-width: 600px) {
      .nav-bar { padding: .7rem 1rem; }
      .nav-brand { font-size: 1.3rem; }
      .nav-actions { gap: .9rem; }
      .nav-action-link { font-size: .72rem; }
    }

    /* ===== Layout ===== */
    .data-real-container { margin: 1.5rem auto 3rem; max-width: 1600px; padding: 0 1.5rem; display: grid; grid-template-columns: 240px minmax(0,1fr); gap: 1.5rem; align-items: start; }
    @media (max-width: 1024px) { .data-real-container { grid-template-columns: minmax(0,1fr); gap: 1rem; margin-top: 1rem; } }
    @media (max-width: 600px) { .data-real-container { padding: 0 .75rem; margin-bottom: 2rem; } }

    .metrics-sidebar { padding: 1.8rem 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 90px; background: rgba(255,255,255,.8); backdrop-filter: blur(10px); border-radius: var(--radius-md); border: 1px solid rgba(196,167,125,.3); box-shadow: var(--shadow-md); }
    @media (max-width: 1024px) { .metrics-sidebar { display: grid; grid-template-columns: repeat(4,1fr); padding: 1rem; gap: .8rem; position: static; } }
    @media (max-width: 600px) { .metrics-sidebar { grid-template-columns: repeat(2,1fr); padding: .9rem; gap: .7rem; } }
    .metric-item { text-align: left; border-left: 3px solid var(--tan-500); padding-left: 1rem; }
    @media (max-width: 1024px) { .metric-item { text-align: center; border-left: none; border-top: 3px solid var(--tan-500); padding: .6rem 0 0; } }
    .metric-number { font-size: 2.5rem; font-weight: 800; color: var(--coffee-900); line-height: 1; display: block; letter-spacing: -.03em; font-family: var(--font-display); }
    @media (max-width: 1024px) { .metric-number { font-size: 2rem; } }
    @media (max-width: 600px) { .metric-number { font-size: 1.7rem; } }
    .metric-label { display: block; font-size: .7rem; color: var(--coffee-500); text-transform: uppercase; letter-spacing: .1em; margin-top: .4rem; font-weight: 700; }

    .buscador-main-panel { min-width: 0; background: rgba(255,255,255,.8); backdrop-filter: blur(10px); border-radius: var(--radius-md); border: 1px solid rgba(196,167,125,.3); box-shadow: var(--shadow-lg); overflow: hidden; }
    .data-header { padding: 1.5rem 1.8rem 1.1rem; border-bottom: 1px solid rgba(196,167,125,.2); }
    @media (max-width: 600px) { .data-header { padding: 1rem; } }
    .data-header h1 { font-size: 2rem; font-weight: 800; margin: 0; color: var(--coffee-900); font-family: var(--font-display); font-variation-settings: 'opsz' 100; letter-spacing: -.02em; line-height: 1.1; }
    @media (max-width: 600px) { .data-header h1 { font-size: 1.5rem; } }

    .view-tabs { display: flex; gap: 8px; margin-top: 1rem; flex-wrap: wrap; }
    @media (max-width: 600px) { .view-tabs { display: grid; grid-template-columns: repeat(4,1fr); gap: 5px; } }
    @media (max-width: 390px) { .view-tabs { grid-template-columns: repeat(2,1fr); } }
    .view-tab-btn { background: transparent; border: 1px solid rgba(196,167,125,.4); color: var(--coffee-500); font-size: .78rem; font-weight: 600; cursor: pointer; padding: 10px 14px; min-height: 40px; border-radius: var(--radius-sm); transition: var(--transition); text-transform: uppercase; letter-spacing: .05em; }
    @media (max-width: 600px) { .view-tab-btn { padding: 9px 4px; font-size: .68rem; letter-spacing: .02em; } }
    .view-tab-btn:hover { background: rgba(196,167,125,.1); color: var(--coffee-900); border-color: var(--tan-500); }
    .view-tab-btn.active { background: var(--coffee-900); color: white; border-color: var(--coffee-900); box-shadow: 0 4px 10px rgba(26,15,10,.2); }

    .buscador-ui { padding: 1.3rem 1.8rem 1.8rem; }
    @media (max-width: 600px) { .buscador-ui { padding: .9rem .8rem 1.2rem; } }

    .recientes-wrap { margin-bottom: 1rem; }
    .recientes-label { font-size: .7rem; font-weight: 700; color: var(--coffee-500); text-transform: uppercase; letter-spacing: .1em; margin-bottom: .5rem; }
    .recientes-list { display: flex; gap: .6rem; overflow-x: auto; padding-bottom: .4rem; -webkit-overflow-scrolling: touch; }
    .reciente-chip { flex-shrink: 0; display: inline-flex; align-items: center; gap: .4rem; padding: 9px 14px; border: 1px solid rgba(196,167,125,.4); border-radius: 999px; background: var(--cream-50); font-size: .8rem; font-weight: 600; color: var(--coffee-700); cursor: pointer; transition: var(--transition); white-space: nowrap; }
    .reciente-chip:hover { border-color: var(--accent); color: var(--accent); background: white; }

    /* ===== Controles ===== */
    .search-controls { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: .7rem; margin-bottom: .8rem; }
    .search-controls.cols-3-eq { grid-template-columns: 1fr 1fr 1fr; }
    .search-controls.cols-2 { grid-template-columns: 1fr 1fr; }
    .search-controls.cols-1 { grid-template-columns: 1fr; }
    @media (max-width: 800px) { .search-controls, .search-controls.cols-2, .search-controls.cols-3-eq { grid-template-columns: 1fr 1fr; } .search-controls input { grid-column: 1 / -1; } }
    @media (max-width: 480px) { .search-controls, .search-controls.cols-2, .search-controls.cols-3-eq { grid-template-columns: 1fr; } }

    .input-moderno { width: 100%; min-width: 0; padding: 12px 14px; min-height: 44px; border: 1px solid rgba(196,167,125,.5); border-radius: var(--radius-sm); font-size: .9rem; background: white; color: var(--coffee-900); outline: none; transition: var(--transition); text-overflow: ellipsis; }
    @media (max-width: 800px) { .input-moderno { font-size: 16px; } }
    .input-moderno:focus { border-color: var(--coffee-900); box-shadow: 0 0 0 3px rgba(26,15,10,.08); }

    .search-buttons { display: flex; gap: .6rem; margin-bottom: .8rem; }
    @media (max-width: 480px) { .search-buttons { flex-direction: column; } }
    .btn-outline-mad, .btn-primary-mad { flex: 1 1 0; min-width: 0; min-height: 44px; padding: 10px 16px; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer; transition: var(--transition); font-size: .85rem; text-align: center; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
    .btn-outline-mad { background: transparent; color: var(--coffee-900); border: 1px solid var(--coffee-900); }
    .btn-outline-mad:hover { background: rgba(26,15,10,.05); }
    .btn-primary-mad { background: var(--coffee-900); color: white; border: 1px solid var(--coffee-900); box-shadow: 0 4px 10px rgba(26,15,10,.15); }
    .btn-primary-mad:hover { background: var(--coffee-700); border-color: var(--coffee-700); }

    .quick-chips { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: .9rem; }
    .quick-chip, .filter-pill { padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(196,167,125,.5); background: var(--cream-50); font-size: .8rem; font-weight: 600; color: var(--coffee-700); cursor: pointer; transition: var(--transition); }
    .quick-chip:hover, .filter-pill:hover { border-color: var(--accent); color: var(--accent); background: white; }
    .filter-pill.active { background: var(--coffee-900); color: white; border-color: var(--coffee-900); }
    .filter-row { display: flex; gap: .5rem; margin-bottom: .9rem; flex-wrap: wrap; align-items: center; }

    .cofi-status { margin: 0 0 .9rem; padding: 10px 14px; background: rgba(196,167,125,.15); border-radius: var(--radius-sm); font-size: .85rem; color: var(--coffee-500); line-height: 1.7; }
    .cofi-status a { color: var(--coffee-900); font-weight: 700; margin: 0 2px; cursor: pointer; text-decoration: underline; display: inline-block; padding: 2px 0; }

    .results-count { font-size: .8rem; color: var(--coffee-500); margin: 0 0 .8rem; font-weight: 500; }

    /* ===== Mapa ===== */
    .map-wrapper { width: 100%; height: 78vh; height: 78dvh; min-height: 560px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid rgba(196,167,125,.4); margin-bottom: 1.5rem; position: relative; z-index: 1; }
    .map-wrapper.mercado-map-box { height: 60vh; height: 60dvh; min-height: 430px; margin-bottom: 1.25rem; }
    @media (max-width: 800px) {
      .map-wrapper { height: 62vh; height: 62dvh; min-height: 400px; margin-bottom: 1.1rem; }
      .map-wrapper.mercado-map-box { height: 50vh; height: 50dvh; min-height: 350px; }
    }
    #cofiteca-map, #ranking-map, #mercado-map { width: 100%; height: 100%; background: #e6e2db; }

    .cafe-label { background: transparent; border: none; box-shadow: none; color: var(--coffee-900); font-weight: 800; font-size: .72rem; text-shadow: 2px 2px 0 white, -2px -2px 0 white, 2px -2px 0 white, -2px 2px 0 white; pointer-events: none; text-transform: uppercase; letter-spacing: .05em; }
    .custom-ranking-icon, .custom-opp-pin { background: none; border: none; }
    .cofi-halo { animation: cofiPulso 1.4s ease-in-out infinite; }
    @keyframes cofiPulso { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }

    .marker-cluster-small, .marker-cluster-medium, .marker-cluster-large { background-color: rgba(232,106,51,.35); }
    .marker-cluster-small div, .marker-cluster-medium div, .marker-cluster-large div { background-color: var(--accent); color: #fff; font-weight: 700; font-family: var(--font-body); }

    .leaflet-container { font-family: var(--font-body); }
    .leaflet-popup-content { margin: 12px 14px; }
    .popup-cafe { text-align: center; font-family: var(--font-body); font-size: .85rem; line-height: 1.45; }
    .popup-cafe b { display: block; margin-bottom: .2rem; font-size: .95rem; }
    .popup-acciones { display: flex; flex-direction: column; gap: 6px; align-items: center; margin-top: 8px; }
    .popup-btn { display: inline-block; background: var(--coffee-900); color: white !important; padding: 7px 14px; border-radius: 5px; font-size: .8rem; text-decoration: none; }
    .popup-link { font-size: .8rem; color: var(--coffee-500); font-weight: 600; text-decoration: underline; padding: 3px 0; }

    /* ===== Vista Mercado ===== */
    .mkt-kpis {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: .8rem;
      margin-bottom: 1rem;
    }
    @media (max-width: 820px) { .mkt-kpis { grid-template-columns: 1fr; } }
    .mkt-kpi-card {
      background: var(--cream-50);
      border: 1px solid rgba(196,167,125,.4);
      border-radius: var(--radius-md);
      padding: .95rem 1.05rem;
      display: flex;
      flex-direction: column;
      gap: .32rem;
      box-shadow: var(--shadow-sm);
    }
    .mkt-kpi-lbl {
      font-size: .7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: var(--coffee-500);
    }
    .mkt-kpi-val {
      font-family: var(--font-display);
      font-size: 1.38rem;
      font-weight: 800;
      color: var(--coffee-900);
      line-height: 1.15;
    }
    .mkt-kpi-val small {
      font-family: var(--font-body);
      font-size: .8rem;
      font-weight: 700;
      color: var(--accent);
    }
    .mkt-bar-bg {
      width: 100%;
      height: 7px;
      border-radius: 999px;
      background: rgba(196,167,125,.28);
      overflow: hidden;
      margin: 2px 0;
    }
    .mkt-bar-fill {
      height: 100%;
      border-radius: 999px;
      transition: width .35s ease, background-color .35s ease;
    }
    .mkt-kpi-sub {
      font-size: .76rem;
      color: var(--coffee-700);
      line-height: 1.4;
    }

    .mkt-legend {
      position: absolute;
      bottom: 14px;
      left: 14px;
      z-index: 600;
      background: rgba(250, 247, 242, 0.96);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(196,167,125,.55);
      border-radius: var(--radius-sm);
      padding: .65rem .85rem;
      box-shadow: var(--shadow-md);
      max-width: 280px;
    }
    .mkt-legend-title {
      font-size: .7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--coffee-900);
      margin-bottom: .4rem;
    }
    .mkt-legend-items {
      display: flex;
      flex-direction: column;
      gap: .28rem;
    }
    .mkt-legend-row {
      display: flex;
      align-items: center;
      gap: .45rem;
      font-size: .74rem;
      color: var(--coffee-700);
      font-weight: 600;
    }
    .mkt-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      flex-shrink: 0;
      border: 1.5px solid white;
      box-shadow: 0 0 0 1px rgba(26,15,10,.2);
    }

    .mkt-section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .6rem;
      margin: 0 0 .85rem;
      flex-wrap: wrap;
    }
    .mkt-section-title {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--coffee-900);
      margin: 0;
    }
    .mkt-reset-btn {
      background: transparent;
      border: 1px solid var(--coffee-900);
      color: var(--coffee-900);
      font-size: .74rem;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      cursor: pointer;
    }
    .mkt-reset-btn:hover { background: var(--coffee-900); color: white; }

    /* Tarjetas de Zonas Recomendadas (Criterio claro) */
    .mkt-opp-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(270px, 100%), 1fr));
      gap: .85rem;
    }
    .mkt-opp-card {
      background: var(--cream-50);
      border: 1px solid rgba(27, 127, 92, 0.35);
      border-left: 5px solid #1b7f5c;
      border-radius: var(--radius-md);
      padding: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: .65rem;
      box-shadow: var(--shadow-sm);
    }
    .mkt-opp-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: .7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: #1b7f5c;
    }
    .mkt-opp-title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--coffee-900);
      margin: .15rem 0;
    }
    .mkt-opp-sub {
      font-size: .78rem;
      font-weight: 600;
      color: var(--coffee-500);
      margin-bottom: .35rem;
    }
    .mkt-opp-criteria {
      list-style: none;
      margin: 0;
      padding: .5rem 0 0;
      border-top: 1px dashed rgba(196,167,125,.45);
      display: flex;
      flex-direction: column;
      gap: .3rem;
      font-size: .78rem;
      color: var(--coffee-700);
    }
    .mkt-opp-criteria li b { color: var(--coffee-900); }
    .mkt-opp-btn {
      width: 100%;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      border: 1px solid #1b7f5c;
      background: #1b7f5c;
      color: white;
      font-size: .76rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
      cursor: pointer;
      transition: var(--transition);
    }
    .mkt-opp-btn:hover { background: #146347; }

    /* Tarjetas por Ciudad / Barrio */
    .mkt-zones-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(245px, 100%), 1fr));
      gap: .75rem;
    }
    .mkt-zone-card {
      text-align: left;
      background: var(--cream-50);
      border: 1px solid rgba(196,167,125,.35);
      border-left-width: 5px;
      border-radius: var(--radius-md);
      padding: .85rem .95rem;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      gap: .35rem;
      box-shadow: var(--shadow-sm);
    }
    .mkt-zone-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      background: white;
    }
    .mkt-zone-card.active {
      background: white;
      box-shadow: 0 0 0 2px var(--coffee-900);
    }
    .mkt-zone-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: .4rem;
    }
    .mkt-zone-name {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: .98rem;
      color: var(--coffee-900);
      line-height: 1.2;
    }
    .mkt-zone-count {
      font-size: .7rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 999px;
      background: rgba(26,15,10,.07);
      color: var(--coffee-700);
      white-space: nowrap;
    }
    .mkt-zone-percap {
      font-size: .8rem;
      font-weight: 700;
      color: var(--coffee-900);
    }
    .mkt-zone-percap span {
      font-weight: 500;
      color: var(--coffee-500);
      font-size: .74rem;
    }
    .mkt-zone-stats {
      display: flex;
      justify-content: space-between;
      gap: .5rem;
      font-size: .76rem;
      color: var(--coffee-700);
      padding-top: .25rem;
      border-top: 1px dashed rgba(196,167,125,.4);
    }

    /* ===== Tarjetas ===== */
    .resultados-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px,100%), 1fr)); gap: 1rem; }
    .cafe-card { position: relative; min-width: 0; background: var(--cream-50); padding: 1.1rem 1.2rem; border-radius: var(--radius-md); border: 1px solid rgba(196,167,125,.25); box-shadow: var(--shadow-sm); transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition); display: flex; flex-direction: column; justify-content: space-between; gap: 10px; }
    .cafe-card:hover { transform: translateY(-3px); border-color: var(--tan-500); box-shadow: var(--shadow-md); }
    .cafe-card.destacada { border-color: var(--coffee-900); box-shadow: 0 0 0 3px rgba(196,167,125,.6); }
    .cafe-card h3 { margin: 0 0 6px; font-size: 1.1rem; color: var(--coffee-900); font-family: var(--font-display); font-weight: 800; font-variation-settings: 'opsz' 40; line-height: 1.25; padding-right: 34px; }
    .cafe-card h3 a { color: inherit; text-decoration: none; }
    .cafe-card h3 a:hover { color: var(--accent); }
    .cafe-card p { margin: 0; font-size: .85rem; color: var(--coffee-500); line-height: 1.5; }
    .cafe-card .card-badge { display: inline-block; background: var(--accent); color: white; font-size: .62rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; padding: 2px 6px; border-radius: 3px; margin-left: 6px; vertical-align: middle; font-family: var(--font-body); }

    .fav-btn { position: absolute; top: 6px; right: 6px; background: transparent; border: none; font-size: 1.4rem; cursor: pointer; width: 40px; height: 40px; border-radius: 6px; line-height: 1; color: var(--tan-500); transition: var(--transition); }
    .fav-btn:hover { transform: scale(1.15); color: var(--accent); }
    .fav-btn.is-fav { color: var(--accent); }

    .cafe-actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .cafe-actions a, .cafe-actions button { flex: 1 1 auto; min-height: 40px; display: inline-flex; align-items: center; justify-content: center; text-align: center; padding: 8px 10px; background: transparent; border-radius: var(--radius-sm); font-weight: 600; font-size: .72rem; color: var(--coffee-900); border: 1px solid var(--coffee-900); text-transform: uppercase; letter-spacing: .05em; text-decoration: none; cursor: pointer; transition: var(--transition); }
    .cafe-actions a:hover, .cafe-actions button:hover { background: var(--coffee-900); color: white; }

    .btn-ver-mas { grid-column: 1 / -1; justify-self: center; min-height: 44px; background: var(--coffee-900); color: white; border: none; padding: 12px 28px; border-radius: var(--radius-sm); font-weight: 600; font-size: .9rem; cursor: pointer; transition: var(--transition); }
    .btn-ver-mas:hover { background: var(--coffee-700); }

    .msg-vacio { grid-column: 1 / -1; text-align: center; padding: 3rem 1rem; }
    .msg-vacio .emoji { font-size: 2.5rem; margin-bottom: .6rem; display: block; }
    .msg-vacio h3 { font-family: var(--font-display); font-size: 1.2rem; color: var(--coffee-900); margin: 0 0 .4rem; }
    .msg-vacio p { font-size: .85rem; color: var(--coffee-500); margin: 0 0 1rem; }
    .msg-vacio button { min-height: 44px; padding: 10px 20px; border-radius: var(--radius-sm); border: 1px solid var(--coffee-900); background: transparent; font-weight: 600; font-size: .85rem; cursor: pointer; color: var(--coffee-900); }
    .msg-vacio button:hover { background: var(--coffee-900); color: white; }

    .skeleton-card { height: 130px; background: linear-gradient(90deg, #ece4d6 25%, #f5f0e8 37%, #ece4d6 63%); background-size: 400% 100%; animation: skeleton 1.4s ease infinite; border-radius: var(--radius-md); }
    @keyframes skeleton { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

    .rank-badge { color: white; font-weight: 700; border-radius: 3px; padding: 2px 6px; font-size: .72rem; }

    /* ===== Tostadores ===== */
    .tostadores-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px,100%), 1fr)); gap: 1rem; }
    .tostador-card { background: var(--cream-50); border: 1px solid rgba(196,167,125,.3); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; transition: var(--transition); }
    .tostador-card:hover { transform: translateY(-3px); border-color: var(--coffee-900); }
    .tostador-img { width: 100%; height: 200px; object-fit: cover; background: var(--cream-100); display: block; }
    @media (max-width: 600px) { .tostador-img { height: 170px; } }
    .tostador-content { padding: 1.1rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; gap: .8rem; }
    .tostador-content h3 { margin: 0 0 4px; font-family: var(--font-display); font-size: 1.15rem; color: var(--coffee-900); }
    .tostador-content p { margin: 0; font-size: .85rem; color: var(--coffee-500); }

    .hidden { display: none !important; }

    /* ===== SweetAlert ===== */
    .swal2-popup.swal-custom-popup { width: min(32em, 92vw) !important; border-radius: var(--radius-md) !important; padding: 1.6rem 1.2rem !important; border: 1px solid rgba(196,167,125,.5) !important; font-family: var(--font-body) !important; background: white !important; }
    .swal-custom-input { width: 100% !important; padding: 12px 14px !important; border: 1px solid rgba(196,167,125,.5) !important; border-radius: var(--radius-sm) !important; font-family: var(--font-body) !important; font-size: 16px !important; box-sizing: border-box !important; background: var(--cream-100) !important; color: var(--coffee-900) !important; margin: 0 !important; }
    .swal-custom-input:focus { border-color: var(--coffee-900) !important; outline: none !important; box-shadow: 0 0 0 3px rgba(26,15,10,.1) !important; }
    .swal2-styled.swal-custom-btn-confirm { background-color: var(--coffee-900) !important; border-radius: var(--radius-sm) !important; font-weight: 600 !important; font-family: var(--font-body) !important; }
    .swal2-styled.swal-custom-btn-cancel { background-color: transparent !important; border: 1px solid var(--coffee-900) !important; color: var(--coffee-900) !important; border-radius: var(--radius-sm) !important; font-weight: 600 !important; font-family: var(--font-body) !important; }
  </style>
</head>
<body>

  <nav class="nav-bar">
    <h2 class="nav-brand">Cofiteca</h2>
    <div class="nav-actions">
      <button type="button" onclick="cofiAbrirSumate()" class="nav-action-link">Añadir local</button>
      <button type="button" onclick="cofiAbrirReporte()" class="nav-action-link">Soporte</button>
    </div>
  </nav>

  <div class="data-real-container">
    <div class="metrics-sidebar">
      <div class="metric-item" id="caja-cafes"><span class="metric-number" id="stat-cafes">{meta.cafes}</span><span class="metric-label" id="label-cafes">Locales</span></div>
      <div class="metric-item" id="caja-tostadores"><span class="metric-number" id="stat-tostadores">{meta.tostadores}</span><span class="metric-label">Tostadores</span></div>
      <div class="metric-item" id="caja-provincias"><span class="metric-number" id="stat-provincias">{meta.provincias}</span><span class="metric-label" id="label-provincias">Provincias</span></div>
      <div class="metric-item" id="caja-ciudades"><span class="metric-number" id="stat-ciudades">{meta.ciudades}</span><span class="metric-label">Ciudades</span></div>
    </div>

    <div class="buscador-main-panel">
      <div class="data-header">
        <h1>Mapa Cofiteca</h1>
        <div class="view-tabs">
          <button class="view-tab-btn active" onclick="cofiSwitchTab('mapa')" id="btn-tab-mapa">Mapa</button>
          <button class="view-tab-btn" onclick="cofiSwitchTab('ranking')" id="btn-tab-ranking">Rankings</button>
          <button class="view-tab-btn" onclick="cofiSwitchTab('tostadores')" id="btn-tab-tostadores">Tostadores</button>
          <button class="view-tab-btn" onclick="cofiSwitchTab('mercado')" id="btn-tab-mercado">Mercado</button>
        </div>
      </div>

      <div class="buscador-ui" id="vista-mapa">
        <div class="quick-chips" id="quick-chips"></div>
