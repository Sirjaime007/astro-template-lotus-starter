            : 'Seleccioná una comuna, barrio o municipio con dato censal.';

          var kpiProvHtml = pcProv
            ? '1 café c/ ' + pcProv.habPorCafe.toLocaleString('es-AR') + ' <small>hab. (' + pcProv.cada100k + '/100k)</small>'
