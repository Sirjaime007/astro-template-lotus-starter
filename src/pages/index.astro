        // ---------- Pestaña DATOS ----------
        function calcularPerCapita(nLocales, poblacion) {
          if (!poblacion || poblacion <= 0 || nLocales <= 0) return null;
          return {
            poblacion: poblacion,
            habPorCafe: Math.round(poblacion / nLocales),
            cada100k: Number(((nLocales / poblacion) * 100000).toFixed(1))
          };
        }

        function formatearDuracionDias(dias) {
          if (dias <= 0) return '0 días';
          if (dias < 45) return dias + (dias === 1 ? ' día' : ' días');
          var meses = Math.round(dias / 30.4);
          if (meses < 18) return dias.toLocaleString('es-AR') + ' días (~' + meses + ' meses)';
          var anios = (dias / 365).toFixed(1).replace('.', ',');
          return dias.toLocaleString('es-AR') + ' días (~' + anios + ' años)';
        }

        window.cofiActualizarDatosSubfiltro = function () {
