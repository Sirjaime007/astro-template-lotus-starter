          });
          var totalLocales = filtrados.length;
          var totalMarcasUnicas = marcasUnicasMap.size;
          var sucursalesRepetidas = Math.max(0, totalLocales - totalMarcasUnicas);

          var lugarLabel = 'Todo Argentina';
