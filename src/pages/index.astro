            document.head.appendChild(s);
          });
          return swalPromise;
        }

        function calcularD(lat1, lon1, lat2, lon2) {
          var dLat = (lat2 - lat1) * Math.PI / 180;
          var dLon = (lon2 - lon1) * Math.PI / 180;
          var a = Math.pow(Math.sin(dLat / 2), 2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.pow(Math.sin(dLon / 2), 2);
          return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        }
        function textoDistancia(dist) {
          var cuadras = Math.round(dist * 10);
          if (cuadras === 0) return '¡A menos de 1 cuadra!';
          if (cuadras <= 30) return 'A ' + cuadras + ' cuadra' + (cuadras !== 1 ? 's' : '');
          return 'A ' + dist.toFixed(1).replace('.', ',') + ' km';
