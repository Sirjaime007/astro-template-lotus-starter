      intento = intento || 0;
      if (typeof L === 'undefined' || typeof L.markerClusterGroup === 'undefined' ||
          typeof L.maplibreGL === 'undefined' || typeof maplibregl === 'undefined') {
        if (intento < 200) setTimeout(function () { iniciarBuscadorSeguro(intento + 1); }, 50);
        return;
      }
      const mapEl = document.getElementById('cofiteca-map');
      const dataEl = document.getElementById('cofi-data');
      if (!mapEl || !dataEl || mapEl._cofiInit) return;
      mapEl._cofiInit = true;

      const $ = id => document.getElementById(id);
      const norm = s => (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
      const esc = s => String(s ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));

      const datos = JSON.parse(dataEl.textContent);
      const mercadoLista = datos.mercado || [];
      const baseDatos = datos.cafes.map((c, idx) => ({
        id: c.id, nombre: c.n, ubicacion: c.u, instagram: c.s, lat: c.a, lon: c.o,
        ciudad: datos.regiones[c.r], zona: c.z >= 0 ? datos.zonas[c.z] : '', ciudadReal: c.c >= 0 ? datos.ciudadesReales[c.c] : '', slug: c.slug,
        mkt: mercadoLista[idx] || { t: 1.08, g: 'Medio-Alto', o: 10.5, k: 2, c: 'Media', a: 18 }
      }));
      baseDatos.forEach(c => { c._q = norm([c.nombre, c.ubicacion, c.zona, c.ciudadReal, c.ciudad].join(' ')); });

      const tostadoresDatos = datos.tostadores;
      const rankingDatos = datos.ranking;
      const meta = datos.meta;

      const POB_REGIONES_RAW = {
        'CABA y Gran Buenos Aires': 13986889,
        'Córdoba': 3840905,
