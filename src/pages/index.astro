      const POB_ZONAS = new Map(Object.entries(POB_ZONAS_RAW).map(([k, v]) => [norm(k), v]));
      const POB_PAIS_TOTAL = Object.values(POB_REGIONES_RAW).reduce((a, b) => a + b, 0);

      // Capitales de provincia, grandes ciudades (Mar del Plata, La Plata, Rosario, etc.) y plazas con alto flujo turístico
      const REGIONES_OBJETIVO = new Set([
        'caba y gran buenos aires',
