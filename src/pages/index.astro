        window.cofiActualizarMetricas = function () {
          var esRanking = $('btn-tab-ranking').classList.contains('active');
          var cafes = 0, tost = 0, prov = 0, ciu = 0;
          if (esRanking) {
            var tipo = $('select-ranking-tipo').value;
