        // Normalización de marca para contar cafeterías con múltiples sucursales una sola vez
        function obtenerClaveMarcaUnica(nombre) {
          var n = norm(nombre);
          n = n.replace(/\([^)]*\)/g, ' ');
          n = n.replace(/\b(sucursal|suc|sede|local|express|to go|take away|roasters|coffee|cafe|cafeteria|specialty|especialidad|tostadores|bakery|panaderia|deli|bistro|bar)\b/g, ' ');
          n = n.split(/\s[-–—|•]\s/)[0];
          n = n.replace(/[^a-z0-9\s]/g, ' ').replace(/\s+/g, ' ').trim();
          return n || norm(nombre);
        }

        baseDatos.forEach(function (c) {
