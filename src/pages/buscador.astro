---
// src/pages/buscador.astro
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Base de Datos | Cofiteca x Mad</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">

  <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  <script is:inline defer src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <style is:global>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background-color: #f5f0e8; color: #1a0f0a; font-family: 'Inter', sans-serif; }
    
    /* NAV BAR SUTIL Y PROFESIONAL */
    .nav-bar { padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(196, 167, 125, 0.3); background: rgba(245, 240, 232, 0.9); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 1000;}
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: #1a0f0a; font-weight: 600; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; transition: 0.2s; }
    .btn-back:hover { color: #8b4513; transform: translateX(-5px); }
    .nav-actions { display: flex; gap: 15px; }
    .nav-action-link { font-size: 0.85rem; font-weight: 600; color: #5c3d2e; text-decoration: none; cursor: pointer; transition: 0.2s; text-transform: uppercase; letter-spacing: 0.05em;}
    .nav-action-link:hover { color: #1a0f0a; }
    
    .data-real-container { margin: 2rem auto 4rem auto; max-width: 1200px; padding: 0 1.5rem; display: grid; grid-template-columns: 260px 1fr; gap: 1.5rem; }
    @media (max-width: 1024px) { .data-real-container { grid-template-columns: 1fr; } }

    /* SIDEBAR MÉTRICAS ESTILO DASHBOARD */
    .metrics-sidebar { padding: 2rem; display: flex; flex-direction: column; justify-content: flex-start; gap: 2.5rem; background: rgba(255,255,255, 0.8); backdrop-filter: blur(10px); border-radius: 12px; border: 1px solid rgba(196, 167, 125, 0.3); box-shadow: 0 15px 40px rgba(44, 24, 16, 0.04); }
    @media (max-width: 1024px) { .metrics-sidebar { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 2rem; padding: 1.5rem; } }
    
    .metric-item { text-align: left; transition: all 0.3s ease; border-left: 3px solid #c4a77d; padding-left: 1rem;}
    @media (max-width: 1024px) { .metric-item { text-align: center; border-left: none; border-bottom: 3px solid #c4a77d; padding-left: 0; padding-bottom: 0.5rem; flex: 1 1 20%; min-width: 120px; } }
    .metric-number { font-size: 2.5rem; font-weight: 800; color: #1a0f0a; line-height: 1; display: block; font-family: 'Inter', sans-serif; letter-spacing: -0.03em;}
    .metric-label { display: block; font-size: 0.75rem; color: #5c3d2e; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.5rem; font-weight: 700; }

    /* PANEL PRINCIPAL */
    .buscador-main-panel { display: flex; flex-direction: column; background: rgba(255,255,255, 0.8); backdrop-filter: blur(10px); border-radius: 12px; border: 1px solid rgba(196, 167, 125, 0.3); box-shadow: 0 15px 40px rgba(44, 24, 16, 0.04); overflow: hidden; }
    
    .data-header { padding: 2.5rem 2rem 1.5rem; text-align: left; border-bottom: 1px solid rgba(196, 167, 125, 0.2); }
    @media (max-width: 768px) { .data-header { padding: 1.5rem; text-align: center; } }
    .data-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; color: #1a0f0a; font-family: 'Georgia', serif; }
    .data-header p { font-size: 0.9rem; color: #5c3d2e; margin: 5px 0 0 0; font-family: 'Inter', sans-serif;}
    
    /* PESTAÑAS ELEGANTES (SIN EMOJIS) */
    .view-tabs { display: flex; gap: 8px; justify-content: flex-start; margin-top: 20px; flex-wrap: wrap;}
    @media (max-width: 768px) { .view-tabs { justify-content: center; } }
    .view-tab-btn { background: transparent; border: 1px solid rgba(196, 167, 125, 0.4); color: #5c3d2e; font-size: 0.85rem; font-weight: 600; cursor: pointer; padding: 8px 16px; border-radius: 6px; transition: 0.2s; font-family: 'Inter', sans-serif; text-transform: uppercase; letter-spacing: 0.05em;}
    .view-tab-btn:hover { background: rgba(196, 167, 125, 0.1); color: #1a0f0a; border-color: #c4a77d;}
    .view-tab-btn.active { background: #1a0f0a; color: white; border-color: #1a0f0a; box-shadow: 0 4px 10px rgba(26, 15, 10, 0.2); }

    .buscador-ui { padding: 2rem; flex-grow: 1; display: flex; flex-direction: column; }
    @media (max-width: 768px) { .buscador-ui { padding: 1.5rem; } }
    
    /* CONTROLES ESTILO AGENCIA */
    .search-controls { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 1rem; margin-bottom: 1.5rem; }
    .search-controls.cols-2 { grid-template-columns: 1fr 1fr; }
    .search-controls.cols-1 { grid-template-columns: 1fr; margin-bottom: 2rem; }
    @media (max-width: 900px) { .search-controls:not(.cols-2):not(.cols-1) { grid-template-columns: 1fr 1fr; } .search-controls:not(.cols-2):not(.cols-1) input { grid-column: 1 / -1; } }
    @media (max-width: 576px) { .search-controls, .search-controls.cols-2 { grid-template-columns: 1fr; } }
    
    .input-moderno { width: 100%; padding: 12px 16px; border: 1px solid rgba(196, 167, 125, 0.5); border-radius: 6px; font-family: 'Inter', sans-serif; font-size: 0.9rem; background: #ffffff; color: #1a0f0a; outline: none; transition: all 0.2s; }
    .input-moderno:focus { border-color: #1a0f0a; box-shadow: 0 0 0 3px rgba(26, 15, 10, 0.1); }
    
    /* BOTONES DE ACCIÓN SOBRIOS */
    .search-buttons { display: flex; gap: 10px; margin-bottom: 2rem; }
    @media (max-width: 576px) { .search-buttons { flex-direction: column; } }
    .btn-outline-mad { flex: 1; background: transparent; color: #1a0f0a; border: 1px solid #1a0f0a; padding: 12px 20px; border-radius: 6px; font-family: 'Inter', sans-serif; font-weight: 600; cursor: pointer; transition: 0.3s; font-size: 0.9rem; text-align: center; }
    .btn-outline-mad:hover { background: rgba(26, 15, 10, 0.05); }
    .btn-primary-mad { flex: 1; background: #1a0f0a; color: white; border: 1px solid #1a0f0a; padding: 12px 20px; border-radius: 6px; font-family: 'Inter', sans-serif; font-weight: 600; cursor: pointer; transition: 0.3s; font-size: 0.9rem; text-align: center; box-shadow: 0 4px 10px rgba(26, 15, 10, 0.2);}
    .btn-primary-mad:hover { background: #3d2317; border-color: #3d2317; }

    /* MAPA */
    .map-wrapper { width: 100%; height: 500px; border-radius: 8px; overflow: hidden; border: 1px solid rgba(196, 167, 125, 0.5); margin-bottom: 2rem; position: relative; z-index: 1;}
    @media (max-width: 768px) { .map-wrapper { height: 400px; } }
    #cofiteca-map, #ranking-map { width: 100%; height: 100%; background: #e6e2db; }
    
    .cafe-label { background: transparent; border: none; box-shadow: none; color: #1a0f0a; font-weight: 800; font-size: 0.75rem; text-shadow: 2px 2px 0px white, -2px -2px 0px white, 2px -2px 0px white, -2px 2px 0px white; opacity: 0; transition: opacity 0.3s ease; pointer-events: none; text-transform: uppercase; letter-spacing: 0.05em;}
    .show-labels .cafe-label { opacity: 1; }
    .custom-ranking-icon { background: none; border: none; }

    /* RESULTADOS GRILLA */
    .resultados-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; max-height: 450px; overflow-y: auto; padding-right: 10px;}
    .resultados-grid::-webkit-scrollbar { width: 6px; }
    .resultados-grid::-webkit-scrollbar-track { background: rgba(196, 167, 125, 0.1); border-radius: 10px; }
    .resultados-grid::-webkit-scrollbar-thumb { background: #c4a77d; border-radius: 10px; }

    .cafe-card { background: white; padding: 1.5rem; border-radius: 8px; border: 1px solid rgba(196, 167, 125, 0.3); box-shadow: 0 4px 15px rgba(0,0,0,0.02); transition: all 0.2s; display: flex; flex-direction: column; justify-content: space-between;}
    .cafe-card:hover { transform: translateY(-3px); border-color: #1a0f0a; box-shadow: 0 8px 25px rgba(26, 15, 10, 0.08); }
    .cafe-card h3 { margin: 0 0 8px 0; font-size: 1.1rem; color: #1a0f0a; font-family: 'Georgia', serif; font-weight: 800; display: flex; align-items: center; gap: 8px; }
    .cafe-card p { margin: 0 0 15px 0; font-size: 0.85rem; color: #5c3d2e; line-height: 1.5;}
    .cafe-card a { text-align: center; display: block; padding: 10px; background: transparent; border-radius: 4px; font-weight: 600; font-size: 0.8rem; color: #1a0f0a; border: 1px solid #1a0f0a; text-transform: uppercase; letter-spacing: 0.05em;}
    .cafe-card a:hover { background: #1a0f0a; color: white; }
    
    .rank-badge { color: white; font-weight: 700; border-radius: 4px; padding: 2px 6px; font-size: 0.75rem; font-family: 'Inter', sans-serif;}

    .tostadores-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
    .tostador-card { background: white; border: 1px solid rgba(196, 167, 125, 0.3); border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.02); display: flex; flex-direction: column; transition: all 0.2s; }
    .tostador-card:hover { transform: translateY(-3px); border-color: #1a0f0a; }
    .tostador-img { width: 100%; height: 200px; object-fit: cover; background-color: #f5f0e8; }
    .tostador-content { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
    
    /* LEALTAD REDISEÑADA */
    .loyalty-hero { text-align: center; padding: 3rem 1rem; }
    .stamp-card { background: #1a0f0a; color: #f5f0e8; border-radius: 12px; padding: 2.5rem; box-shadow: 0 15px 40px rgba(26,15,10,0.3); border: 1px solid rgba(196,167,125,0.2);}
    .stamp-card-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; }
    .stamp-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
    .stamp-slot { aspect-ratio: 1; border: 1px dashed rgba(196,167,125,0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 1rem; color: rgba(196,167,125,0.5); }
    .stamp-slot.filled { border: 1px solid #c4a77d; background: rgba(196,167,125,0.1); color: #c4a77d; font-size: 1.2rem; }
    .stamp-actions { display: flex; gap: 10px; margin-top: 2rem; }
    .stamp-card .btn-outline-mad { color: #f5f0e8; border-color: rgba(245,240,232,0.5); }
    .stamp-card .btn-outline-mad:hover { border-color: #f5f0e8; }
    .stamp-card .btn-primary-mad { background: #f5f0e8; color: #1a0f0a; border-color: #f5f0e8; }
    .loyalty-mov { display: flex; justify-content: space-between; align-items: center; padding: 12px 4px; border-bottom: 1px solid rgba(196,167,125,0.2); font-size: 0.9rem; font-family: 'Inter', sans-serif;}
    .loyalty-historial { max-height: 250px; overflow-y: auto; padding-right: 10px; }

    .hidden { display: none !important; }

    /* SWAL STYLES */
    .swal2-popup.swal-custom-popup { border-radius: 12px !important; padding: 2rem !important; border: 1px solid rgba(196,167,125,0.5) !important; font-family: 'Inter', sans-serif; background: #ffffff !important; }
    .swal-custom-input { width: 100% !important; padding: 12px 16px !important; border: 1px solid rgba(196,167,125,0.5) !important; border-radius: 6px !important; font-family: 'Inter', sans-serif !important; font-size: 0.9rem !important; box-sizing: border-box !important; background: #f5f0e8 !important; color: #1a0f0a !important; margin: 0 !important; }
    .swal-custom-input:focus { border-color: #1a0f0a !important; outline: none !important; box-shadow: 0 0 0 3px rgba(26, 15, 10, 0.1) !important; }
    .swal2-styled.swal-custom-btn-confirm { background-color: #1a0f0a !important; border-radius: 6px !important; font-weight: 600 !important; font-family: 'Inter', sans-serif !important; }
    .swal2-styled.swal-custom-btn-cancel { background-color: transparent !important; border: 1px solid #1a0f0a !important; color: #1a0f0a !important; border-radius: 6px !important; font-weight: 600 !important; font-family: 'Inter', sans-serif !important;}
  </style>
</head>
<body>
  
  <nav class="nav-bar">
    <a href="/" class="btn-back">← Volver al Estudio</a>
    <div class="nav-actions">
        <a onclick="cofiAbrirSumate()" class="nav-action-link">Añadir Local</a>
        <a onclick="cofiAbrirReporte()" class="nav-action-link">Soporte</a>
    </div>
  </nav>

  <div class="data-real-container">
    <div class="metrics-sidebar">
      <div class="metric-item" id="caja-cafes">
        <span class="metric-number" id="stat-cafes">-</span>
        <span class="metric-label" id="label-cafes">Locales Mapeados</span>
      </div>
      <div class="metric-item" id="caja-tostadores">
        <span class="metric-number" id="stat-tostadores">-</span>
        <span class="metric-label" id="label-tostadores">Tostadores</span>
      </div>
      <div class="metric-item" id="caja-provincias">
        <span class="metric-number" id="stat-provincias">-</span>
        <span class="metric-label" id="label-provincias">Provincias</span>
      </div>
      <div class="metric-item" id="caja-ciudades">
        <span class="metric-number" id="stat-ciudades">-</span>
        <span class="metric-label" id="label-ciudades">Ciudades</span>
      </div>
    </div>

    <div class="buscador-main-panel">
      <div class="data-header">
        <h1>Base de Datos Nacional</h1>
        <p id="cofi-status" style="display: none;"></p>
        
        <div class="view-tabs">
            <button class="view-tab-btn active" onclick="cofiSwitchTab('mapa')" id="btn-tab-mapa">Cofiteca Core</button>
            <button class="view-tab-btn" onclick="cofiSwitchTab('ranking')" id="btn-tab-ranking">Rankings Globales</button>
            <button class="view-tab-btn" onclick="cofiSwitchTab('tostadores')" id="btn-tab-tostadores">Guía de Tostadores</button>
            <button class="view-tab-btn" onclick="cofiSwitchTab('lealtad')" id="btn-tab-lealtad">Mi Tarjeta</button>
        </div>
      </div>
      
      <!-- VISTA 1: MAPA GENERAL -->
      <div class="buscador-ui" id="vista-mapa">
        <div class="search-controls">
          <select id="select-ciudad" class="input-moderno" onchange="cofiActualizarZonas(); cofiFiltrar()"><option value="Todas">Región / Ciudad</option></select>
          <select id="select-zona" class="input-moderno" onchange="cofiFiltrar()"><option value="Todas">Zona / Barrio</option></select>
          <input type="text" id="input-busqueda" class="input-moderno" placeholder="Buscar por nombre o dirección..." oninput="cofiFiltrar()">
        </div>
        <div class="search-buttons">
          <button class="btn-outline-mad" onclick="cofiMedirDesdeDireccion()">Buscar por Dirección</button>
          <button class="btn-primary-mad" onclick="cofiUsarMiGPS()">Cerca de mi ubicación</button>
        </div>
        <div class="map-wrapper"><div id="cofiteca-map"></div></div>
        <div id="cofi-resultados" class="resultados-grid"></div>
      </div>

      <!-- VISTA 2: RANKING INTERNACIONAL -->
      <div class="buscador-ui hidden" id="vista-ranking">
        <div class="search-controls cols-2">
          <select id="select-ranking-tipo" class="input-moderno" onchange="cofiActualizarRankingCiudades(); cofiFiltrarRanking(); cofiActualizarMetricas();">
            <option value="arg">Top 100 Argentina</option>
            <option value="sud">Top 100 Sudamérica</option>
            <option value="mun">Top 100 Mundial</option>
          </select>
          <select id="select-ranking-ciudad" class="input-moderno" onchange="cofiFiltrarRanking()">
            <option value="Todas">Todas las Ciudades</option>
          </select>
        </div>
        <div class="map-wrapper"><div id="ranking-map"></div></div>
        <div id="ranking-resultados" class="resultados-grid"></div>
      </div>

      <!-- VISTA 3: TOSTADORES -->
      <div class="buscador-ui hidden" id="vista-tostadores">
        <div class="search-controls cols-1">
            <select id="select-ciudad-tostadores" class="input-moderno" onchange="cofiRenderizarTostadores()"><option value="Todas">Todas las Ciudades</option></select>
        </div>
        <div id="lista-tostadores" class="tostadores-grid">
            <p style="text-align:center; opacity:0.7; grid-column:1/-1;">Sincronizando base de datos...</p>
        </div>
      </div>

      <!-- VISTA 4: TARJETA DE LEALTAD -->
      <div class="buscador-ui hidden" id="vista-lealtad">
        <div id="lealtad-contenido"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function iniciarBuscadorSeguro() {
        if (typeof Papa === 'undefined' || typeof L === 'undefined' || typeof L.markerClusterGroup === 'undefined') {
            setTimeout(iniciarBuscadorSeguro, 50);
            return;
        }

        const mapContenedor = document.getElementById('cofiteca-map');
        if (!mapContenedor) {
            setTimeout(iniciarBuscadorSeguro, 50);
            return;
        }

        if (window.cofitecaInicializada) return;
        window.cofitecaInicializada = true;

        if (mapContenedor._leaflet_id) {
            mapContenedor.outerHTML = '<div id="cofiteca-map" style="width: 100%; height: 100%; background: #e6e2db;"></div>';
        }

        // ==========================================
        // VARIABLES Y GIDs
        // ==========================================
        const SHEET_ID = "10vUOhRr7IAXlRrkBphxEP4ApXYBgrnuxJq6G83GnfHI";
        const urlSheet = gid => `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&gid=${gid}`;

        const GIDS = {
            "Mar del Plata": "0", "CABA y Gran Buenos Aires": "1296176686", "La Plata": "208452991", "Córdoba": "1250014567",
            "Santa Fe": "1691979590", "Mendoza": "2031963266", "Interior de BS AS": "1634818534", "Neuquén y Río Negro": "155647820",
            "Salta y Jujuy": "1993653328", "Chubut, Santa Cruz y Tierra del Fuego": "1650814085", "San Juan, San Luis, La Rioja y La Pampa": "1228328818",
            "Corrientes, Misiones, Entre Rios, Formosa y Chaco": "1097354687", "Catamarca, Tucuman y  Santiago del Estero": "1483010757"
        };
        const TOSTADORES_GID = "1590442133";
        const RANKING_GIDS = { arg: "35250567", sud: "1698883223", mun: "629924037" };
        const IMG_FALLBACK = 'https://images.unsplash.com/photo-1559525839-b184a4d698c7?w=600';

        let baseDatos = [];
        let tostadoresDatos = [];
        let rankingDatos = { arg: [], sud: [], mun: [] };
        
        let mapaCofiteca = null;
        let markerCluster = null;
        let markerOrigen = null; 

        let mapaRanking = null;
        let markerClusterRanking = null;

        let tostadoresRenderizados = false;
        let rankingIniciado = false;

        // ==========================================
        // FUNCIONES GENERALES Y MÉTRICAS DINÁMICAS
        // ==========================================
        window.cofiActualizarMetricas = function() {
            const isRanking = document.getElementById('btn-tab-ranking').classList.contains('active');
            const cajaTost = document.getElementById('caja-tostadores');
            const cajaProv = document.getElementById('caja-provincias');
            const cajaCiu = document.getElementById('caja-ciudades');
            const lblProv = document.getElementById('label-provincias');
            const lblCiu = document.getElementById('label-ciudades');

            let cafesCount = 0, tostCount = 0, provCount = 0, ciuCount = 0;

            if (isRanking) {
                const tipo = document.getElementById('select-ranking-tipo').value;
                const data = rankingDatos[tipo] || [];

                cafesCount = data.length > 0 ? data.length : 100;
                document.getElementById('stat-cafes').innerText = cafesCount;

                if (tipo === 'arg') {
                    lblProv.innerText = "Provincias";
                    const provs = new Set(data.map(d => d.provincia).filter(p => p !== 'Desconocida' && p !== ''));
                    provCount = provs.size;

                    lblCiu.innerText = "Ciudades";
                    const cius = new Set(data.map(d => d.ciudad).filter(c => c !== 'Desconocida' && c !== ''));
                    ciuCount = cius.size;
                } else {
                    lblProv.innerText = "Países";
                    const paises = new Set(data.map(d => d.pais).filter(p => p !== 'Desconocido' && p !== ''));
                    provCount = paises.size;

                    lblCiu.innerText = "Ciudades";
                    const cius = new Set(data.map(d => d.ciudad).filter(c => c !== 'Desconocida' && c !== ''));
                    ciuCount = cius.size;
                }
            } else {
                lblProv.innerText = "Provincias";
                lblCiu.innerText = "Ciudades";

                cafesCount = baseDatos.length;
                tostCount = tostadoresDatos.length;
                provCount = 24; 
                
                // Forzamos 105 como requerimiento fijo en la vista principal
                ciuCount = 105;

                document.getElementById('stat-cafes').innerText = cafesCount;
                document.getElementById('stat-tostadores').innerText = tostCount;
            }

            document.getElementById('stat-provincias').innerText = provCount;
            document.getElementById('stat-ciudades').innerText = ciuCount;

            cajaProv.style.display = provCount > 0 ? '' : 'none';
            cajaCiu.style.display = ciuCount > 0 ? '' : 'none';
            cajaTost.style.display = (!isRanking && tostCount > 0) ? '' : 'none';
        };

        window.cofiSwitchTab = function(tab) {
            document.getElementById('vista-mapa').classList.toggle('hidden', tab !== 'mapa');
            document.getElementById('vista-tostadores').classList.toggle('hidden', tab !== 'tostadores');
            document.getElementById('vista-ranking').classList.toggle('hidden', tab !== 'ranking');
            document.getElementById('vista-lealtad').classList.toggle('hidden', tab !== 'lealtad');
            
            document.getElementById('btn-tab-mapa').classList.toggle('active', tab === 'mapa');
            document.getElementById('btn-tab-tostadores').classList.toggle('active', tab === 'tostadores');
            document.getElementById('btn-tab-ranking').classList.toggle('active', tab === 'ranking');
            document.getElementById('btn-tab-lealtad').classList.toggle('active', tab === 'lealtad');
            
            cofiActualizarMetricas();

            if (tab === 'mapa' && mapaCofiteca) {
                setTimeout(() => mapaCofiteca.invalidateSize(), 200);
            }
            if (tab === 'tostadores' && !tostadoresRenderizados) {
                window.cofiRenderizarTostadores();
                tostadoresRenderizados = true;
            }
            if (tab === 'ranking' && !rankingIniciado) {
                initMapaRanking();
                window.cofiActualizarRankingCiudades();
                window.cofiFiltrarRanking();
                rankingIniciado = true;
            } else if (tab === 'ranking' && mapaRanking) {
                setTimeout(() => mapaRanking.invalidateSize(), 200);
            }

            if (tab === 'lealtad') window.cofiRenderLealtad();
        };

        function asegurarProtocolo(url) {
            if (!url || typeof url !== 'string') return "#";
            const u = url.trim();
            return (!u || u === "#") ? "#" : (/^https?:\/\//i.test(u) ? u : 'https://' + u);
        }

        const norm = s => (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        const esc = s => String(s ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));

        function calcularD(lat1, lon1, lat2, lon2) {
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
            return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        }

        // ==========================================
        // MAPA GENERAL
        // ==========================================
        function initMapa() {
            mapaCofiteca = L.map('cofiteca-map', { maxBoundsViscosity: 1.0, minZoom: 4 }).setView([-38.41, -63.61], 4);
            mapaCofiteca.on('zoomend', () => {
                const mapEl = document.getElementById('cofiteca-map');
                if(mapEl) mapEl.classList.toggle('show-labels', mapaCofiteca.getZoom() >= 15);
            });
            L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', { attribution: 'Tiles &copy; Esri', maxZoom: 16 }).addTo(mapaCofiteca);
            markerCluster = L.markerClusterGroup({ maxClusterRadius: 40, disableClusteringAtZoom: 14, spiderfyOnMaxZoom: true, showCoverageOnHover: false, chunkedLoading: true }).addTo(mapaCofiteca);
        }

        function dibujarMapa() {
            if (!markerCluster) return;
            const ciudadFiltro = document.getElementById('select-ciudad').value;
            const zonaFiltro = document.getElementById('select-zona').value;
            const texto = norm(document.getElementById('input-busqueda').value).trim();
            
            const filtrados = baseDatos.filter(c => 
                (ciudadFiltro === "Todas" || c.ciudad === ciudadFiltro) &&
                (zonaFiltro === "Todas" || c.zona === zonaFiltro) &&
                (!texto || norm(c.nombre).includes(texto) || norm(c.ubicacion).includes(texto))
            );

            const markers = filtrados.map(c => {
                return L.circleMarker([c.lat, c.lon], { radius: 6, color: '#f5f0e8', fillColor: '#1a0f0a', fillOpacity: 0.9, weight: 1.5 })
                .bindPopup(`<div style="text-align:center; font-family:'Inter', sans-serif;"><b>${esc(c.nombre)}</b><br><small>${esc(c.ubicacion)}</small><br><a href="${esc(c.instagram)}" target="_blank" style="display:inline-block; margin-top:5px; background:#1a0f0a; color:white; padding:5px 10px; border-radius:5px; font-size:0.8rem; text-decoration:none;">Instagram</a></div>`)
                .bindTooltip(esc(c.nombre), { permanent: true, direction: 'top', className: 'cafe-label', offset: [0, -10] });
            });

            markerCluster.clearLayers();
            markerCluster.addLayers(markers);

            if (!markerOrigen) {
              if (ciudadFiltro === "Todas" && texto === "") {
                  mapaCofiteca.setView([-38.41, -63.61], 4);
              } else if (filtrados.length > 0) {
                  let lat = 0, lon = 0;
                  filtrados.forEach(c => { lat += c.lat; lon += c.lon; });
                  mapaCofiteca.setView([lat / filtrados.length, lon / filtrados.length], zonaFiltro === "Todas" ? 12 : 14);
              }
            }
        }

        function renderizarResultados(datos, origen = null) {
            const contenedor = document.getElementById('cofi-resultados');
            const frag = document.createDocumentFragment();
            let lista = datos;
            
            if (origen) {
                lista = datos.map(c => ({ ...c, dist: calcularD(origen.lat, origen.lon, c.lat, c.lon) })).sort((a, b) => a.dist - b.dist).slice(0, 30); 
            } else {
                lista = datos.slice(0, 60); 
            }

            lista.forEach(c => {
                let txtDist = "";
                if (origen && c.dist !== undefined) {
                    const cuadras = Math.round(c.dist * 10);
                    txtDist = cuadras === 0 ? `<br><b style="color:#1a0f0a;">📍 ¡A menos de 1 cuadra!</b>` : `<br><b style="color:#1a0f0a;">📍 A ${cuadras} cuadra${cuadras !== 1 ? 's' : ''}</b>`;
                }
                const div = document.createElement('div');
                div.className = 'cafe-card';
                const mostrarCiudad = c.ciudad_real !== '' ? c.ciudad_real : c.ciudad;
                div.innerHTML = `
                    <div><h3>${esc(c.nombre)}</h3><p>${esc(c.ubicacion)} • <b>${esc(mostrarCiudad)}</b>${txtDist}</p></div>
                    <a href="${esc(c.instagram)}" target="_blank" rel="noopener noreferrer">Ver Instagram</a>
                `;
                frag.appendChild(div);
            });
            contenedor.replaceChildren(frag);
            
            if(!origen && datos.length > 60) {
                const aviso = document.createElement('p');
                aviso.style.cssText = "grid-column: 1/-1; text-align:center; font-size:0.9rem; opacity:0.7;";
                aviso.innerText = `Mostrando 60 de ${datos.length} resultados. Refiná tu búsqueda.`;
                contenedor.appendChild(aviso);
            }
        }

        window.cofiActualizarZonas = function() {
            const ciudadFiltro = document.getElementById('select-ciudad').value;
            let zonas = [];
            if (ciudadFiltro === "Todas") {
                zonas = [...new Set(baseDatos.map(c => c.zona))];
            } else {
                zonas = [...new Set(baseDatos.filter(c => c.ciudad === ciudadFiltro).map(c => c.zona))];
            }
            zonas = zonas.filter(z => z && z !== "-" && z !== "Sin Zona").sort();
            document.getElementById('select-zona').innerHTML = `<option value="Todas">Zonas / Barrios</option>` + zonas.map(z => `<option value="${esc(z)}">${esc(z)}</option>`).join('');
        };

        let debounceFiltro = null;
        window.cofiFiltrar = function() {
            clearTimeout(debounceFiltro);
            debounceFiltro = setTimeout(() => {
                if (markerOrigen) {
                    mapaCofiteca.removeLayer(markerOrigen);
                    markerOrigen = null;
                }
                const ciu = document.getElementById('select-ciudad').value;
                const zon = document.getElementById('select-zona').value;
                const txt = norm(document.getElementById('input-busqueda').value).trim();
                
                const filtrados = baseDatos.filter(c => 
                    (ciu === "Todas" || c.ciudad === ciu) &&
                    (zon === "Todas" || c.zona === zon) &&
                    (!txt || norm(c.nombre).includes(txt) || norm(c.ubicacion).includes(txt))
                );
                renderizarResultados(filtrados);
                dibujarMapa();
            }, 150);
        };

        // ==========================================
        // MÓDULO RANKING (THE BEST COFFEE SHOPS)
        // ==========================================
        function getRankingColor(rank) {
            if (!rank || isNaN(rank)) return '#34495e';
            if (rank <= 3) return '#D4AF37'; 
            if (rank <= 10) return '#E86A33'; 
            if (rank <= 20) return '#009FBD';
            if (rank <= 30) return '#8e44ad';
            if (rank <= 40) return '#27ae60';
            if (rank <= 50) return '#f39c12';
            if (rank <= 60) return '#d35400';
            if (rank <= 70) return '#c0392b';
            if (rank <= 80) return '#16a085';
            if (rank <= 90) return '#7f8c8d';
            return '#2c3e50'; 
        }

        function initMapaRanking() {
            const mapContainer = document.getElementById('ranking-map');
            if (mapContainer && mapContainer._leaflet_id) return;

            mapaRanking = L.map('ranking-map', { maxBoundsViscosity: 1.0, minZoom: 2 }).setView([-38.41, -63.61], 4);
            L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', { attribution: 'Tiles &copy; Esri', maxZoom: 16 }).addTo(mapaRanking);
            markerClusterRanking = L.markerClusterGroup({ maxClusterRadius: 35, disableClusteringAtZoom: 12, spiderfyOnMaxZoom: true }).addTo(mapaRanking);
        }

        window.cofiActualizarRankingCiudades = function() {
            const tipo = document.getElementById('select-ranking-tipo').value;
            const data = rankingDatos[tipo] || [];
            
            const lugares = [...new Set(data.map(c => c.lugar))].sort();
            
            const textoFiltro = tipo === 'arg' ? "Todas las Ciudades" : "Todos los Países";
            document.getElementById('select-ranking-ciudad').innerHTML = `<option value="Todas">${textoFiltro}</option>` + lugares.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
        };

        window.cofiFiltrarRanking = function() {
            if (!markerClusterRanking) return;
            const tipo = document.getElementById('select-ranking-tipo').value;
            const lugarSeleccionado = document.getElementById('select-ranking-ciudad').value;
            const data = rankingDatos[tipo] || [];
            
            const filtrados = data.filter(c => lugarSeleccionado === 'Todas' || c.lugar === lugarSeleccionado);
            
            const markers = filtrados.map(c => {
                const color = getRankingColor(c.rank);
                const markerHtml = `<div style="background-color: ${color}; color: white; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; font-weight: 800; border: 2px solid white; box-shadow: 0 3px 6px rgba(0,0,0,0.3); font-size: 13px; font-family: 'Inter', sans-serif;">${c.rank}</div>`;
                const icon = L.divIcon({ html: markerHtml, className: 'custom-ranking-icon', iconSize: [28, 28], iconAnchor: [14, 14] });
                
                return L.marker([c.lat, c.lon], { icon })
                .bindPopup(`<div style="text-align:center; font-family:'Inter', sans-serif;"><span class="rank-badge" style="background:${color};">#${c.rank}</span><br><b>${esc(c.nombre)}</b><br><small>${esc(c.ubicacion)} • ${esc(c.lugar)}</small><br><a href="${esc(c.ig)}" target="_blank" style="display:inline-block; margin-top:5px; background:#1a0f0a; color:white; padding:5px 10px; border-radius:5px; font-size:0.8rem; text-decoration:none;">Instagram</a></div>`);
            });

            markerClusterRanking.clearLayers();
            markerClusterRanking.addLayers(markers);

            if (filtrados.length > 0) {
                let lat = 0, lon = 0;
                filtrados.forEach(c => { lat += c.lat; lon += c.lon; });
                
                let zoomNivel = 12; 
                if (lugarSeleccionado === "Todas") {
                    zoomNivel = tipo === 'mun' ? 2 : 4;
                } else if (tipo !== 'arg') {
                    zoomNivel = 5; 
                }

                mapaRanking.setView([lat / filtrados.length, lon / filtrados.length], zoomNivel);
            }

            const contenedor = document.getElementById('ranking-resultados');
            const frag = document.createDocumentFragment();
            filtrados.forEach(c => {
                const color = getRankingColor(c.rank);
                const div = document.createElement('div');
                div.className = 'cafe-card';
                div.innerHTML = `
                    <div>
                        <h3><span class="rank-badge" style="background:${color};">#${c.rank}</span> ${esc(c.nombre)}</h3>
                        <p>${esc(c.ubicacion)} • <b>${esc(c.lugar)}</b></p>
                    </div>
                    <a href="${esc(c.ig)}" target="_blank" rel="noopener noreferrer">Ver Instagram</a>
                `;
                frag.appendChild(div);
            });
            contenedor.replaceChildren(frag);
        };

        // ==========================================
        // MÓDULO TOSTADORES
        // ==========================================
        window.cofiRenderizarTostadores = function() {
            const ciudad = document.getElementById('select-ciudad-tostadores').value;
            const filtrados = tostadoresDatos.filter(t => ciudad === 'Todas' || t.ciudad === ciudad);
            const contenedor = document.getElementById('lista-tostadores');
            
            if (filtrados.length === 0) {
                contenedor.innerHTML = '<p style="grid-column:1/-1; text-align:center; opacity:0.7;">No hay tostadores registrados en esta ciudad.</p>';
                return;
            }

            const frag = document.createDocumentFragment();
            filtrados.forEach(t => {
                const div = document.createElement('div');
                div.className = 'tostador-card';
                let imgUrl = (t.foto && t.foto !== "#") ? t.foto : IMG_FALLBACK;
                
                let botones = `<a href="${esc(t.ig)}" target="_blank" class="btn-outline-mad" style="margin-bottom:8px; display:block;">Instagram</a>`;
                if (t.tienda && t.tienda !== "#") {
                    botones += `<a href="${esc(t.tienda)}" target="_blank" class="btn-primary-mad" style="display:block;">Tienda Online</a>`;
                }

                div.innerHTML = `
                    <img src="${esc(imgUrl)}" class="tostador-img" loading="lazy" decoding="async" onerror="this.src='${IMG_FALLBACK}'">
                    <div class="tostador-content">
                        <div>
                            <h3 style="margin: 0 0 5px 0; font-family:'Georgia', serif; font-size:1.2rem; color:#1a0f0a;">${esc(t.nombre)}</h3>
                            <p style="margin: 0 0 15px 0; font-size:0.85rem; color:#5c3d2e;">📍 ${esc(t.ciudad)}</p>
                        </div>
                        <div>${botones}</div>
                    </div>
                `;
                frag.appendChild(div);
            });
            contenedor.replaceChildren(frag);
        };

        // ==========================================
        // GPS Y REPORTES
        // ==========================================
        function cofiProcesarOrigen(lat, lon, label) {
            if (markerOrigen) mapaCofiteca.removeLayer(markerOrigen);
            markerOrigen = L.circleMarker([lat, lon], { radius: 8, color: "#1a0f0a", fillColor: "#fff", weight: 3, fillOpacity: 1 }).addTo(mapaCofiteca).bindPopup(label).openPopup();
            mapaCofiteca.setView([lat, lon], 14);
            renderizarResultados(baseDatos, { lat, lon });
        }

        window.cofiUsarMiGPS = function() {
            if (!navigator.geolocation) return Swal.fire("Error", "Tu navegador no soporta GPS.", "error");
            navigator.geolocation.getCurrentPosition(
                p => { 
                    cofiProcesarOrigen(p.coords.latitude, p.coords.longitude, "📍 Estás acá"); 
                },
                () => { 
                    Swal.fire("Aviso", "No pudimos obtener tu ubicación. Revisá los permisos.", "warning"); 
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
            );
        };

        window.cofiMedirDesdeDireccion = function() {
            Swal.fire({
                title: '¿Dónde estás?',
                html: `<p style="font-size:0.9rem; color:#5c3d2e; margin-bottom:15px;">Escribí tu calle y ciudad (Ej: Guemes, Mar del Plata)</p>
                       <input id="swal-autocomplete-input" class="input-moderno" placeholder="Escribir..." autocomplete="off" style="width:100%; box-sizing:border-box;">
                       <div id="autocomplete-results" style="text-align:left; margin-top:10px; max-height:200px; overflow-y:auto;"></div>`,
                showConfirmButton: false, showCancelButton: true, cancelButtonText: 'Cerrar',
                customClass: { popup: 'swal-custom-popup', cancelButton: 'swal-custom-btn-cancel' },
                didOpen: () => {
                    const input = document.getElementById('swal-autocomplete-input'); 
                    const resultsContainer = document.getElementById('autocomplete-results'); 
                    let timeout = null; let solicitudId = 0;
                    input.focus();
                    input.addEventListener('input', () => {
                        clearTimeout(timeout); const val = input.value.trim();
                        if (val.length < 4) { resultsContainer.innerHTML = ''; return; }
                        resultsContainer.innerHTML = '<div style="padding:10px; color:#1a0f0a; font-weight:bold; text-align:center;">Buscando...</div>';
                        timeout = setTimeout(async () => {
                            const miId = ++solicitudId;
                            try {
                                const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(val)}&countrycodes=ar&addressdetails=1&limit=6`);
                                const data = await res.json();
                                if (miId !== solicitudId) return;
                                resultsContainer.innerHTML = '';
                                if (!data.length) { resultsContainer.innerHTML = '<div style="padding:10px; opacity:0.7; text-align:center;">No encontramos la dirección.</div>'; return; }
                                data.forEach(item => {
                                    const partes = [];
                                    if (item.address.road) partes.push(item.address.road + (item.address.house_number ? " " + item.address.house_number : ""));
                                    const localidad = item.address.city || item.address.town || item.address.village;
                                    if (localidad) partes.push(localidad);
                                    
                                    const nombreStr = partes.length > 0 ? partes.join(", ") : item.display_name.split(',').slice(0, 3).join(', ');
                                    const btn = document.createElement('button');
                                    btn.style.cssText = 'width: 100%; text-align: left; background: rgba(255,255,255,0.7); color: #1a0f0a; border: 1px solid rgba(196, 167, 125, 0.5); padding: 12px; border-radius: 6px; cursor: pointer; margin-bottom: 8px; font-family: "Inter", sans-serif; font-size:0.9rem; transition: 0.2s;';
                                    btn.innerHTML = `📍 <b>${esc(nombreStr)}</b>`;
                                    btn.onmouseover = () => btn.style.borderColor = '#1a0f0a';
                                    btn.onmouseout = () => btn.style.borderColor = 'rgba(196, 167, 125, 0.5)';
                                    btn.onclick = () => { 
                                        Swal.close(); 
                                        cofiProcesarOrigen(parseFloat(item.lat), parseFloat(item.lon), nombreStr); 
                                    };
                                    resultsContainer.appendChild(btn);
                                });
                            } catch (e) { if (miId !== solicitudId) return; resultsContainer.innerHTML = '<div style="padding:10px; color:red; text-align:center;">Error con el mapa.</div>'; }
                        }, 800);
                    });
                }
            });
        };

        window.cofiAbrirReporte = async function() {
            const { value: formValues } = await Swal.fire({
                title: 'Soporte',
                customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
                html: `<div style="text-align: left;">
                        <select id="swal-tipo" class="swal-custom-input" style="margin-bottom:10px;">
                            <option value="Dato Incorrecto">Corrección de datos</option>
                            <option value="Local Cerrado">Local cerrado</option>
                            <option value="Ayuda Lealtad">Problemas con Tarjeta de Lealtad</option>
                        </select>
                        <input id="swal-local" class="swal-custom-input" placeholder="Nombre del local o tu teléfono" style="margin-bottom:10px;">
                        <textarea id="swal-detalle" class="swal-custom-input" placeholder="Detalle de la solicitud..." style="height:80px; resize:none;"></textarea>
                       </div>`,
                showCancelButton: true, confirmButtonText: 'Enviar', cancelButtonText: 'Cancelar',
                preConfirm: () => {
                    const local = document.getElementById('swal-local').value.trim();
                    if (!local) { Swal.showValidationMessage('Ingresá una referencia válida'); return false; }
                    return { tipo: document.getElementById('swal-tipo').value, local, detalle: document.getElementById('swal-detalle').value.trim() };
                }
            });
            if (formValues) cofiEnviarReporteEmail(formValues);
        };

        window.cofiAbrirSumate = async function() {
            const { value: formValues } = await Swal.fire({
                title: 'Añadir Local',
                customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
                html: `<div style="text-align: left;">
                        <select id="sumate-tipo" class="swal-custom-input" style="margin-bottom:10px;">
                            <option value="Cafetería / Tostaduría">Cafetería / Tostaduría</option>
                        </select>
                        <input id="sumate-nombre" class="swal-custom-input" placeholder="Nombre comercial" style="margin-bottom:10px;">
                        <input id="sumate-link" class="swal-custom-input" placeholder="Link a Instagram o Web" style="margin-bottom:10px;">
                       </div>`,
                showCancelButton: true, confirmButtonText: 'Enviar Solicitud', cancelButtonText: 'Cancelar',
                preConfirm: () => {
                    const nombre = document.getElementById('sumate-nombre').value.trim();
                    if (!nombre) { Swal.showValidationMessage('Ingresá el nombre comercial'); return false; }
                    return { tipo: "ALTA NUEVA: " + document.getElementById('sumate-tipo').value, local: nombre, detalle: "Link/IG: " + document.getElementById('sumate-link').value.trim() };
                }
            });
            if (formValues) cofiEnviarReporteEmail(formValues);
        };

        window.cofiEnviarReporteEmail = async function(datos) {
            try {
                const URL_DESTINO = '/api/reporte'; 
                await fetch(URL_DESTINO + '?t=' + Date.now(), { 
                    method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(datos) 
                });
                Swal.fire({ title: 'Enviado', text: 'Tu solicitud fue recibida.', icon: 'success', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } }); 
            } catch (error) { 
                Swal.fire({ title: 'Error', text: 'Problemas de conexión con el servidor.', icon: 'error', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } }); 
            }
        };

        // ==========================================
        // MÓDULO TARJETA DE LEALTAD
        // ==========================================
        const LOYALTY_API = 'https://script.google.com/macros/s/PEGÁ_TU_SCRIPT_ID/exec';
        const SELLOS_OBJETIVO = 10;

        function cofiGetUser(){ try { return JSON.parse(localStorage.getItem('cofi_loyalty_user') || 'null'); } catch(e){ return null; } }
        function cofiSetUser(u){ localStorage.setItem('cofi_loyalty_user', JSON.stringify(u)); }

        async function cofiApiPost(body){
            const res = await fetch(LOYALTY_API, { method: 'POST', headers: { 'Content-Type': 'text/plain' }, body: JSON.stringify(body) });
            return res.json();
        }

        window.cofiAbrirLoginLealtad = async function(){
            const { value: f } = await Swal.fire({
                title: 'Tu Tarjeta Mad',
                html: `<div style="text-align:left;">
                        <input id="loy-tel" class="swal-custom-input" placeholder="Tu WhatsApp (ej: 2235551234)" inputmode="tel" style="margin-bottom:10px;">
                        <input id="loy-nom" class="swal-custom-input" placeholder="Tu nombre (solo la primera vez)">
                       </div>`,
                showCancelButton: true, confirmButtonText: 'Entrar', cancelButtonText: 'Cancelar',
                customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
                preConfirm: () => {
                    const tel = document.getElementById('loy-tel').value.replace(/\D/g,'');
                    if (tel.length < 6) { Swal.showValidationMessage('Ingresá un teléfono válido'); return false; }
                    return { tel, nombre: document.getElementById('loy-nom').value.trim() };
                }
            });
            if (!f) return;
            Swal.fire({ title: 'Conectando...', didOpen: () => Swal.showLoading(), allowOutsideClick: false, showConfirmButton: false });
            try {
                const r = await cofiApiPost({ accion: 'registro', tel: f.tel, nombre: f.nombre });
                Swal.close();
                if (!r.ok) throw new Error(r.error);
                cofiSetUser({ tel: f.tel, nombre: f.nombre });
                await window.cofiRenderLealtad();
                Swal.fire({ title: r.nuevo ? 'Bienvenido/a' : 'Hola de nuevo', text: 'Tu tarjeta está lista para usarse.', icon: 'success', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
            } catch(e){
                Swal.fire('Error', 'Problemas al contactar el servidor.', 'error');
            }
        };

        window.cofiCerrarSesionLealtad = function(){
            localStorage.removeItem('cofi_loyalty_user');
            window.cofiRenderLealtad();
        };

        window.cofiSumarSello = async function(codigoPre){
            const user = cofiGetUser();
            if (!user) { window.cofiAbrirLoginLealtad(); return; }
            let codigo = codigoPre;
            if (!codigo) {
                const { value } = await Swal.fire({
                    title: 'Añadir sello',
                    text: 'Ingresá el código de 4 dígitos proporcionado por el local.',
                    input: 'text', inputPlaceholder: 'Ej: A7K2',
                    showCancelButton: true, confirmButtonText: 'Verificar', cancelButtonText: 'Cancelar',
                    customClass: { popup: 'swal-custom-popup', input: 'swal-custom-input', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' }
                });
                codigo = (value || '').trim().toUpperCase();
                if (!codigo) return;
            }
            Swal.fire({ title: 'Verificando...', didOpen: () => Swal.showLoading(), allowOutsideClick: false, showConfirmButton: false });
            try {
                const r = await cofiApiPost({ accion: 'sello', tel: user.tel, codigo });
                Swal.close();
                if (!r.ok) { Swal.fire('Aviso', r.error || 'Código inválido', 'warning'); return; }
                await window.cofiRenderLealtad();
                if (r.completo) {
                    Swal.fire({ title: 'Tarjeta Completa', html: `Acumulaste ${SELLOS_OBJETIVO} sellos en <b>${esc(r.cafe)}</b>.<br>Ya podés procesar el canje de tu café.`, icon: 'success', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
                } else {
                    Swal.fire({ title: 'Sello procesado', text: `Tenés ${r.sellos} de ${SELLOS_OBJETIVO} sellos.`, icon: 'success', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
                }
            } catch(e){ Swal.fire('Error', 'No se pudo procesar la solicitud.', 'error'); }
        };

        window.cofiCanjearPremio = async function(){
            const user = cofiGetUser(); if (!user) return;
            const ok = await Swal.fire({ title: '¿Procesar canje?', text: 'Se vaciará la tarjeta y se generará un código de un solo uso.', icon: 'question', showCancelButton: true, confirmButtonText: 'Confirmar canje', cancelButtonText: 'Cancelar', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' } });
            if (!ok.isConfirmed) return;
            Swal.fire({ title: 'Procesando...', didOpen: () => Swal.showLoading(), allowOutsideClick: false, showConfirmButton: false });
            try {
                const r = await cofiApiPost({ accion: 'canje', tel: user.tel });
                Swal.close();
                if (!r.ok) { Swal.fire('Aviso', r.error, 'warning'); return; }
                await window.cofiRenderLealtad();
                Swal.fire({ title: 'Código de Canje', html: `<div style="font-size:2.2rem; font-weight:800; letter-spacing:0.2em; color:#1a0f0a;">${esc(r.codigo)}</div><p style="font-size:0.85rem;">Válido por 15 minutos. Mostrá este código en caja.</p>`, icon: 'info', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
            } catch(e){ Swal.fire('Error', 'Fallo al procesar el canje.', 'error'); }
        };

        window.cofiRenderLealtad = async function(){
            const cont = document.getElementById('lealtad-contenido');
            const user = cofiGetUser();
            if (!user) {
                cont.innerHTML = `
                    <div class="loyalty-hero">
                        <div style="font-size:3rem; margin-bottom: 1rem; color: #1a0f0a;">M</div>
                        <h2 style="font-family:'Georgia',serif; margin:10px 0 5px;">Tarjeta de Lealtad Mad</h2>
                        <p style="color:#5c3d2e; max-width:420px; margin:0 auto 20px;">Adquirí ${SELLOS_OBJETIVO} cafés en nuestra red asociada y el próximo está a cargo del estudio. Tu teléfono es tu membresía.</p>
                        <button class="btn-primary-mad" style="max-width:260px;" onclick="cofiAbrirLoginLealtad()">Activar Membresía</button>
                    </div>`;
                return;
            }
            cont.innerHTML = '<p style="text-align:center; opacity:0.7;">Sincronizando membresía...</p>';
            try {
                const r = await fetch(`${LOYALTY_API}?accion=datos&tel=${encodeURIComponent(user.tel)}`).then(x => x.json());
                if (!r.ok) throw new Error(r.error || 'sin datos');
                let slots = '';
                for (let i = 0; i < SELLOS_OBJETIVO; i++) {
                    slots += `<div class="stamp-slot ${i < r.sellos ? 'filled' : ''}">${i < r.sellos ? 'C' : i + 1}</div>`;
                }
                const historial = (r.historial || []).map(h => `
                    <div class="loyalty-mov">
                        <span>${h.tipo === 'CANJE' ? 'Extracción' : 'Consumo'} | <b>${esc(h.cafe)}</b></span>
                        <small>${esc(h.fecha)}</small>
                    </div>`).join('');
                cont.innerHTML = `
                    <div class="stamp-card">
                        <div class="stamp-card-head">
                            <div>
                                <p style="margin:0; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.1em; color:rgba(196,167,125,0.8); font-weight:700;">Membresía Mad</p>
                                <h2 style="margin:4px 0 0; font-family:'Georgia',serif;">${esc(r.nombre || user.nombre)}</h2>
                            </div>
                            <button class="btn-outline-mad" style="flex:0; padding:8px 14px; font-size:0.8rem;" onclick="cofiCerrarSesionLealtad()">Desconectar</button>
                        </div>
                        <div class="stamp-grid">${slots}</div>
                        <p style="text-align:center; color:#c4a77d; margin:10px 0 0;">${r.sellos} / ${SELLOS_OBJETIVO} consumos verificados</p>
                        <div class="stamp-actions">
                            <button class="btn-outline-mad" onclick="cofiSumarSello()">Añadir consumo</button>
                            <button class="btn-primary-mad" ${r.sellos >= SELLOS_OBJETIVO ? '' : 'disabled style="opacity:0.45; cursor:not-allowed;"'} onclick="cofiCanjearPremio()">Procesar canje</button>
                        </div>
                    </div>
                    <h3 style="font-family:'Georgia',serif; margin:25px 0 10px;">Registro de actividad</h3>
                    <div class="loyalty-historial">${historial || '<p style="opacity:0.7;">No hay movimientos recientes.</p>'}</div>`;
            } catch(e){
                cont.innerHTML = '<p style="text-align:center; opacity:0.7;">Error de sincronización. Compruebe su conexión de red.</p>';
            }
        };

        setTimeout(() => {
            const cod = new URLSearchParams(location.search).get('sello');
            if (!cod) return;
            window.cofiSwitchTab('lealtad');
            window.cofiSumarSello(cod.toUpperCase().trim());
        }, 1500);

        // ==========================================
        // CARGA Y CACHÉ
        // ==========================================
        function encenderInterfaz(datosMap, tostadoresMap) {
            const ciudades = [...new Set(datosMap.map(c => c.ciudad))].sort();
            document.getElementById('select-ciudad').innerHTML = `<option value="Todas">Región / Ciudad</option>` + 
                ciudades.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
            
            window.cofiActualizarZonas();
            cofiActualizarMetricas();
            initMapa();
            cofiFiltrar();
            
            if (tostadoresMap && tostadoresMap.length > 0) {
                const ciudadesTost = [...new Set(tostadoresMap.map(t => t.ciudad))].sort();
                document.getElementById('select-ciudad-tostadores').innerHTML = `<option value="Todas">Todas las Ciudades</option>` + ciudadesTost.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
            }
        }

        function parseRankingData(rawData, tipo) {
            let currentRank = 999;
            return rawData.map(f => {
                const rawRank = (f.RANKING || f.RANK || "").toString().trim();
                if (rawRank !== "") currentRank = parseInt(rawRank, 10);
                
                const lat = parseFloat((f.LAT || f.LATITUD || '').toString().replace(',', '.'));
                const lon = parseFloat((f.LONG || f.LNG || f.LONGITUD || '').toString().replace(',', '.'));
                
                const lugar_ciudad = (f.CUIDAD || f.CIUDAD || f.CITY || 'Desconocida').trim();
                const lugar_pais = (f.PAIS || f.COUNTRY || 'Desconocido').trim();
                const lugar_prov = (f.PROVINCIA || f.PROVINCE || f.REGION || 'Desconocida').trim();

                const lugar_principal = tipo === 'arg' ? lugar_ciudad : lugar_pais;
                
                return {
                    rank: currentRank,
                    nombre: (f.CAFETERIA || f.CAFE || '').trim(),
                    ubicacion: f.UBICACION || f.DIRECCION || "-",
                    ig: asegurarProtocolo(f.IG || f.INSTAGRAM || "#"),
                    lugar: lugar_principal,
                    ciudad: lugar_ciudad,
                    pais: lugar_pais,
                    provincia: lugar_prov,
                    lat: lat,
                    lon: lon
                };
            }).filter(item => item.nombre && !isNaN(item.lat) && !isNaN(item.lon));
        }

        async function cargarBaseDatos() {
            const CACHE_KEY = 'cofi_data_cache_v7'; 
            const CACHE_TTL = 15 * 60 * 1000; 
            
            try {
                const cacheStr = localStorage.getItem(CACHE_KEY);
                if (cacheStr) {
                    const cacheData = JSON.parse(cacheStr);
                    if (Date.now() - cacheData.time < CACHE_TTL && cacheData.data.length > 0) {
                        baseDatos = cacheData.data;
                        tostadoresDatos = cacheData.tostadores || [];
                        rankingDatos = cacheData.ranking || { arg: [], sud: [], mun: [] };
                        
                        encenderInterfaz(baseDatos, tostadoresDatos);
                        return; 
                    }
                }
            } catch (e) {
                console.warn("Caché vacía o inválida, descargando...");
            }

            try {
                const mapFetchPromises = Object.entries(GIDS).map(([ciu, gid]) =>
                    new Promise((resolve, reject) => {
                        Papa.parse(urlSheet(gid), {
                            download: true, header: true, skipEmptyLines: true,
                            transformHeader: h => h.trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''),
                            complete: res => resolve({ ciu, filas: res.data }),
                            error: reject
                        });
                    })
                );

                const tostadoresPromise = new Promise((resolve, reject) => {
                    Papa.parse(urlSheet(TOSTADORES_GID), {
                        download: true, header: true, skipEmptyLines: true,
                        transformHeader: h => h.trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''),
                        complete: res => resolve(res.data),
                        error: reject
                    });
                });

                const rankArgPromise = new Promise((resolve, reject) => { Papa.parse(urlSheet(RANKING_GIDS.arg), { download: true, header: true, skipEmptyLines: true, transformHeader: h => h.trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''), complete: res => resolve(res.data), error: reject }); });
                const rankSudPromise = new Promise((resolve, reject) => { Papa.parse(urlSheet(RANKING_GIDS.sud), { download: true, header: true, skipEmptyLines: true, transformHeader: h => h.trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''), complete: res => resolve(res.data), error: reject }); });
                const rankMunPromise = new Promise((resolve, reject) => { Papa.parse(urlSheet(RANKING_GIDS.mun), { download: true, header: true, skipEmptyLines: true, transformHeader: h => h.trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''), complete: res => resolve(res.data), error: reject }); });

                const [mapResults, tostadoresDataRaw, rankArgRaw, rankSudRaw, rankMunRaw] = await Promise.all([
                    Promise.allSettled(mapFetchPromises),
                    tostadoresPromise.catch(() => []),
                    rankArgPromise.catch(() => []),
                    rankSudPromise.catch(() => []),
                    rankMunPromise.catch(() => [])
                ]);

                let tempData = [];
                mapResults.forEach(r => {
                    if (r.status === 'fulfilled') {
                        r.value.filas.forEach(f => {
                            if (!f.CAFE) return;
                            const latClean = parseFloat((f.LAT || f.LATITUD || '').toString().replace(',', '.'));
                            const lonClean = parseFloat((f.LONG || f.LNG || f.LONGITUD || '').toString().replace(',', '.'));
                            if (isNaN(latClean) || isNaN(lonClean)) return;
                            
                            const ciudadReal = (f.CUIDAD || f.CIUDAD || f.LOCALIDAD || '').trim();

                            tempData.push({
                                nombre: f.CAFE.trim(), 
                                ciudad: r.value.ciu,
                                ciudad_real: ciudadReal !== '' ? ciudadReal : r.value.ciu, 
                                zona: f.ZONA || f.BARRIO || "Sin Zona",
                                ubicacion: f.UBICACION || "-", instagram: asegurarProtocolo(f.INSTAGRAM || "#"),
                                lat: latClean, lon: lonClean
                            });
                        });
                    }
                });

                tostadoresDatos = tostadoresDataRaw.map(f => ({ 
                    nombre: f.TOSTADOR || f.TOSTADORES || f.NOMBRE, 
                    ig: asegurarProtocolo(f.INSTAGRAM || f.IG || "#"), 
                    tienda: asegurarProtocolo(f['TIENDA ONLINE'] || f.TIENDA || f.LINK || "#"), 
                    ciudad: (f.CIUDAD || 'Varias').trim(), 
                    foto: asegurarProtocolo(f.IMAGENES || f.IMAGEN || f.FOTO || f.FOTOS || "#") 
                })).filter(t => t.nombre);

                rankingDatos = {
                    arg: parseRankingData(rankArgRaw, 'arg'),
                    sud: parseRankingData(rankSudRaw, 'sud'),
                    mun: parseRankingData(rankMunRaw, 'mun')
                };

                if (tempData.length > 0) {
                    tempData.sort((a, b) => a.nombre.localeCompare(b.nombre));
                    baseDatos = tempData;
                    
                    try {
                        localStorage.setItem(CACHE_KEY, JSON.stringify({ time: Date.now(), data: baseDatos, tostadores: tostadoresDatos, ranking: rankingDatos }));
                    } catch(e) { console.warn("No se pudo guardar la caché"); }

                    encenderInterfaz(baseDatos, tostadoresDatos);
                }
            } catch (err) {
                console.error("Error global de carga:", err);
            }
        }

        cargarBaseDatos();
    })();

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
        if (!window.cofitecaInicializada) iniciarBuscadorSeguro();
    } else {
        document.addEventListener('DOMContentLoaded', iniciarBuscadorSeguro);
    }

    document.addEventListener('astro:page-load', () => {
        window.cofitecaInicializada = false;
        iniciarBuscadorSeguro();
    });
  </script>
</body>
</html>
