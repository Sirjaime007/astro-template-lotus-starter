---
// src/pages/buscador.astro
//
// Los datos se bajan de Google Sheets UNA sola vez, al hacer el build, y quedan
// embebidos en la página como JSON. El navegador ya no consulta las planillas.
// Para actualizar los datos hay que volver a desplegar el sitio.

import fs from 'node:fs';

const SHEET_ID = "10vUOhRr7IAXlRrkBphxEP4ApXYBgrnuxJq6G83GnfHI";
const urlSheet = (gid: string) =>
  `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&gid=${gid}`;

const GIDS: Record<string, string> = {
  "Mar del Plata": "0", "CABA y Gran Buenos Aires": "1296176686", "La Plata": "208452991", "Córdoba": "1250014567",
  "Santa Fe": "1691979590", "Mendoza": "2031963266", "Interior de BS AS": "1634818534", "Neuquén y Río Negro": "155647820",
  "Salta y Jujuy": "1993653328", "Chubut, Santa Cruz y Tierra del Fuego": "1650814085", "San Juan, San Luis, La Rioja y La Pampa": "1228328818",
  "Corrientes, Misiones, Entre Rios, Formosa y Chaco": "1097354687", "Catamarca, Tucuman y  Santiago del Estero": "1483010757"
};
const TOSTADORES_GID = "1590442133";
const RANKING_GIDS = { arg: "35250567", sud: "1698883223", mun: "629924037" };

// 23 provincias + CABA
const PROVINCIAS_ARGENTINA = 24;

type Fila = Record<string, string>;

const normHeader = (h: string) => h.trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
const normTexto = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();

// Parser CSV mínimo (soporta comillas, comas y saltos de línea dentro de celdas)
function parseCSV(text: string): string[][] {
  const rows: string[][] = [];
  let row: string[] = [];
  let cur = '';
  let enComillas = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (enComillas) {
      if (ch === '"') {
        if (text[i + 1] === '"') { cur += '"'; i++; } else enComillas = false;
      } else cur += ch;
    } else if (ch === '"') {
      enComillas = true;
    } else if (ch === ',') {
      row.push(cur); cur = '';
    } else if (ch === '\n' || ch === '\r') {
      if (ch === '\r' && text[i + 1] === '\n') i++;
      row.push(cur); cur = '';
      if (row.some(c => c.trim() !== '')) rows.push(row);
      row = [];
    } else cur += ch;
  }
  row.push(cur);
  if (row.some(c => c.trim() !== '')) rows.push(row);
  return rows;
}

async function leerHoja(gid: string, intentos = 3): Promise<Fila[]> {
  let ultimoError: unknown;
  for (let i = 0; i < intentos; i++) {
    try {
      const res = await fetch(urlSheet(gid));
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const filas = parseCSV(await res.text());
      if (filas.length < 2) return [];
      const headers = filas[0].map(normHeader);
      return filas.slice(1).map(r => {
        const o: Fila = {};
        headers.forEach((h, idx) => { if (h) o[h] = (r[idx] ?? '').trim(); });
        return o;
      });
    } catch (e) {
      ultimoError = e;
      await new Promise(r => setTimeout(r, 800 * (i + 1)));
    }
  }
  throw new Error(`No se pudo leer la hoja gid=${gid}: ${ultimoError}`);
}

function numero(v?: string): number | null {
  const n = parseFloat((v ?? '').toString().replace(',', '.'));
  return isNaN(n) ? null : Math.round(n * 1e6) / 1e6;
}

// Devuelve '' si no hay link usable (el cliente oculta el botón en ese caso)
function enlace(url?: string): string {
  const u = (url ?? '').trim();
  if (!u || u === '#') return '';
  if (u.startsWith('@')) return 'https://www.instagram.com/' + u.slice(1);
  return /^https?:\/\//i.test(u) ? u : 'https://' + u;
}

// ---------- Locales ----------
const hojasCafes = await Promise.all(
  Object.entries(GIDS).map(async ([ciudad, gid]) => ({ ciudad, filas: await leerHoja(gid) }))
);

const ciudadesReales = new Set<string>();
const descartados: string[] = [];
const cafesRaw: any[] = [];

for (const { ciudad, filas } of hojasCafes) {
  for (const f of filas) {
    if (!f.CAFE) continue;
    const lat = numero(f.LAT || f.LATITUD);
    const lon = numero(f.LONG || f.LNG || f.LONGITUD);
    if (lat === null || lon === null) continue;
    // Coordenadas fuera de Argentina = casi seguro un error de carga en la planilla
    if (lat < -56 || lat > -21 || lon < -74 || lon > -53) { descartados.push(`${f.CAFE} (${lat}, ${lon})`); continue; }
    const ciudadReal = (f.CUIDAD || f.CIUDAD || f.LOCALIDAD || '').trim();
    if (ciudadReal) ciudadesReales.add(normTexto(ciudadReal));
    cafesRaw.push({
      nombre: f.CAFE.trim(),
      ciudad,
      ciudadReal,
      zona: f.ZONA || f.BARRIO || '',
      ubicacion: f.UBICACION || '-',
      instagram: enlace(f.INSTAGRAM),
      lat, lon
    });
  }
}
if (descartados.length) console.warn(`[buscador] Locales descartados por coordenadas fuera de Argentina:\n - ${descartados.join('\n - ')}`);
if (cafesRaw.length === 0) throw new Error('[buscador] No se cargó ningún local: se cancela el build para no publicar un mapa vacío.');

cafesRaw.sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
// id = posición en el array (el cliente depende de esto)
const cafes = cafesRaw.map((c, i) => ({ id: i, ...c }));

// ---------- Ciudades reales (geocodificación inversa con Georef, datos.gob.ar) ----------
// Para cada local se obtiene provincia + municipio (o departamento si no hay municipio).
// CABA cuenta como una sola ciudad. El resultado se guarda en src/data/geo-cache.json
// (commitear ese archivo): así solo se consultan los locales nuevos y, si la API cae,
// el build sigue funcionando con lo ya guardado.
const GEO_PATH = 'src/data/geo-cache.json';
const geoCache: Record<string, string> = fs.existsSync(GEO_PATH)
  ? JSON.parse(fs.readFileSync(GEO_PATH, 'utf8'))
  : {};
const claveGeo = (c: any) => `${c.lat},${c.lon}`;

const pendientes = cafes.filter(c => !(claveGeo(c) in geoCache));
for (let i = 0; i < pendientes.length; i += 200) {
  const lote = pendientes.slice(i, i + 200);
  try {
    const res = await fetch('https://apis.datos.gob.ar/georef/api/v2.0/ubicacion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ubicaciones: lote.map(c => ({ lat: c.lat, lon: c.lon, aplanar: true })) })
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const { resultados } = await res.json();
    resultados.forEach((r: any, idx: number) => {
      const u = r.ubicacion;
      if (!u?.provincia_nombre) return;
      const nombre = u.provincia_id === '02' ? 'CABA' : (u.municipio_nombre || u.departamento_nombre);
      if (nombre) geoCache[claveGeo(lote[idx])] = `${u.provincia_nombre}|${nombre}`;
    });
  } catch (e) {
    console.warn('[buscador] Georef falló en un lote, se usa lo cacheado:', e);
  }
}
try {
  fs.mkdirSync('src/data', { recursive: true });
  fs.writeFileSync(GEO_PATH, JSON.stringify(geoCache));
} catch (e) {
  console.warn('[buscador] No se pudo guardar el caché de ciudades (no es grave):', e);
}

const ciudadesGeo = new Set(cafes.map(c => geoCache[claveGeo(c)]).filter(Boolean));
const sinResolver = cafes.length - cafes.filter(c => geoCache[claveGeo(c)]).length;
if (sinResolver) console.warn(`[buscador] ${sinResolver} locales sin ciudad resuelta por Georef`);

// ---------- Tostadores ----------
const tostadoresRaw = await leerHoja(TOSTADORES_GID);
const tostadores = tostadoresRaw
  .map(f => ({
    nombre: f.TOSTADOR || f.TOSTADORES || f.NOMBRE || '',
    ig: enlace(f.INSTAGRAM || f.IG),
    tienda: enlace(f['TIENDA ONLINE'] || f.TIENDA || f.LINK),
    ciudad: (f.CIUDAD || 'Varias').trim(),
    foto: enlace(f.IMAGENES || f.IMAGEN || f.FOTO || f.FOTOS)
  }))
  .filter(t => t.nombre);

// ---------- Rankings ----------
function parseRanking(filas: Fila[], tipo: 'arg' | 'sud' | 'mun') {
  let rankActual = 999;
  return filas.map(f => {
    const rawRank = (f.RANKING || f.RANK || '').trim();
    if (rawRank !== '') rankActual = parseInt(rawRank, 10);
    const lat = numero(f.LAT || f.LATITUD);
    const lon = numero(f.LONG || f.LNG || f.LONGITUD);
    const ciudad = (f.CUIDAD || f.CIUDAD || f.CITY || 'Desconocida').trim();
    const pais = (f.PAIS || f.COUNTRY || 'Desconocido').trim();
    const provincia = (f.PROVINCIA || f.PROVINCE || f.REGION || 'Desconocida').trim();
    return {
      rank: rankActual,
      nombre: (f.CAFETERIA || f.CAFE || '').trim(),
      ubicacion: f.UBICACION || f.DIRECCION || '-',
      ig: enlace(f.IG || f.INSTAGRAM),
      lugar: tipo === 'arg' ? ciudad : pais,
      ciudad, pais, provincia, lat, lon
    };
  }).filter(r => r.nombre && r.lat !== null && r.lon !== null);
}

const [rankArg, rankSud, rankMun] = await Promise.all([
  leerHoja(RANKING_GIDS.arg), leerHoja(RANKING_GIDS.sud), leerHoja(RANKING_GIDS.mun)
]);

const datos = {
  cafes,
  tostadores,
  ranking: { arg: parseRanking(rankArg, 'arg'), sud: parseRanking(rankSud, 'sud'), mun: parseRanking(rankMun, 'mun') },
  meta: {
    cafes: cafes.length,
    tostadores: tostadores.length,
    provincias: PROVINCIAS_ARGENTINA,
    ciudades: ciudadesGeo.size || ciudadesReales.size || Object.keys(GIDS).length
  }
};

// El "<" se escapa para que ningún dato pueda cerrar el <script> del JSON
const datosJSON = JSON.stringify(datos).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mapa Cofiteca | Cafeterías de especialidad de Argentina</title>
  <meta name="description" content="Mapa y buscador de cafeterías de especialidad y tostadores de Argentina. Encontrá cafés por ciudad, zona o cerca tuyo." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  <script is:inline defer src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style is:global>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background-color: #f5f0e8; color: #1a0f0a; font-family: 'Inter', sans-serif; }

    /* NAV */
    .nav-bar { padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(196, 167, 125, 0.3); background: rgba(245, 240, 232, 0.9); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 1000;}
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: #1a0f0a; font-weight: 600; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; transition: 0.2s; }
    .btn-back:hover { color: #8b4513; transform: translateX(-5px); }
    .nav-actions { display: flex; gap: 15px; }
    .nav-action-link { font-size: 0.85rem; font-weight: 600; color: #5c3d2e; text-decoration: none; cursor: pointer; transition: 0.2s; text-transform: uppercase; letter-spacing: 0.05em;}
    .nav-action-link:hover { color: #1a0f0a; }

    /* CONTENEDOR */
    .data-real-container { margin: 2rem auto 4rem auto; max-width: 1200px; padding: 0 1.5rem; display: grid; grid-template-columns: 280px 1fr; gap: 1.5rem; align-items: stretch;}
    @media (max-width: 1024px) { .data-real-container { grid-template-columns: 1fr; gap: 1rem; } }

    /* MÉTRICAS */
    .metrics-sidebar { padding: 2.5rem 2rem; display: flex; flex-direction: column; justify-content: space-evenly; gap: 2rem; background: rgba(255,255,255, 0.8); backdrop-filter: blur(10px); border-radius: 12px; border: 1px solid rgba(196, 167, 125, 0.3); box-shadow: 0 15px 40px rgba(44, 24, 16, 0.04); height: 100%; }
    @media (max-width: 1024px) { .metrics-sidebar { display: grid; grid-template-columns: repeat(4, 1fr); padding: 1.5rem; height: auto; gap: 1rem; } }
    @media (max-width: 768px) { .metrics-sidebar { grid-template-columns: repeat(2, 1fr); padding: 1.2rem; } }

    .metric-item { text-align: left; transition: all 0.3s ease; border-left: 4px solid #c4a77d; padding-left: 1.2rem; display: flex; flex-direction: column; justify-content: center;}
    @media (max-width: 1024px) { .metric-item { text-align: center; border-left: none; border-top: 4px solid #c4a77d; padding-left: 0; padding-top: 1rem; } }
    .metric-number { font-size: 3rem; font-weight: 800; color: #1a0f0a; line-height: 1; display: block; letter-spacing: -0.03em;}
    @media (max-width: 1024px) { .metric-number { font-size: 2.5rem; } }
    @media (max-width: 768px) { .metric-number { font-size: 2.2rem; } }
    .metric-label { display: block; font-size: 0.8rem; color: #5c3d2e; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.5rem; font-weight: 700; }
    @media (max-width: 768px) { .metric-label { font-size: 0.7rem; letter-spacing: 0.05em; } }

    /* PANEL PRINCIPAL */
    .buscador-main-panel { display: flex; flex-direction: column; background: rgba(255,255,255, 0.8); backdrop-filter: blur(10px); border-radius: 12px; border: 1px solid rgba(196, 167, 125, 0.3); box-shadow: 0 15px 40px rgba(44, 24, 16, 0.04); overflow: hidden; height: 100%; }
    .data-header { padding: 2.5rem 2rem 1.5rem; text-align: left; border-bottom: 1px solid rgba(196, 167, 125, 0.2); }
    @media (max-width: 768px) { .data-header { padding: 1.5rem; text-align: center; } }
    .data-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; color: #1a0f0a; font-family: 'Georgia', serif; }

    .view-tabs { display: flex; gap: 8px; justify-content: flex-start; margin-top: 20px; flex-wrap: wrap;}
    @media (max-width: 768px) { .view-tabs { justify-content: center; } }
    .view-tab-btn { background: transparent; border: 1px solid rgba(196, 167, 125, 0.4); color: #5c3d2e; font-size: 0.85rem; font-weight: 600; cursor: pointer; padding: 8px 16px; border-radius: 6px; transition: 0.2s; font-family: 'Inter', sans-serif; text-transform: uppercase; letter-spacing: 0.05em;}
    .view-tab-btn:hover { background: rgba(196, 167, 125, 0.1); color: #1a0f0a; border-color: #c4a77d;}
    .view-tab-btn.active { background: #1a0f0a; color: white; border-color: #1a0f0a; box-shadow: 0 4px 10px rgba(26, 15, 10, 0.2); }

    .buscador-ui { padding: 2rem; flex-grow: 1; display: flex; flex-direction: column; }
    @media (max-width: 768px) { .buscador-ui { padding: 1.5rem; } }

    /* CONTROLES */
    .search-controls { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 1rem; margin-bottom: 1.5rem; }
    .search-controls.cols-2 { grid-template-columns: 1fr 1fr; }
    .search-controls.cols-1 { grid-template-columns: 1fr; margin-bottom: 2rem; }
    @media (max-width: 900px) { .search-controls:not(.cols-2):not(.cols-1) { grid-template-columns: 1fr 1fr; } .search-controls:not(.cols-2):not(.cols-1) input { grid-column: 1 / -1; } }
    @media (max-width: 576px) { .search-controls, .search-controls.cols-2 { grid-template-columns: 1fr; } }

    .input-moderno { width: 100%; padding: 12px 16px; border: 1px solid rgba(196, 167, 125, 0.5); border-radius: 6px; font-family: 'Inter', sans-serif; font-size: 0.9rem; background: #ffffff; color: #1a0f0a; outline: none; transition: all 0.2s; }
    .input-moderno:focus { border-color: #1a0f0a; box-shadow: 0 0 0 3px rgba(26, 15, 10, 0.1); }

    .search-buttons { display: flex; gap: 10px; margin-bottom: 1.5rem; }
    @media (max-width: 576px) { .search-buttons { flex-direction: column; } }
    .btn-outline-mad { flex: 1; background: transparent; color: #1a0f0a; border: 1px solid #1a0f0a; padding: 12px 20px; border-radius: 6px; font-family: 'Inter', sans-serif; font-weight: 600; cursor: pointer; transition: 0.3s; font-size: 0.9rem; text-align: center; text-decoration: none; }
    .btn-outline-mad:hover { background: rgba(26, 15, 10, 0.05); }
    .btn-primary-mad { flex: 1; background: #1a0f0a; color: white; border: 1px solid #1a0f0a; padding: 12px 20px; border-radius: 6px; font-family: 'Inter', sans-serif; font-weight: 600; cursor: pointer; transition: 0.3s; font-size: 0.9rem; text-align: center; text-decoration: none; box-shadow: 0 4px 10px rgba(26, 15, 10, 0.2);}
    .btn-primary-mad:hover { background: #3d2317; border-color: #3d2317; }

    .cofi-status { margin: -0.5rem 0 1.2rem 0; padding: 10px 14px; background: rgba(196, 167, 125, 0.15); border-radius: 6px; font-size: 0.85rem; color: #5c3d2e; }
    .cofi-status a { color: #1a0f0a; font-weight: 700; margin-left: 8px; cursor: pointer; text-decoration: underline; }

    /* MAPA */
    .map-wrapper { width: 100%; height: 500px; border-radius: 8px; overflow: hidden; border: 1px solid rgba(196, 167, 125, 0.5); margin-bottom: 2rem; position: relative; z-index: 1;}
    @media (max-width: 768px) { .map-wrapper { height: 400px; } }
    #cofiteca-map, #ranking-map { width: 100%; height: 100%; background: #e6e2db; }

    /* Las etiquetas solo existen desde zoom 15 (se crean desde JS) */
    .cafe-label { background: transparent; border: none; box-shadow: none; color: #1a0f0a; font-weight: 800; font-size: 0.75rem; text-shadow: 2px 2px 0px white, -2px -2px 0px white, 2px -2px 0px white, -2px 2px 0px white; pointer-events: none; text-transform: uppercase; letter-spacing: 0.05em;}
    .custom-ranking-icon { background: none; border: none; }

    .popup-cafe { text-align: center; font-family: 'Inter', sans-serif; }
    .popup-acciones { display: flex; flex-direction: column; gap: 6px; align-items: center; margin-top: 8px; }
    .popup-btn { display: inline-block; background: #1a0f0a; color: white !important; padding: 5px 12px; border-radius: 5px; font-size: 0.8rem; text-decoration: none; }
    .popup-link { font-size: 0.8rem; color: #5c3d2e; font-weight: 600; text-decoration: underline; }

    /* LISTA: scroll normal de la página, sin scroll interno */
    .resultados-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }

    .cafe-card { background: white; padding: 1.5rem; border-radius: 8px; border: 1px solid rgba(196, 167, 125, 0.3); box-shadow: 0 4px 15px rgba(0,0,0,0.02); transition: all 0.2s; display: flex; flex-direction: column; justify-content: space-between; gap: 12px;}
    .cafe-card:hover { transform: translateY(-3px); border-color: #1a0f0a; box-shadow: 0 8px 25px rgba(26, 15, 10, 0.08); }
    .cafe-card.destacada { border-color: #1a0f0a; box-shadow: 0 0 0 3px rgba(196, 167, 125, 0.6); }
    .cafe-card h3 { margin: 0 0 8px 0; font-size: 1.1rem; color: #1a0f0a; font-family: 'Georgia', serif; font-weight: 800; display: flex; align-items: center; gap: 8px; }
    .cafe-card p { margin: 0; font-size: 0.85rem; color: #5c3d2e; line-height: 1.5;}

    .cafe-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .cafe-actions a, .cafe-actions button { flex: 1 1 auto; text-align: center; padding: 9px 10px; background: transparent; border-radius: 4px; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.75rem; color: #1a0f0a; border: 1px solid #1a0f0a; text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; cursor: pointer; transition: 0.2s; }
    .cafe-actions a:hover, .cafe-actions button:hover { background: #1a0f0a; color: white; }

    .btn-ver-mas { grid-column: 1 / -1; justify-self: center; background: #1a0f0a; color: white; border: none; padding: 12px 28px; border-radius: 6px; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.9rem; cursor: pointer; }
    .msg-vacio { grid-column: 1 / -1; text-align: center; opacity: 0.7; padding: 2rem 0; }

    .rank-badge { color: white; font-weight: 700; border-radius: 4px; padding: 2px 6px; font-size: 0.75rem; font-family: 'Inter', sans-serif;}

    .tostadores-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
    .tostador-card { background: white; border: 1px solid rgba(196, 167, 125, 0.3); border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.02); display: flex; flex-direction: column; transition: all 0.2s; }
    .tostador-card:hover { transform: translateY(-3px); border-color: #1a0f0a; }
    .tostador-img { width: 100%; height: 200px; object-fit: cover; background-color: #f5f0e8; }
    .tostador-content { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }

    .hidden { display: none !important; }

    /* SWAL */
    .swal2-popup.swal-custom-popup { border-radius: 12px !important; padding: 2rem !important; border: 1px solid rgba(196,167,125,0.5) !important; font-family: 'Inter', sans-serif; background: #ffffff !important; }
    .swal-custom-input { width: 100% !important; padding: 12px 16px !important; border: 1px solid rgba(196,167,125,0.5) !important; border-radius: 6px !important; font-family: 'Inter', sans-serif !important; font-size: 0.9rem !important; box-sizing: border-box !important; background: #f5f0e8 !important; color: #1a0f0a !important; margin: 0 !important; }
    .swal-custom-input:focus { border-color: #1a0f0a !important; outline: none !important; box-shadow: 0 0 0 3px rgba(26, 15, 10, 0.1) !important; }
    .swal2-styled.swal-custom-btn-confirm { background-color: #1a0f0a !important; border-radius: 6px !important; font-weight: 600 !important; font-family: 'Inter', sans-serif !important; }
    .swal2-styled.swal-custom-btn-cancel { background-color: transparent !important; border: 1px solid #1a0f0a !important; color: #1a0f0a !important; border-radius: 6px !important; font-weight: 600 !important; font-family: 'Inter', sans-serif !important;}
  </style>
</head>
<body>

  <nav class="nav-bar">
    <a href="/" class="btn-back">← Volver al Estudio</a>
    <div class="nav-actions">
      <a onclick="cofiAbrirSumate()" class="nav-action-link">Añadir Local</a>
      <a onclick="cofiAbrirReporte()" class="nav-action-link">Soporte</a>
    </div>
  </nav>

  <div class="data-real-container">
    <div class="metrics-sidebar">
      <div class="metric-item" id="caja-cafes">
        <span class="metric-number" id="stat-cafes">{datos.meta.cafes}</span>
        <span class="metric-label" id="label-cafes">Locales Mapeados</span>
      </div>
      <div class="metric-item" id="caja-tostadores">
        <span class="metric-number" id="stat-tostadores">{datos.meta.tostadores}</span>
        <span class="metric-label" id="label-tostadores">Tostadores</span>
      </div>
      <div class="metric-item" id="caja-provincias">
        <span class="metric-number" id="stat-provincias">{datos.meta.provincias}</span>
        <span class="metric-label" id="label-provincias">Provincias</span>
      </div>
      <div class="metric-item" id="caja-ciudades">
        <span class="metric-number" id="stat-ciudades">{datos.meta.ciudades}</span>
        <span class="metric-label" id="label-ciudades">Ciudades</span>
      </div>
    </div>

    <div class="buscador-main-panel">
      <div class="data-header">
        <h1>Mapa Cofiteca</h1>
        <div class="view-tabs">
          <button class="view-tab-btn active" onclick="cofiSwitchTab('mapa')" id="btn-tab-mapa">Mapa Argentina</button>
          <button class="view-tab-btn" onclick="cofiSwitchTab('ranking')" id="btn-tab-ranking">Rankings Globales</button>
          <button class="view-tab-btn" onclick="cofiSwitchTab('tostadores')" id="btn-tab-tostadores">Guía de Tostadores</button>
        </div>
      </div>

      <!-- VISTA 1: MAPA GENERAL -->
      <div class="buscador-ui" id="vista-mapa">
        <div class="search-controls">
          <select id="select-ciudad" class="input-moderno" onchange="cofiActualizarZonas(); cofiFiltrar(true)"><option value="Todas">Región / Ciudad</option></select>
          <select id="select-zona" class="input-moderno" onchange="cofiFiltrar(true)"><option value="Todas">Zona / Barrio</option></select>
          <input type="text" id="input-busqueda" class="input-moderno" placeholder="Buscar por nombre, zona o dirección..." oninput="cofiFiltrar(false)">
        </div>
        <div class="search-buttons">
          <button class="btn-outline-mad" onclick="cofiMedirDesdeDireccion()">Buscar por Dirección</button>
          <button class="btn-primary-mad" onclick="cofiUsarMiGPS()">Cerca de mi ubicación</button>
        </div>
        <p id="cofi-status" class="cofi-status hidden"></p>
        <div class="map-wrapper"><div id="cofiteca-map"></div></div>
        <div id="cofi-resultados" class="resultados-grid"></div>
      </div>

      <!-- VISTA 2: RANKING -->
      <div class="buscador-ui hidden" id="vista-ranking">
        <div class="search-controls cols-2">
          <select id="select-ranking-tipo" class="input-moderno" onchange="cofiActualizarRankingCiudades(); cofiFiltrarRanking(); cofiActualizarMetricas();">
            <option value="arg">Top 100 Argentina</option>
            <option value="sud">Top 100 Sudamérica</option>
            <option value="mun">Top 100 Mundial</option>
          </select>
          <select id="select-ranking-ciudad" class="input-moderno" onchange="cofiFiltrarRanking()">
            <option value="Todas">Todas las Ciudades</option>
          </select>
        </div>
        <div class="map-wrapper"><div id="ranking-map"></div></div>
        <div id="ranking-resultados" class="resultados-grid"></div>
      </div>

      <!-- VISTA 3: TOSTADORES -->
      <div class="buscador-ui hidden" id="vista-tostadores">
        <div class="search-controls cols-1">
          <select id="select-ciudad-tostadores" class="input-moderno" onchange="cofiRenderizarTostadores()"><option value="Todas">Todas las Ciudades</option></select>
        </div>
        <div id="lista-tostadores" class="tostadores-grid"></div>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="cofi-data" set:html={datosJSON}></script>

  <script is:inline>
    function iniciarBuscadorSeguro(intento) {
      intento = intento || 0;

      // Las librerías cargan con "defer": esperamos a que existan
      if (typeof L === 'undefined' || typeof L.markerClusterGroup === 'undefined') {
        if (intento < 200) setTimeout(function () { iniciarBuscadorSeguro(intento + 1); }, 50);
        return;
      }

      const mapEl = document.getElementById('cofiteca-map');
      const dataEl = document.getElementById('cofi-data');
      if (!mapEl || !dataEl) return;
      if (mapEl._cofiInit) return;   // este mapa ya fue inicializado
      mapEl._cofiInit = true;

      const $ = id => document.getElementById(id);
      const norm = s => (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const esc = s => String(s ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));

      // ==========================================
      // DATOS (embebidos en la página en el build)
      // ==========================================
      const datos = JSON.parse(dataEl.textContent);
      const baseDatos = datos.cafes;            // baseDatos[i].id === i
      const tostadoresDatos = datos.tostadores;
      const rankingDatos = datos.ranking;
      const meta = datos.meta;

      // Texto de búsqueda precalculado (se normaliza una vez, no en cada tecla)
      baseDatos.forEach(c => { c._q = norm([c.nombre, c.ubicacion, c.zona, c.ciudadReal, c.ciudad].join(' ')); });

      const PAGINA = 24;
      const ZOOM_ETIQUETAS = 15;
      const VISTA_ARGENTINA = [-38.41, -63.61];
      const IMG_FALLBACK = 'https://images.unsplash.com/photo-1559525839-b184a4d698c7?w=600';
      const TILES = 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}';

      let mapaCofiteca = null, markerCluster = null;
      let mapaRanking = null, markerClusterRanking = null;
      let tostadoresRenderizados = false, rankingIniciado = false;

      const markersPorId = new Map();
      let markersActuales = [];
      let marcadoresConEtiqueta = [];

      let origen = null, markerOrigen = null;
      let listaActual = [], idsEnLista = new Set(), mostrados = PAGINA, idDestacado = null;

      function calcularD(lat1, lon1, lat2, lon2) {
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
        return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      function textoDistancia(dist) {
        const cuadras = Math.round(dist * 10);
        if (cuadras === 0) return '¡A menos de 1 cuadra!';
        if (cuadras <= 30) return 'A ' + cuadras + ' cuadra' + (cuadras !== 1 ? 's' : '');
        return 'A ' + dist.toFixed(1).replace('.', ',') + ' km';
      }

      const urlComoLlegar = c => 'https://www.google.com/maps/search/?api=1&query=' + c.lat + ',' + c.lon;

      // ==========================================
      // MÉTRICAS
      // ==========================================
      window.cofiActualizarMetricas = function () {
        const esRanking = $('btn-tab-ranking').classList.contains('active');
        let cafes = 0, tost = 0, prov = 0, ciu = 0;

        if (esRanking) {
          const tipo = $('select-ranking-tipo').value;
          const data = rankingDatos[tipo] || [];
          const cuenta = (campo, vacio) => new Set(data.map(d => d[campo]).filter(v => v && v !== vacio)).size;
          cafes = data.length;
          if (tipo === 'arg') { $('label-provincias').innerText = 'Provincias'; prov = cuenta('provincia', 'Desconocida'); }
          else { $('label-provincias').innerText = 'Países'; prov = cuenta('pais', 'Desconocido'); }
          ciu = cuenta('ciudad', 'Desconocida');
        } else {
          $('label-provincias').innerText = 'Provincias';
          cafes = meta.cafes; tost = meta.tostadores; prov = meta.provincias; ciu = meta.ciudades;
        }

        $('stat-cafes').innerText = cafes;
        $('stat-tostadores').innerText = tost;
        $('stat-provincias').innerText = prov;
        $('stat-ciudades').innerText = ciu;
        $('caja-provincias').style.display = prov > 0 ? '' : 'none';
        $('caja-ciudades').style.display = ciu > 0 ? '' : 'none';
        $('caja-tostadores').style.display = (!esRanking && tost > 0) ? '' : 'none';
      };

      window.cofiSwitchTab = function (tab) {
        ['mapa', 'ranking', 'tostadores'].forEach(t => {
          $('vista-' + t).classList.toggle('hidden', t !== tab);
          $('btn-tab-' + t).classList.toggle('active', t === tab);
        });
        window.cofiActualizarMetricas();

        if (tab === 'mapa' && mapaCofiteca) setTimeout(() => mapaCofiteca.invalidateSize(), 200);
        if (tab === 'tostadores' && !tostadoresRenderizados) { window.cofiRenderizarTostadores(); tostadoresRenderizados = true; }
        if (tab === 'ranking' && !rankingIniciado) {
          initMapaRanking();
          window.cofiActualizarRankingCiudades();
          window.cofiFiltrarRanking();
          rankingIniciado = true;
        } else if (tab === 'ranking' && mapaRanking) {
          setTimeout(() => mapaRanking.invalidateSize(), 200);
        }
      };

      // ==========================================
      // MAPA GENERAL
      // ==========================================
      function initMapa() {
        mapaCofiteca = L.map('cofiteca-map', { minZoom: 4 }).setView(VISTA_ARGENTINA, 4);
        L.tileLayer(TILES, { attribution: 'Tiles &copy; Esri', maxZoom: 16 }).addTo(mapaCofiteca);
        markerCluster = L.markerClusterGroup({ maxClusterRadius: 40, disableClusteringAtZoom: 14, spiderfyOnMaxZoom: true, showCoverageOnHover: false, chunkedLoading: true }).addTo(mapaCofiteca);
        mapaCofiteca.on('zoomend moveend', actualizarEtiquetas);

        // Un marker por local, creado una sola vez. Filtrar = agregar/quitar del cluster.
        baseDatos.forEach(c => {
          const m = L.circleMarker([c.lat, c.lon], { radius: 6, color: '#f5f0e8', fillColor: '#1a0f0a', fillOpacity: 0.9, weight: 1.5 });
          m._nombre = c.nombre;
          m.bindPopup(() => popupHTML(baseDatos[c.id]));
          m.on('click', () => resaltarCard(c.id));
          markersPorId.set(c.id, m);
        });
      }

      function popupHTML(c) {
        const ig = c.instagram ? '<a href="' + esc(c.instagram) + '" target="_blank" rel="noopener noreferrer" class="popup-btn">Instagram</a>' : '';
        const enLista = idsEnLista.has(c.id) ? '<a href="#" class="popup-link" onclick="cofiVerEnLista(' + c.id + '); return false;">Ver en la lista ↓</a>' : '';
        return '<div class="popup-cafe"><b>' + esc(c.nombre) + '</b><br><small>' + esc(c.ubicacion) + '</small><div class="popup-acciones">' + ig + enLista + '</div></div>';
      }

      // Etiquetas con nombre: solo se crean desde zoom 15 y solo para lo que está en pantalla
      function actualizarEtiquetas() {
        if (!mapaCofiteca) return;
        if (mapaCofiteca.getZoom() < ZOOM_ETIQUETAS) {
          marcadoresConEtiqueta.forEach(m => { m.unbindTooltip(); m._tt = false; });
          marcadoresConEtiqueta = [];
          return;
        }
        const area = mapaCofiteca.getBounds().pad(0.2);
        markersActuales.forEach(m => {
          if (!m._tt && area.contains(m.getLatLng())) {
            m.bindTooltip(esc(m._nombre), { permanent: true, direction: 'top', className: 'cafe-label', offset: [0, -10] });
            m._tt = true;
            marcadoresConEtiqueta.push(m);
          }
        });
      }

      function dibujarMapa(lista, recentrar) {
        marcadoresConEtiqueta.forEach(m => { m.unbindTooltip(); m._tt = false; });
        marcadoresConEtiqueta = [];
        markerCluster.clearLayers();
        markersActuales = lista.map(c => markersPorId.get(c.id));
        markerCluster.addLayers(markersActuales);

        if (recentrar) {
          const ciu = $('select-ciudad').value, zon = $('select-zona').value;
          if (ciu === 'Todas' && zon === 'Todas') mapaCofiteca.setView(VISTA_ARGENTINA, 4);
          else if (lista.length) mapaCofiteca.fitBounds(L.latLngBounds(lista.map(c => [c.lat, c.lon])), { padding: [30, 30], maxZoom: 15 });
        }
        actualizarEtiquetas();
      }

      // ==========================================
      // LISTA
      // ==========================================
      function setLista(lista) {
        listaActual = lista;
        idsEnLista = new Set(lista.map(c => c.id));
        mostrados = PAGINA;
        idDestacado = null;
        renderizarLista();
      }

      function crearCard(c) {
        const div = document.createElement('div');
        div.className = 'cafe-card' + (c.id === idDestacado ? ' destacada' : '');
        div.dataset.id = c.id;
        const dist = c.dist !== undefined ? '<br><b>📍 ' + textoDistancia(c.dist) + '</b>' : '';
        const ig = c.instagram ? '<a href="' + esc(c.instagram) + '" target="_blank" rel="noopener noreferrer">Instagram</a>' : '';
        div.innerHTML =
          '<div><h3>' + esc(c.nombre) + '</h3><p>' + esc(c.ubicacion) + ' • <b>' + esc(c.ciudadReal || c.ciudad) + '</b>' + dist + '</p></div>' +
          '<div class="cafe-actions">' +
            '<button type="button" data-ver-mapa>Ver en mapa</button>' + ig +
            '<a href="' + urlComoLlegar(c) + '" target="_blank" rel="noopener noreferrer">Cómo llegar</a>' +
          '</div>';
        div.querySelector('[data-ver-mapa]').addEventListener('click', () => verEnMapa(c.id));
        return div;
      }

      function renderizarLista() {
        const cont = $('cofi-resultados');
        const frag = document.createDocumentFragment();

        if (!listaActual.length) {
          const p = document.createElement('p');
          p.className = 'msg-vacio';
          p.textContent = 'No encontramos locales con esos filtros.';
          frag.appendChild(p);
        } else {
          listaActual.slice(0, mostrados).forEach(c => frag.appendChild(crearCard(c)));
          if (listaActual.length > mostrados) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn-ver-mas';
            btn.textContent = 'Ver más (' + (listaActual.length - mostrados) + ' restantes)';
            btn.addEventListener('click', () => { mostrados += PAGINA; renderizarLista(); });
            frag.appendChild(btn);
          }
        }
        cont.replaceChildren(frag);
      }

      // Lista -> mapa
      function verEnMapa(id) {
        const c = baseDatos[id];
        const m = markersPorId.get(id);
        document.querySelector('#vista-mapa .map-wrapper').scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (markerCluster.hasLayer(m)) {
          markerCluster.zoomToShowLayer(m, () => m.openPopup());
        } else {
          mapaCofiteca.setView([c.lat, c.lon], 16);
          L.popup().setLatLng([c.lat, c.lon]).setContent(popupHTML(c)).openOn(mapaCofiteca);
        }
      }

      // Mapa -> lista
      function resaltarCard(id) {
        idDestacado = id;
        document.querySelectorAll('#cofi-resultados .cafe-card.destacada').forEach(el => el.classList.remove('destacada'));
        const el = document.querySelector('#cofi-resultados .cafe-card[data-id="' + id + '"]');
        if (el) el.classList.add('destacada');
      }

      window.cofiVerEnLista = function (id) {
        const idx = listaActual.findIndex(c => c.id === id);
        if (idx === -1) return;
        if (idx >= mostrados) { mostrados = idx + 1; renderizarLista(); }
        resaltarCard(id);
        const el = document.querySelector('#cofi-resultados .cafe-card[data-id="' + id + '"]');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      // ==========================================
      // FILTROS
      // ==========================================
      window.cofiActualizarZonas = function () {
        const ciu = $('select-ciudad').value;
        const base = ciu === 'Todas' ? baseDatos : baseDatos.filter(c => c.ciudad === ciu);
        const zonas = [...new Set(base.map(c => c.zona))].filter(z => z && z !== '-' && z !== 'Sin Zona').sort((a, b) => a.localeCompare(b, 'es'));
        $('select-zona').innerHTML = '<option value="Todas">Zona / Barrio</option>' + zonas.map(z => '<option value="' + esc(z) + '">' + esc(z) + '</option>').join('');
      };

      function filtrarDatos() {
        const ciu = $('select-ciudad').value;
        const zon = $('select-zona').value;
        const tokens = norm($('input-busqueda').value).trim().split(/\s+/).filter(Boolean);
        return baseDatos.filter(c =>
          (ciu === 'Todas' || c.ciudad === ciu) &&
          (zon === 'Todas' || c.zona === zon) &&
          tokens.every(t => c._q.includes(t))
        );
      }

      function limpiarOrigen() {
        if (markerOrigen) { mapaCofiteca.removeLayer(markerOrigen); markerOrigen = null; }
        origen = null;
        $('cofi-status').classList.add('hidden');
      }

      function aplicarFiltros(recentrar) {
        limpiarOrigen();
        const filtrados = filtrarDatos();
        setLista(filtrados);
        dibujarMapa(filtrados, recentrar);
      }

      // recentrar = true solo cuando cambia ciudad o zona (no al tipear)
      let debounceFiltro = null;
      window.cofiFiltrar = function (recentrar) {
        clearTimeout(debounceFiltro);
        debounceFiltro = setTimeout(() => aplicarFiltros(recentrar === true), 150);
      };

      window.cofiQuitarOrigen = function () { aplicarFiltros(true); };

      // ==========================================
      // RANKING
      // ==========================================
      function getRankingColor(rank) {
        if (!rank || isNaN(rank)) return '#34495e';
        if (rank <= 3) return '#D4AF37';
        if (rank <= 10) return '#E86A33';
        if (rank <= 20) return '#009FBD';
        if (rank <= 30) return '#8e44ad';
        if (rank <= 40) return '#27ae60';
        if (rank <= 50) return '#f39c12';
        if (rank <= 60) return '#d35400';
        if (rank <= 70) return '#c0392b';
        if (rank <= 80) return '#16a085';
        if (rank <= 90) return '#7f8c8d';
        return '#2c3e50';
      }

      function initMapaRanking() {
        mapaRanking = L.map('ranking-map', { minZoom: 2 }).setView(VISTA_ARGENTINA, 4);
        L.tileLayer(TILES, { attribution: 'Tiles &copy; Esri', maxZoom: 16 }).addTo(mapaRanking);
        markerClusterRanking = L.markerClusterGroup({ maxClusterRadius: 35, disableClusteringAtZoom: 12, spiderfyOnMaxZoom: true }).addTo(mapaRanking);
      }

      window.cofiActualizarRankingCiudades = function () {
        const tipo = $('select-ranking-tipo').value;
        const data = rankingDatos[tipo] || [];
        const lugares = [...new Set(data.map(c => c.lugar))].sort((a, b) => a.localeCompare(b, 'es'));
        const texto = tipo === 'arg' ? 'Todas las Ciudades' : 'Todos los Países';
        $('select-ranking-ciudad').innerHTML = '<option value="Todas">' + texto + '</option>' + lugares.map(c => '<option value="' + esc(c) + '">' + esc(c) + '</option>').join('');
      };

      window.cofiFiltrarRanking = function () {
        if (!markerClusterRanking) return;
        const tipo = $('select-ranking-tipo').value;
        const lugar = $('select-ranking-ciudad').value;
        const filtrados = (rankingDatos[tipo] || []).filter(c => lugar === 'Todas' || c.lugar === lugar);

        const markers = filtrados.map(c => {
          const color = getRankingColor(c.rank);
          const icon = L.divIcon({
            html: '<div style="background-color:' + color + '; color:white; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; font-weight:800; border:2px solid white; box-shadow:0 3px 6px rgba(0,0,0,0.3); font-size:13px; font-family:Inter,sans-serif;">' + esc(c.rank) + '</div>',
            className: 'custom-ranking-icon', iconSize: [28, 28], iconAnchor: [14, 14]
          });
          const ig = c.ig ? '<div class="popup-acciones"><a href="' + esc(c.ig) + '" target="_blank" rel="noopener noreferrer" class="popup-btn">Instagram</a></div>' : '';
          return L.marker([c.lat, c.lon], { icon }).bindPopup(
            '<div class="popup-cafe"><span class="rank-badge" style="background:' + color + ';">#' + esc(c.rank) + '</span><br><b>' + esc(c.nombre) + '</b><br><small>' + esc(c.ubicacion) + ' • ' + esc(c.lugar) + '</small>' + ig + '</div>'
          );
        });

        markerClusterRanking.clearLayers();
        markerClusterRanking.addLayers(markers);

        if (filtrados.length) {
          let zoom = 12;
          if (lugar === 'Todas') zoom = tipo === 'mun' ? 2 : 4;
          else if (tipo !== 'arg') zoom = 5;
          const lat = filtrados.reduce((s, c) => s + c.lat, 0) / filtrados.length;
          const lon = filtrados.reduce((s, c) => s + c.lon, 0) / filtrados.length;
          mapaRanking.setView([lat, lon], zoom);
        }

        const frag = document.createDocumentFragment();
        filtrados.forEach(c => {
          const color = getRankingColor(c.rank);
          const div = document.createElement('div');
          div.className = 'cafe-card';
          const ig = c.ig ? '<a href="' + esc(c.ig) + '" target="_blank" rel="noopener noreferrer">Instagram</a>' : '';
          div.innerHTML =
            '<div><h3><span class="rank-badge" style="background:' + color + ';">#' + esc(c.rank) + '</span> ' + esc(c.nombre) + '</h3><p>' + esc(c.ubicacion) + ' • <b>' + esc(c.lugar) + '</b></p></div>' +
            '<div class="cafe-actions">' + ig + '<a href="' + urlComoLlegar(c) + '" target="_blank" rel="noopener noreferrer">Cómo llegar</a></div>';
          frag.appendChild(div);
        });
        $('ranking-resultados').replaceChildren(frag);
      };

      // ==========================================
      // TOSTADORES
      // ==========================================
      window.cofiRenderizarTostadores = function () {
        const ciudad = $('select-ciudad-tostadores').value;
        const filtrados = tostadoresDatos.filter(t => ciudad === 'Todas' || t.ciudad === ciudad);
        const cont = $('lista-tostadores');

        if (!filtrados.length) {
          cont.innerHTML = '<p class="msg-vacio">No hay tostadores registrados en esta ciudad.</p>';
          return;
        }

        const frag = document.createDocumentFragment();
        filtrados.forEach(t => {
          const div = document.createElement('div');
          div.className = 'tostador-card';
          const img = t.foto || IMG_FALLBACK;
          let botones = '';
          if (t.ig) botones += '<a href="' + esc(t.ig) + '" target="_blank" rel="noopener noreferrer" class="btn-outline-mad" style="margin-bottom:8px; display:block;">Instagram</a>';
          if (t.tienda) botones += '<a href="' + esc(t.tienda) + '" target="_blank" rel="noopener noreferrer" class="btn-primary-mad" style="display:block;">Tienda Online</a>';
          div.innerHTML =
            '<img src="' + esc(img) + '" class="tostador-img" loading="lazy" decoding="async" alt="" onerror="this.onerror=null;this.src=\'' + IMG_FALLBACK + '\'">' +
            '<div class="tostador-content"><div>' +
              '<h3 style="margin:0 0 5px 0; font-family:Georgia,serif; font-size:1.2rem; color:#1a0f0a;">' + esc(t.nombre) + '</h3>' +
              '<p style="margin:0 0 15px 0; font-size:0.85rem; color:#5c3d2e;">📍 ' + esc(t.ciudad) + '</p>' +
            '</div><div>' + botones + '</div></div>';
          frag.appendChild(div);
        });
        cont.replaceChildren(frag);
      };

      // ==========================================
      // UBICACIÓN (GPS / DIRECCIÓN)
      // ==========================================
      function cofiProcesarOrigen(lat, lon, label) {
        // Al buscar por cercanía se limpian los filtros: lista y mapa muestran lo mismo
        $('select-ciudad').value = 'Todas';
        window.cofiActualizarZonas();
        $('input-busqueda').value = '';
        limpiarOrigen();

        origen = { lat, lon, label };
        markerOrigen = L.circleMarker([lat, lon], { radius: 8, color: '#1a0f0a', fillColor: '#fff', weight: 3, fillOpacity: 1 })
          .addTo(mapaCofiteca).bindPopup(esc(label)).openPopup();

        const cercanos = baseDatos
          .map(c => ({ ...c, dist: calcularD(lat, lon, c.lat, c.lon) }))
          .sort((a, b) => a.dist - b.dist)
          .slice(0, 40);

        setLista(cercanos);
        dibujarMapa(baseDatos, false);
        mapaCofiteca.setView([lat, lon], 15);

        const st = $('cofi-status');
        st.innerHTML = '📍 Mostrando los locales más cercanos a <b>' + esc(label) + '</b><a onclick="cofiQuitarOrigen()">Quitar</a>';
        st.classList.remove('hidden');
      }

      window.cofiUsarMiGPS = function () {
        if (!navigator.geolocation) return Swal.fire('Error', 'Tu navegador no soporta GPS.', 'error');
        navigator.geolocation.getCurrentPosition(
          p => cofiProcesarOrigen(p.coords.latitude, p.coords.longitude, 'tu ubicación'),
          () => Swal.fire('Aviso', 'No pudimos obtener tu ubicación. Revisá los permisos.', 'warning'),
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
        );
      };

      window.cofiMedirDesdeDireccion = function () {
        Swal.fire({
          title: '¿Dónde estás?',
          html: '<p style="font-size:0.9rem; color:#5c3d2e; margin-bottom:15px;">Escribí tu calle y ciudad (Ej: Güemes, Mar del Plata)</p>' +
                '<input id="swal-autocomplete-input" class="input-moderno" placeholder="Escribir..." autocomplete="off" style="width:100%; box-sizing:border-box;">' +
                '<div id="autocomplete-results" style="text-align:left; margin-top:10px; max-height:200px; overflow-y:auto;"></div>',
          showConfirmButton: false, showCancelButton: true, cancelButtonText: 'Cerrar',
          customClass: { popup: 'swal-custom-popup', cancelButton: 'swal-custom-btn-cancel' },
          didOpen: () => {
            const input = $('swal-autocomplete-input');
            const resultsContainer = $('autocomplete-results');
            let timeout = null, solicitudId = 0;
            input.focus();
            input.addEventListener('input', () => {
              clearTimeout(timeout);
              const val = input.value.trim();
              if (val.length < 4) { resultsContainer.innerHTML = ''; return; }
              resultsContainer.innerHTML = '<div style="padding:10px; color:#1a0f0a; font-weight:bold; text-align:center;">Buscando...</div>';
              timeout = setTimeout(async () => {
                const miId = ++solicitudId;
                try {
                  const res = await fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(val) + '&countrycodes=ar&addressdetails=1&limit=6');
                  const data = await res.json();
                  if (miId !== solicitudId) return;
                  resultsContainer.innerHTML = '';
                  if (!data.length) { resultsContainer.innerHTML = '<div style="padding:10px; opacity:0.7; text-align:center;">No encontramos la dirección.</div>'; return; }
                  data.forEach(item => {
                    const partes = [];
                    if (item.address.road) partes.push(item.address.road + (item.address.house_number ? ' ' + item.address.house_number : ''));
                    const localidad = item.address.city || item.address.town || item.address.village;
                    if (localidad) partes.push(localidad);
                    const nombreStr = partes.length ? partes.join(', ') : item.display_name.split(',').slice(0, 3).join(', ');
                    const btn = document.createElement('button');
                    btn.style.cssText = 'width:100%; text-align:left; background:rgba(255,255,255,0.7); color:#1a0f0a; border:1px solid rgba(196,167,125,0.5); padding:12px; border-radius:6px; cursor:pointer; margin-bottom:8px; font-family:Inter,sans-serif; font-size:0.9rem; transition:0.2s;';
                    btn.innerHTML = '📍 <b>' + esc(nombreStr) + '</b>';
                    btn.onmouseover = () => { btn.style.borderColor = '#1a0f0a'; };
                    btn.onmouseout = () => { btn.style.borderColor = 'rgba(196,167,125,0.5)'; };
                    btn.onclick = () => { Swal.close(); cofiProcesarOrigen(parseFloat(item.lat), parseFloat(item.lon), nombreStr); };
                    resultsContainer.appendChild(btn);
                  });
                } catch (e) {
                  if (miId !== solicitudId) return;
                  resultsContainer.innerHTML = '<div style="padding:10px; color:red; text-align:center;">Error con el mapa.</div>';
                }
              }, 800);
            });
          }
        });
      };

      // ==========================================
      // REPORTES / ALTAS (sin cambios)
      // ==========================================
      window.cofiAbrirReporte = async function () {
        const { value: formValues } = await Swal.fire({
          title: 'Soporte',
          customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
          html: '<div style="text-align:left;">' +
                '<select id="swal-tipo" class="swal-custom-input" style="margin-bottom:10px;"><option value="Dato Incorrecto">Corrección de datos</option><option value="Local Cerrado">Local cerrado</option></select>' +
                '<input id="swal-local" class="swal-custom-input" placeholder="Nombre del local o tu teléfono" style="margin-bottom:10px;">' +
                '<textarea id="swal-detalle" class="swal-custom-input" placeholder="Detalle de la solicitud..." style="height:80px; resize:none;"></textarea></div>',
          showCancelButton: true, confirmButtonText: 'Enviar', cancelButtonText: 'Cancelar',
          preConfirm: () => {
            const local = $('swal-local').value.trim();
            if (!local) { Swal.showValidationMessage('Ingresá una referencia válida'); return false; }
            return { tipo: $('swal-tipo').value, local, detalle: $('swal-detalle').value.trim() };
          }
        });
        if (formValues) window.cofiEnviarReporteEmail(formValues);
      };

      window.cofiAbrirSumate = async function () {
        const { value: formValues } = await Swal.fire({
          title: 'Añadir Local',
          customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
          html: '<div style="text-align:left;">' +
                '<select id="sumate-tipo" class="swal-custom-input" style="margin-bottom:10px;"><option value="Cafetería / Tostaduría">Cafetería / Tostaduría</option></select>' +
                '<input id="sumate-nombre" class="swal-custom-input" placeholder="Nombre comercial" style="margin-bottom:10px;">' +
                '<input id="sumate-link" class="swal-custom-input" placeholder="Link a Instagram o Web" style="margin-bottom:10px;"></div>',
          showCancelButton: true, confirmButtonText: 'Enviar Solicitud', cancelButtonText: 'Cancelar',
          preConfirm: () => {
            const nombre = $('sumate-nombre').value.trim();
            if (!nombre) { Swal.showValidationMessage('Ingresá el nombre comercial'); return false; }
            return { tipo: 'ALTA NUEVA: ' + $('sumate-tipo').value, local: nombre, detalle: 'Link/IG: ' + $('sumate-link').value.trim() };
          }
        });
        if (formValues) window.cofiEnviarReporteEmail(formValues);
      };

      window.cofiEnviarReporteEmail = async function (datosForm) {
        try {
          await fetch('/api/reporte?t=' + Date.now(), {
            method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(datosForm)
          });
          Swal.fire({ title: 'Enviado', text: 'Tu solicitud fue recibida.', icon: 'success', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
        } catch (error) {
          Swal.fire({ title: 'Error', text: 'Problemas de conexión con el servidor.', icon: 'error', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
        }
      };

      // ==========================================
      // ARRANQUE
      // ==========================================
      const ciudades = [...new Set(baseDatos.map(c => c.ciudad))].sort((a, b) => a.localeCompare(b, 'es'));
      $('select-ciudad').innerHTML = '<option value="Todas">Región / Ciudad</option>' + ciudades.map(c => '<option value="' + esc(c) + '">' + esc(c) + '</option>').join('');

      const ciudadesTost = [...new Set(tostadoresDatos.map(t => t.ciudad))].sort((a, b) => a.localeCompare(b, 'es'));
      $('select-ciudad-tostadores').innerHTML = '<option value="Todas">Todas las Ciudades</option>' + ciudadesTost.map(c => '<option value="' + esc(c) + '">' + esc(c) + '</option>').join('');

      window.cofiActualizarZonas();
      window.cofiActualizarMetricas();
      initMapa();
      aplicarFiltros(false);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { iniciarBuscadorSeguro(); });
    } else {
      iniciarBuscadorSeguro();
    }
    // Navegación con View Transitions de Astro (la guarda interna evita inicializar dos veces)
    document.addEventListener('astro:page-load', function () { iniciarBuscadorSeguro(); });
  </script>
</body>
</html>
