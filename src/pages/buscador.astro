---
// src/pages/buscador.astro
import {
  cafesCompact, regiones, zonasDict, ciudadesRealesDict,
  tostadores, ranking, meta
} from '../lib/cafes';

const datosJSON = JSON.stringify({
  cafes: cafesCompact,
  regiones, zonas: zonasDict, ciudadesReales: ciudadesRealesDict,
  tostadores, ranking, meta
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mapa Cofiteca | Cafeterías de especialidad de Argentina</title>
  <meta name="description" content="Mapa y buscador de cafeterías de especialidad y tostadores de Argentina. Encontrá cafés por ciudad, zona o cerca tuyo." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://server.arcgisonline.com" crossorigin>
  <link rel="dns-prefetch" href="https://nominatim.openstreetmap.org">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  <script is:inline defer src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <!-- SweetAlert2 NO se carga acá: se inyecta on-demand en el primer modal -->

  <style is:global>
    :root {
      --coffee-900: #1a0f0a;
      --coffee-700: #3d2317;
      --coffee-500: #5c3d2e;
      --tan-500: #c4a77d;
      --tan-300: #dfc9a8;
      --cream-100: #f5f0e8;
      --cream-50: #faf7f2;
      --accent: #e86a33;
      --accent-hover: #c85520;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
      --shadow-sm: 0 1px 3px rgba(26,15,10,.06);
      --shadow-md: 0 4px 15px rgba(26,15,10,.08);
      --shadow-lg: 0 15px 40px rgba(26,15,10,.10);
      --font-display: 'Fraunces', Georgia, serif;
      --font-body: 'Inter', system-ui, sans-serif;
      --transition: 0.2s cubic-bezier(.4,0,.2,1);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: var(--cream-100); color: var(--coffee-900); font-family: var(--font-body); }

    /* NAV */
    .nav-bar { padding: 1.2rem 2rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(196,167,125,.3); background: rgba(245,240,232,.85); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 1000; flex-wrap: wrap; }
    .btn-back { display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; color: var(--coffee-900); font-weight: 600; font-size: .9rem; text-transform: uppercase; letter-spacing: .05em; transition: var(--transition); }
    .btn-back:hover { color: var(--accent); transform: translateX(-4px); }
    .nav-actions { display: flex; gap: 1.2rem; flex-wrap: wrap; }
    .nav-action-link { font-size: .8rem; font-weight: 600; color: var(--coffee-500); text-decoration: none; cursor: pointer; transition: var(--transition); text-transform: uppercase; letter-spacing: .05em; }
    .nav-action-link:hover { color: var(--coffee-900); }

    /* LAYOUT */
    .data-real-container { margin: 2rem auto 4rem; max-width: 1200px; padding: 0 1.5rem; display: grid; grid-template-columns: 280px 1fr; gap: 1.5rem; align-items: start; }
    @media (max-width: 1024px) { .data-real-container { grid-template-columns: 1fr; gap: 1rem; } }

    /* MÉTRICAS */
    .metrics-sidebar { padding: 2rem 1.8rem; display: flex; flex-direction: column; gap: 1.6rem; position: sticky; top: 100px; background: rgba(255,255,255,.8); backdrop-filter: blur(10px); border-radius: var(--radius-md); border: 1px solid rgba(196,167,125,.3); box-shadow: var(--shadow-md); }
    @media (max-width: 1024px) { .metrics-sidebar { display: grid; grid-template-columns: repeat(4,1fr); padding: 1.2rem; gap: 1rem; position: static; } }
    @media (max-width: 768px) { .metrics-sidebar { grid-template-columns: repeat(2,1fr); } }
    .metric-item { text-align: left; border-left: 3px solid var(--tan-500); padding-left: 1rem; }
    @media (max-width: 1024px) { .metric-item { text-align: center; border-left: none; border-top: 3px solid var(--tan-500); padding-left: 0; padding-top: .8rem; } }
    .metric-number { font-size: 2.7rem; font-weight: 800; color: var(--coffee-900); line-height: 1; display: block; letter-spacing: -.03em; font-family: var(--font-display); }
    @media (max-width: 1024px) { .metric-number { font-size: 2.2rem; } }
    .metric-label { display: block; font-size: .72rem; color: var(--coffee-500); text-transform: uppercase; letter-spacing: .1em; margin-top: .4rem; font-weight: 700; }

    /* PANEL PRINCIPAL */
    .buscador-main-panel { background: rgba(255,255,255,.8); backdrop-filter: blur(10px); border-radius: var(--radius-md); border: 1px solid rgba(196,167,125,.3); box-shadow: var(--shadow-lg); overflow: hidden; }
    .data-header { padding: 2rem 2rem 1.2rem; border-bottom: 1px solid rgba(196,167,125,.2); }
    @media (max-width: 768px) { .data-header { padding: 1.5rem; text-align: center; } }
    .data-header h1 { font-size: 2rem; font-weight: 800; margin: 0; color: var(--coffee-900); font-family: var(--font-display); font-variation-settings: 'opsz' 100; letter-spacing: -.02em; }

    .view-tabs { display: flex; gap: 8px; margin-top: 1.2rem; flex-wrap: wrap; }
    @media (max-width: 768px) { .view-tabs { justify-content: center; } }
    .view-tab-btn { background: transparent; border: 1px solid rgba(196,167,125,.4); color: var(--coffee-500); font-size: .8rem; font-weight: 600; cursor: pointer; padding: 8px 14px; border-radius: var(--radius-sm); transition: var(--transition); font-family: var(--font-body); text-transform: uppercase; letter-spacing: .05em; }
    .view-tab-btn:hover { background: rgba(196,167,125,.1); color: var(--coffee-900); border-color: var(--tan-500); }
    .view-tab-btn.active { background: var(--coffee-900); color: white; border-color: var(--coffee-900); box-shadow: 0 4px 10px rgba(26,15,10,.2); }

    .buscador-ui { padding: 1.5rem 2rem 2rem; }
    @media (max-width: 768px) { .buscador-ui { padding: 1rem 1.2rem 1.5rem; } }

    /* RECIENTES */
    .recientes-wrap { margin-bottom: 1.2rem; }
    .recientes-label { font-size: .7rem; font-weight: 700; color: var(--coffee-500); text-transform: uppercase; letter-spacing: .1em; margin-bottom: .5rem; }
    .recientes-list { display: flex; gap: .6rem; overflow-x: auto; padding-bottom: .4rem; -webkit-overflow-scrolling: touch; }
    .reciente-chip { flex-shrink: 0; display: inline-flex; align-items: center; gap: .4rem; padding: 8px 14px; border: 1px solid rgba(196,167,125,.4); border-radius: 999px; background: var(--cream-50); font-size: .8rem; font-weight: 600; color: var(--coffee-700); cursor: pointer; transition: var(--transition); white-space: nowrap; }
    .reciente-chip:hover { border-color: var(--accent); color: var(--accent); background: white; }

    /* CONTROLES */
    .search-controls { display: grid; grid-template-columns: 1fr 1fr 2fr auto; gap: .8rem; margin-bottom: 1rem; }
    .search-controls.cols-2 { grid-template-columns: 1fr 1fr; }
    .search-controls.cols-1 { grid-template-columns: 1fr; margin-bottom: 2rem; }
    @media (max-width: 900px) { .search-controls:not(.cols-2):not(.cols-1) { grid-template-columns: 1fr 1fr; } .search-controls:not(.cols-2):not(.cols-1) input { grid-column: 1 / -1; } }
    @media (max-width: 576px) { .search-controls, .search-controls.cols-2 { grid-template-columns: 1fr; } }

    .input-moderno { width: 100%; padding: 11px 14px; border: 1px solid rgba(196,167,125,.5); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: .9rem; background: white; color: var(--coffee-900); outline: none; transition: var(--transition); }
    .input-moderno:focus { border-color: var(--coffee-900); box-shadow: 0 0 0 3px rgba(26,15,10,.08); }

    .search-buttons { display: flex; gap: .6rem; margin-bottom: 1rem; flex-wrap: wrap; }
    @media (max-width: 576px) { .search-buttons { flex-direction: column; } }
    .btn-outline-mad, .btn-primary-mad { flex: 1 1 auto; min-width: 0; padding: 10px 16px; border-radius: var(--radius-sm); font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: var(--transition); font-size: .85rem; text-align: center; text-decoration: none; }
    .btn-outline-mad { background: transparent; color: var(--coffee-900); border: 1px solid var(--coffee-900); }
    .btn-outline-mad:hover { background: rgba(26,15,10,.05); }
    .btn-primary-mad { background: var(--coffee-900); color: white; border: 1px solid var(--coffee-900); box-shadow: 0 4px 10px rgba(26,15,10,.15); }
    .btn-primary-mad:hover { background: var(--coffee-700); border-color: var(--coffee-700); }

    .filter-row { display: flex; gap: .5rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center; font-size: .8rem; }
    .filter-pill { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(196,167,125,.5); background: transparent; font-size: .8rem; font-weight: 600; color: var(--coffee-500); cursor: pointer; transition: var(--transition); font-family: var(--font-body); }
    .filter-pill:hover { border-color: var(--coffee-900); color: var(--coffee-900); }
    .filter-pill.active { background: var(--coffee-900); color: white; border-color: var(--coffee-900); }

    .cofi-status { margin: 0 0 1rem; padding: 10px 14px; background: rgba(196,167,125,.15); border-radius: var(--radius-sm); font-size: .85rem; color: var(--coffee-500); }
    .cofi-status a { color: var(--coffee-900); font-weight: 700; margin-left: 8px; cursor: pointer; text-decoration: underline; }

    .quick-chips { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
    .quick-chip { padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(196,167,125,.5); background: var(--cream-50); font-size: .8rem; font-weight: 600; color: var(--coffee-700); cursor: pointer; transition: var(--transition); font-family: var(--font-body); }
    .quick-chip:hover { border-color: var(--accent); color: var(--accent); background: white; }

    .results-count { font-size: .8rem; color: var(--coffee-500); margin: 0 0 .8rem; font-weight: 500; }

    /* MAPA */
    .map-wrapper { width: 100%; height: 500px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid rgba(196,167,125,.4); margin-bottom: 1.5rem; position: relative; z-index: 1; }
    @media (max-width: 768px) { .map-wrapper { height: 380px; } }
    #cofiteca-map, #ranking-map { width: 100%; height: 100%; background: #e6e2db; }
    .cafe-label { background: transparent; border: none; box-shadow: none; color: var(--coffee-900); font-weight: 800; font-size: .72rem; text-shadow: 2px 2px 0 white, -2px -2px 0 white, 2px -2px 0 white, -2px 2px 0 white; pointer-events: none; text-transform: uppercase; letter-spacing: .05em; }
    .custom-ranking-icon { background: none; border: none; }
    .cofi-halo { animation: cofiPulso 1.4s ease-in-out infinite; }
    @keyframes cofiPulso { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }

    .popup-cafe { text-align: center; font-family: var(--font-body); }
    .popup-cafe b { display: block; margin-bottom: .2rem; }
    .popup-acciones { display: flex; flex-direction: column; gap: 6px; align-items: center; margin-top: 8px; }
    .popup-btn { display: inline-block; background: var(--coffee-900); color: white !important; padding: 5px 12px; border-radius: 5px; font-size: .78rem; text-decoration: none; }
    .popup-link { font-size: .78rem; color: var(--coffee-500); font-weight: 600; text-decoration: underline; }

    /* CARDS */
    .resultados-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
    .cafe-card { position: relative; background: var(--cream-50); padding: 1.2rem 1.3rem; border-radius: var(--radius-md); border: 1px solid rgba(196,167,125,.25); box-shadow: var(--shadow-sm); transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition); display: flex; flex-direction: column; justify-content: space-between; gap: 10px; }
    .cafe-card:hover { transform: translateY(-3px); border-color: var(--tan-500); box-shadow: var(--shadow-md); }
    .cafe-card.destacada { border-color: var(--coffee-900); box-shadow: 0 0 0 3px rgba(196,167,125,.6); }
    .cafe-card h3 { margin: 0 0 6px; font-size: 1.1rem; color: var(--coffee-900); font-family: var(--font-display); font-weight: 800; font-variation-settings: 'opsz' 40; line-height: 1.25; padding-right: 28px; }
    .cafe-card h3 a { color: inherit; text-decoration: none; }
    .cafe-card h3 a:hover { color: var(--accent); }
    .cafe-card p { margin: 0; font-size: .82rem; color: var(--coffee-500); line-height: 1.5; }
    .cafe-card .card-badge { display: inline-block; background: var(--accent); color: white; font-size: .65rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; padding: 2px 6px; border-radius: 3px; margin-left: 6px; vertical-align: middle; }

    .fav-btn { position: absolute; top: 12px; right: 12px; background: transparent; border: none; font-size: 1.3rem; cursor: pointer; padding: 2px 4px; border-radius: 4px; line-height: 1; color: var(--tan-500); transition: var(--transition); }
    .fav-btn:hover { transform: scale(1.15); color: var(--accent); }
    .fav-btn.is-fav { color: var(--accent); }

    .cafe-actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .cafe-actions a, .cafe-actions button { flex: 1 1 auto; text-align: center; padding: 8px 10px; background: transparent; border-radius: var(--radius-sm); font-family: var(--font-body); font-weight: 600; font-size: .72rem; color: var(--coffee-900); border: 1px solid var(--coffee-900); text-transform: uppercase; letter-spacing: .05em; text-decoration: none; cursor: pointer; transition: var(--transition); }
    .cafe-actions a:hover, .cafe-actions button:hover { background: var(--coffee-900); color: white; }

    .btn-ver-mas { grid-column: 1 / -1; justify-self: center; background: var(--coffee-900); color: white; border: none; padding: 12px 28px; border-radius: var(--radius-sm); font-family: var(--font-body); font-weight: 600; font-size: .9rem; cursor: pointer; transition: var(--transition); }
    .btn-ver-mas:hover { background: var(--coffee-700); }

    .msg-vacio { grid-column: 1 / -1; text-align: center; padding: 3rem 1rem; }
    .msg-vacio .emoji { font-size: 2.5rem; margin-bottom: .6rem; display: block; }
    .msg-vacio h3 { font-family: var(--font-display); font-size: 1.2rem; color: var(--coffee-900); margin: 0 0 .4rem; }
    .msg-vacio p { font-size: .85rem; color: var(--coffee-500); margin: 0 0 1rem; }
    .msg-vacio button { padding: 10px 20px; border-radius: var(--radius-sm); border: 1px solid var(--coffee-900); background: transparent; font-family: var(--font-body); font-weight: 600; font-size: .85rem; cursor: pointer; color: var(--coffee-900); }
    .msg-vacio button:hover { background: var(--coffee-900); color: white; }

    /* SKELETON */
    .skeleton-card { height: 130px; background: linear-gradient(90deg, #ece4d6 25%, #f5f0e8 37%, #ece4d6 63%); background-size: 400% 100%; animation: skeleton 1.4s ease infinite; border-radius: var(--radius-md); }
    @keyframes skeleton { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

    .rank-badge { color: white; font-weight: 700; border-radius: 3px; padding: 2px 6px; font-size: .72rem; font-family: var(--font-body); }

    /* TOSTADORES */
    .tostadores-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; }
    .tostador-card { background: var(--cream-50); border: 1px solid rgba(196,167,125,.3); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; transition: var(--transition); }
    .tostador-card:hover { transform: translateY(-3px); border-color: var(--coffee-900); }
    .tostador-img { width: 100%; height: 200px; object-fit: cover; background: var(--cream-100); display: block; }
    .tostador-content { padding: 1.2rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; gap: .8rem; }
    .tostador-content h3 { margin: 0 0 4px; font-family: var(--font-display); font-size: 1.15rem; color: var(--coffee-900); }
    .tostador-content p { margin: 0; font-size: .82rem; color: var(--coffee-500); }

    .hidden { display: none !important; }

    /* SWAL */
    .swal2-popup.swal-custom-popup { border-radius: var(--radius-md) !important; padding: 2rem !important; border: 1px solid rgba(196,167,125,.5) !important; font-family: var(--font-body) !important; background: white !important; }
    .swal-custom-input { width: 100% !important; padding: 11px 14px !important; border: 1px solid rgba(196,167,125,.5) !important; border-radius: var(--radius-sm) !important; font-family: var(--font-body) !important; font-size: .9rem !important; box-sizing: border-box !important; background: var(--cream-100) !important; color: var(--coffee-900) !important; margin: 0 !important; }
    .swal-custom-input:focus { border-color: var(--coffee-900) !important; outline: none !important; box-shadow: 0 0 0 3px rgba(26,15,10,.1) !important; }
    .swal2-styled.swal-custom-btn-confirm { background-color: var(--coffee-900) !important; border-radius: var(--radius-sm) !important; font-weight: 600 !important; font-family: var(--font-body) !important; }
    .swal2-styled.swal-custom-btn-cancel { background-color: transparent !important; border: 1px solid var(--coffee-900) !important; color: var(--coffee-900) !important; border-radius: var(--radius-sm) !important; font-weight: 600 !important; font-family: var(--font-body) !important; }
  </style>
</head>
<body>

  <nav class="nav-bar">
    <a href="/" class="btn-back">← Volver</a>
    <div class="nav-actions">
      <a onclick="cofiSorprendeme()" class="nav-action-link">🎲 Sorprendeme</a>
      <a onclick="cofiAbrirSumate()" class="nav-action-link">Añadir Local</a>
      <a onclick="cofiAbrirReporte()" class="nav-action-link">Soporte</a>
    </div>
  </nav>

  <div class="data-real-container">
    <div class="metrics-sidebar">
      <div class="metric-item" id="caja-cafes"><span class="metric-number" id="stat-cafes">{meta.cafes}</span><span class="metric-label" id="label-cafes">Locales</span></div>
      <div class="metric-item" id="caja-tostadores"><span class="metric-number" id="stat-tostadores">{meta.tostadores}</span><span class="metric-label">Tostadores</span></div>
      <div class="metric-item" id="caja-provincias"><span class="metric-number" id="stat-provincias">{meta.provincias}</span><span class="metric-label" id="label-provincias">Provincias</span></div>
      <div class="metric-item" id="caja-ciudades"><span class="metric-number" id="stat-ciudades">{meta.ciudades}</span><span class="metric-label">Ciudades</span></div>
    </div>

    <div class="buscador-main-panel">
      <div class="data-header">
        <h1>Mapa Cofiteca</h1>
        <div class="view-tabs">
          <button class="view-tab-btn active" onclick="cofiSwitchTab('mapa')" id="btn-tab-mapa">Mapa</button>
          <button class="view-tab-btn" onclick="cofiSwitchTab('ranking')" id="btn-tab-ranking">Rankings</button>
          <button class="view-tab-btn" onclick="cofiSwitchTab('tostadores')" id="btn-tab-tostadores">Tostadores</button>
        </div>
      </div>

      <!-- VISTA 1: MAPA -->
      <div class="buscador-ui" id="vista-mapa">
        <div class="quick-chips" id="quick-chips"></div>
        <div class="recientes-wrap hidden" id="recientes-wrap">
          <div class="recientes-label">Volvé a donde estabas</div>
          <div class="recientes-list" id="recientes-list"></div>
        </div>
        <div class="search-controls">
          <select id="select-ciudad" class="input-moderno" onchange="cofiActualizarZonas(); cofiFiltrar(true)"><option value="Todas">Región / Ciudad</option></select>
          <select id="select-zona" class="input-moderno" onchange="cofiFiltrar(true)"><option value="Todas">Zona / Barrio</option></select>
          <input type="text" id="input-busqueda" class="input-moderno" placeholder="Buscar por nombre, zona o dirección..." oninput="cofiFiltrar(false)">
          <select id="select-orden" class="input-moderno" onchange="cofiCambiarOrden(this.value)" title="Ordenar">
            <option value="nombre">A-Z</option>
            <option value="ranking">Ranking</option>
            <option value="distancia" id="opt-distancia" disabled>Distancia</option>
          </select>
        </div>
        <div class="search-buttons">
          <button class="btn-outline-mad" onclick="cofiMedirDesdeDireccion()">📍 Buscar por Dirección</button>
          <button class="btn-primary-mad" onclick="cofiUsarMiGPS()">🎯 Cerca de mí</button>
        </div>
        <div class="filter-row">
          <button class="filter-pill" id="pill-favs" onclick="cofiToggleSoloFavs()">★ Sólo favoritos</button>
          <span id="fav-count" style="color:var(--coffee-500);font-size:.75rem;"></span>
        </div>
        <p id="cofi-status" class="cofi-status hidden"></p>
        <div class="map-wrapper"><div id="cofiteca-map"></div></div>
        <p id="cofi-count" class="results-count"></p>
        <div id="cofi-resultados" class="resultados-grid">
          <div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card"></div>
          <div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card"></div>
        </div>
      </div>

      <!-- VISTA 2: RANKING -->
      <div class="buscador-ui hidden" id="vista-ranking">
        <div class="search-controls cols-2">
          <select id="select-ranking-tipo" class="input-moderno" onchange="cofiActualizarRankingCiudades(); cofiFiltrarRanking(); cofiActualizarMetricas();">
            <option value="arg">Top 100 Argentina</option>
            <option value="sud">Top 100 Sudamérica</option>
            <option value="mun">Top 100 Mundial</option>
          </select>
          <select id="select-ranking-ciudad" class="input-moderno" onchange="cofiFiltrarRanking()"><option value="Todas">Todas las Ciudades</option></select>
        </div>
        <div class="map-wrapper"><div id="ranking-map"></div></div>
        <div id="ranking-resultados" class="resultados-grid"></div>
      </div>

      <!-- VISTA 3: TOSTADORES -->
      <div class="buscador-ui hidden" id="vista-tostadores">
        <div class="search-controls cols-1">
          <select id="select-ciudad-tostadores" class="input-moderno" onchange="cofiRenderizarTostadores()"><option value="Todas">Todas las Ciudades</option></select>
        </div>
        <div id="lista-tostadores" class="tostadores-grid"></div>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="cofi-data" set:html={datosJSON}></script>

  <script is:inline>
    function iniciarBuscadorSeguro(intento) {
      intento = intento || 0;
      if (typeof L === 'undefined' || typeof L.markerClusterGroup === 'undefined') {
        if (intento < 200) setTimeout(function () { iniciarBuscadorSeguro(intento + 1); }, 50);
        return;
      }
      const mapEl = document.getElementById('cofiteca-map');
      const dataEl = document.getElementById('cofi-data');
      if (!mapEl || !dataEl || mapEl._cofiInit) return;
      mapEl._cofiInit = true;

      const $ = id => document.getElementById(id);
      const norm = s => (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const esc = s => String(s ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));

      // ==========================================
      // DATOS (expandir compacto → formato legible)
      // ==========================================
      const datos = JSON.parse(dataEl.textContent);
      const baseDatos = datos.cafes.map(c => ({
        id: c.id,
        nombre: c.n,
        ubicacion: c.u,
        instagram: c.s,
        lat: c.a,
        lon: c.o,
        ciudad: datos.regiones[c.r],
        zona: c.z >= 0 ? datos.zonas[c.z] : '',
        ciudadReal: c.c >= 0 ? datos.ciudadesReales[c.c] : '',
        slug: c.slug
      }));
      baseDatos.forEach(c => { c._q = norm([c.nombre, c.ubicacion, c.zona, c.ciudadReal, c.ciudad].join(' ')); });

      const tostadoresDatos = datos.tostadores;
      const rankingDatos = datos.ranking;
      const meta = datos.meta;

      // Mapa nombre→mejor rank para el orden "Ranking"
      const rankMap = new Map();
      (function () {
        const nombres = new Map();
        ['arg', 'sud', 'mun'].forEach(tipo => {
          (rankingDatos[tipo] || []).forEach(it => {
            const k = norm(it.nombre);
            const cur = nombres.get(k);
            if (!cur || it.rank < cur) nombres.set(k, it.rank);
          });
        });
        baseDatos.forEach(c => {
          const r = nombres.get(norm(c.nombre));
          if (r) rankMap.set(c.id, r);
        });
      })();

      // Favoritos
      const FAV_KEY = 'cofi-favs';
      let favoritos = new Set();
      try { favoritos = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || '[]')); } catch {}
      const RECIENTES_KEY = 'cofi-recientes';
      let recientes = [];
      try { recientes = JSON.parse(localStorage.getItem(RECIENTES_KEY) || '[]'); } catch {}

      const PAGINA = 24;
      const ZOOM_ETIQUETAS = 15;
      const ESTILO_BASE = { radius: 6, color: '#faf7f2', fillColor: '#3d2317', fillOpacity: .92, weight: 2 };
      const ESTILO_ACTIVO = { radius: 10, color: '#ffffff', fillColor: '#e86a33', fillOpacity: 1, weight: 3 };
      const VISTA_ARGENTINA = [-38.41, -63.61];
      const IMG_FALLBACK = 'https://images.unsplash.com/photo-1559525839-b184a4d698c7?w=600';
      const TILES = 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}';

      let mapaCofiteca = null, markerCluster = null;
      let mapaRanking = null, markerClusterRanking = null;
      let tostadoresRenderizados = false, rankingIniciado = false;

      const markersPorId = new Map();
      let idsEnMapa = new Set();
      let marcadoresActuales = [];
      let marcadoresConEtiqueta = [];

      let origen = null, markerOrigen = null;
      let markerActivoId = null, haloActivo = null;
      let listaActual = [], idsEnLista = new Set(), mostrados = PAGINA, idDestacado = null;
      let soloFavoritos = false, ordenActual = 'nombre';

      // SWAL lazy
      let swalPromise = null;
      function ensureSwal() {
        if (window.Swal) return Promise.resolve();
        if (swalPromise) return swalPromise;
        swalPromise = new Promise((res, rej) => {
          const s = document.createElement('script');
          s.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
          s.onload = res; s.onerror = rej;
          document.head.appendChild(s);
        });
        return swalPromise;
      }

      function calcularD(lat1, lon1, lat2, lon2) {
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
        return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }
      function textoDistancia(dist) {
        const cuadras = Math.round(dist * 10);
        if (cuadras === 0) return '¡A menos de 1 cuadra!';
        if (cuadras <= 30) return 'A ' + cuadras + ' cuadra' + (cuadras !== 1 ? 's' : '');
        return 'A ' + dist.toFixed(1).replace('.', ',') + ' km';
      }
      const urlComoLlegar = c => 'https://www.google.com/maps/search/?api=1&query=' + c.lat + ',' + c.lon;

      // ==========================================
      // FAVORITOS
      // ==========================================
      function persistirFavs() {
        try { localStorage.setItem(FAV_KEY, JSON.stringify([...favoritos])); } catch {}
        const cnt = $('fav-count');
        cnt.textContent = favoritos.size ? '(' + favoritos.size + ')' : '';
      }

      window.cofiToggleFav = function (id, btn) {
        if (favoritos.has(id)) favoritos.delete(id); else favoritos.add(id);
        persistirFavs();
        btn.textContent = favoritos.has(id) ? '★' : '☆';
        btn.classList.toggle('is-fav', favoritos.has(id));
        if (soloFavoritos) window.cofiFiltrar(false);
      };

      window.cofiToggleSoloFavs = function () {
        soloFavoritos = !soloFavoritos;
        $('pill-favs').classList.toggle('active', soloFavoritos);
        window.cofiFiltrar(true);
      };

      // ==========================================
      // RECIENTES
      // ==========================================
      function registrarVisto(id) {
        recientes = [id, ...recientes.filter(x => x !== id)].slice(0, 8);
        try { localStorage.setItem(RECIENTES_KEY, JSON.stringify(recientes)); } catch {}
      }
      function renderRecientes() {
        const wrap = $('recientes-wrap');
        if (!recientes.length) { wrap.classList.add('hidden'); return; }
        wrap.classList.remove('hidden');
        const cont = $('recientes-list');
        const frag = document.createDocumentFragment();
        recientes.slice(0, 6).forEach(id => {
          const c = baseDatos[id]; if (!c) return;
          const btn = document.createElement('button');
          btn.className = 'reciente-chip';
          btn.innerHTML = '☕ ' + esc(c.nombre);
          btn.onclick = () => verEnMapa(id);
          frag.appendChild(btn);
        });
        cont.replaceChildren(frag);
      }

      // ==========================================
      // MÉTRICAS
      // ==========================================
      window.cofiActualizarMetricas = function () {
        const esRanking = $('btn-tab-ranking').classList.contains('active');
        let cafes = 0, tost = 0, prov = 0, ciu = 0;
        if (esRanking) {
          const tipo = $('select-ranking-tipo').value;
          const data = rankingDatos[tipo] || [];
          const cuenta = (campo, vacio) => new Set(data.map(d => d[campo]).filter(v => v && v !== vacio)).size;
          cafes = data.length;
          if (tipo === 'arg') { $('label-provincias').innerText = 'Provincias'; prov = cuenta('provincia', 'Desconocida'); }
          else { $('label-provincias').innerText = 'Países'; prov = cuenta('pais', 'Desconocido'); }
          ciu = cuenta('ciudad', 'Desconocida');
        } else {
          $('label-provincias').innerText = 'Provincias';
          cafes = meta.cafes; tost = meta.tostadores; prov = meta.provincias; ciu = meta.ciudades;
        }
        $('stat-cafes').innerText = cafes;
        $('stat-tostadores').innerText = tost;
        $('stat-provincias').innerText = prov;
        $('stat-ciudades').innerText = ciu;
        $('caja-provincias').style.display = prov > 0 ? '' : 'none';
        $('caja-ciudades').style.display = ciu > 0 ? '' : 'none';
        $('caja-tostadores').style.display = (!esRanking && tost > 0) ? '' : 'none';
      };

      window.cofiSwitchTab = function (tab) {
        ['mapa', 'ranking', 'tostadores'].forEach(t => {
          $('vista-' + t).classList.toggle('hidden', t !== tab);
          $('btn-tab-' + t).classList.toggle('active', t === tab);
        });
        window.cofiActualizarMetricas();
        if (tab === 'mapa' && mapaCofiteca) setTimeout(() => mapaCofiteca.invalidateSize(), 200);
        if (tab === 'tostadores' && !tostadoresRenderizados) { window.cofiRenderizarTostadores(); tostadoresRenderizados = true; }
        if (tab === 'ranking' && !rankingIniciado) {
          initMapaRanking();
          window.cofiActualizarRankingCiudades();
          window.cofiFiltrarRanking();
          rankingIniciado = true;
        } else if (tab === 'ranking' && mapaRanking) {
          setTimeout(() => mapaRanking.invalidateSize(), 200);
        }
        sincronizarURL();
      };

      // ==========================================
      // MAPA GENERAL
      // ==========================================
      function initMapa() {
        mapaCofiteca = L.map('cofiteca-map', { minZoom: 4 }).setView(VISTA_ARGENTINA, 4);
        L.tileLayer(TILES, { attribution: 'Tiles &copy; Esri', maxZoom: 16 }).addTo(mapaCofiteca);
        markerCluster = L.markerClusterGroup({ maxClusterRadius: 40, disableClusteringAtZoom: 14, spiderfyOnMaxZoom: true, showCoverageOnHover: false, chunkedLoading: true }).addTo(mapaCofiteca);
        mapaCofiteca.on('zoomend moveend', actualizarEtiquetas);

        baseDatos.forEach(c => {
          const m = L.circleMarker([c.lat, c.lon], { ...ESTILO_BASE });
          m._nombre = c.nombre;
          m.bindPopup(() => popupHTML(baseDatos[c.id]));
          m.on('click', () => { registrarVisto(c.id); resaltarCard(c.id); renderRecientes(); });
          m.on('popupopen', () => resaltarMarker(c.id));
          m.on('popupclose', quitarResaltadoMarker);
          markersPorId.set(c.id, m);
        });
      }

      function popupHTML(c) {
        const ig = c.instagram ? '<a href="' + esc(c.instagram) + '" target="_blank" rel="noopener noreferrer" class="popup-btn">Instagram</a>' : '';
        const enLista = idsEnLista.has(c.id) ? '<a href="#" class="popup-link" onclick="cofiVerEnLista(' + c.id + '); return false;">Ver en la lista ↓</a>' : '';
        const detalle = '<a href="/cafe/' + esc(c.slug) + '" class="popup-link">Ver ficha completa</a>';
        return '<div class="popup-cafe"><b>' + esc(c.nombre) + '</b><small>' + esc(c.ubicacion) + '</small><div class="popup-acciones">' + ig + detalle + enLista + '</div></div>';
      }

      function quitarResaltadoMarker() {
        if (markerActivoId !== null) {
          const m = markersPorId.get(markerActivoId);
          if (m) m.setStyle({ ...ESTILO_BASE });
          markerActivoId = null;
        }
        if (haloActivo) { mapaCofiteca.removeLayer(haloActivo); haloActivo = null; }
      }
      function resaltarMarker(id) {
        quitarResaltadoMarker();
        const m = markersPorId.get(id);
        if (!m) return;
        markerActivoId = id;
        m.setStyle({ ...ESTILO_ACTIVO });
        haloActivo = L.circleMarker(m.getLatLng(), { radius: 18, weight: 0, fillColor: '#e86a33', fillOpacity: .28, interactive: false, className: 'cofi-halo' }).addTo(mapaCofiteca);
        if (m._map) m.bringToFront();
      }

      function actualizarEtiquetas() {
        if (!mapaCofiteca) return;
        if (mapaCofiteca.getZoom() < ZOOM_ETIQUETAS) {
          marcadoresConEtiqueta.forEach(m => { m.unbindTooltip(); m._tt = false; });
          marcadoresConEtiqueta = [];
          return;
        }
        const area = mapaCofiteca.getBounds().pad(0.2);
        marcadoresActuales.forEach(m => {
          if (!m._tt && area.contains(m.getLatLng())) {
            m.bindTooltip(esc(m._nombre), { permanent: true, direction: 'top', className: 'cafe-label', offset: [0, -10] });
            m._tt = true;
            marcadoresConEtiqueta.push(m);
          }
        });
      }

      // Diff en vez de clear+add
      function dibujarMapa(lista, recentrar) {
        quitarResaltadoMarker();
        marcadoresConEtiqueta.forEach(m => { m.unbindTooltip(); m._tt = false; });
        marcadoresConEtiqueta = [];

        const nuevoSet = new Set(lista.map(c => c.id));
        const aQuitar = [];
        for (const id of idsEnMapa) if (!nuevoSet.has(id)) aQuitar.push(markersPorId.get(id));
        const aAgregar = [];
        for (const id of nuevoSet) if (!idsEnMapa.has(id)) aAgregar.push(markersPorId.get(id));
        if (aQuitar.length) markerCluster.removeLayers(aQuitar);
        if (aAgregar.length) markerCluster.addLayers(aAgregar);
        idsEnMapa = nuevoSet;
        marcadoresActuales = lista.map(c => markersPorId.get(c.id));

        if (recentrar) {
          const ciu = $('select-ciudad').value, zon = $('select-zona').value;
          if (ciu === 'Todas' && zon === 'Todas' && !origen) mapaCofiteca.setView(VISTA_ARGENTINA, 4);
          else if (lista.length) mapaCofiteca.fitBounds(L.latLngBounds(lista.map(c => [c.lat, c.lon])), { padding: [30, 30], maxZoom: 15 });
        }
        actualizarEtiquetas();
      }

      // ==========================================
      // LISTA
      // ==========================================
      function setLista(lista) {
        listaActual = lista;
        idsEnLista = new Set(lista.map(c => c.id));
        mostrados = PAGINA;
        idDestacado = null;
        renderizarLista();
      }

      function crearCard(c) {
        const div = document.createElement('div');
        div.className = 'cafe-card' + (c.id === idDestacado ? ' destacada' : '');
        div.dataset.id = c.id;

        const dist = c.dist !== undefined ? '<br><b>📍 ' + textoDistancia(c.dist) + '</b>' : '';
        const ig = c.instagram ? '<a href="' + esc(c.instagram) + '" target="_blank" rel="noopener noreferrer">Instagram</a>' : '';
        const rank = rankMap.get(c.id);
        const badge = rank ? ' <span class="card-badge">#' + rank + ' top</span>' : '';
        const favActivo = favoritos.has(c.id) ? 'is-fav' : '';
        const favIcon = favoritos.has(c.id) ? '★' : '☆';

        div.innerHTML =
          '<button class="fav-btn ' + favActivo + '" data-fav="' + c.id + '" aria-label="Favorito">' + favIcon + '</button>' +
          '<div>' +
            '<h3><a href="/cafe/' + esc(c.slug) + '">' + esc(c.nombre) + '</a>' + badge + '</h3>' +
            '<p>' + esc(c.ubicacion) + ' • <b>' + esc(c.ciudadReal || c.ciudad) + '</b>' + dist + '</p>' +
          '</div>' +
          '<div class="cafe-actions">' +
            '<button type="button" data-ver-mapa>Ver en mapa</button>' +
            ig +
            '<a href="' + urlComoLlegar(c) + '" target="_blank" rel="noopener noreferrer">Cómo llegar</a>' +
          '</div>';

        div.querySelector('.fav-btn').addEventListener('click', e => {
          e.stopPropagation();
          window.cofiToggleFav(c.id, e.currentTarget);
        });
        div.querySelector('[data-ver-mapa]').addEventListener('click', () => verEnMapa(c.id));
        return div;
      }

      function renderizarLista() {
        const cont = $('cofi-resultados');
        const frag = document.createDocumentFragment();

        if (!listaActual.length) {
          const empty = document.createElement('div');
          empty.className = 'msg-vacio';
          empty.innerHTML =
            '<span class="emoji">☕</span>' +
            '<h3>Sin resultados</h3>' +
            '<p>Probá con menos filtros o buscá cerca tuyo.</p>' +
            '<button onclick="cofiUsarMiGPS()">Cerca de mi ubicación</button>';
          frag.appendChild(empty);
        } else {
          listaActual.slice(0, mostrados).forEach(c => frag.appendChild(crearCard(c)));
          if (listaActual.length > mostrados) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn-ver-mas';
            btn.textContent = 'Ver más (' + (listaActual.length - mostrados) + ' restantes)';
            btn.addEventListener('click', () => { mostrados += PAGINA; renderizarLista(); });
            frag.appendChild(btn);
          }
        }
        cont.replaceChildren(frag);

        const count = $('cofi-count');
        if (listaActual.length) {
          count.textContent = 'Mostrando ' + Math.min(mostrados, listaActual.length) + ' de ' + listaActual.length + ' locales';
        } else {
          count.textContent = '';
        }
      }

      function verEnMapa(id) {
        const c = baseDatos[id];
        const m = markersPorId.get(id);
        registrarVisto(id);
        renderRecientes();
        resaltarCard(id);
        document.querySelector('#vista-mapa .map-wrapper').scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (markerCluster.hasLayer(m)) markerCluster.zoomToShowLayer(m, () => m.openPopup());
        else {
          mapaCofiteca.setView([c.lat, c.lon], 16);
          L.popup().setLatLng([c.lat, c.lon]).setContent(popupHTML(c)).openOn(mapaCofiteca);
        }
      }

      function resaltarCard(id) {
        idDestacado = id;
        document.querySelectorAll('#cofi-resultados .cafe-card.destacada').forEach(el => el.classList.remove('destacada'));
        const el = document.querySelector('#cofi-resultados .cafe-card[data-id="' + id + '"]');
        if (el) el.classList.add('destacada');
      }

      window.cofiVerEnLista = function (id) {
        const idx = listaActual.findIndex(c => c.id === id);
        if (idx === -1) return;
        if (idx >= mostrados) { mostrados = idx + 1; renderizarLista(); }
        resaltarCard(id);
        const el = document.querySelector('#cofi-resultados .cafe-card[data-id="' + id + '"]');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      // ==========================================
      // FILTROS
      // ==========================================
      window.cofiActualizarZonas = function () {
        const ciu = $('select-ciudad').value;
        const base = ciu === 'Todas' ? baseDatos : baseDatos.filter(c => c.ciudad === ciu);
        const zonas = [...new Set(base.map(c => c.zona))].filter(z => z && z !== '-' && z !== 'Sin Zona').sort((a, b) => a.localeCompare(b, 'es'));
        $('select-zona').innerHTML = '<option value="Todas">Zona / Barrio</option>' + zonas.map(z => '<option value="' + esc(z) + '">' + esc(z) + '</option>').join('');
      };

      window.cofiCambiarOrden = function (orden) {
        ordenActual = orden;
        window.cofiFiltrar(false);
      };

      function filtrarDatos() {
        const ciu = $('select-ciudad').value;
        const zon = $('select-zona').value;
        const tokens = norm($('input-busqueda').value).trim().split(/\s+/).filter(Boolean);

        let filtrados = baseDatos.filter(c =>
          (ciu === 'Todas' || c.ciudad === ciu) &&
          (zon === 'Todas' || c.zona === zon) &&
          (!soloFavoritos || favoritos.has(c.id)) &&
          tokens.every(t => c._q.includes(t))
        );

        if (ordenActual === 'ranking') {
          filtrados = filtrados.slice().sort((a, b) => {
            const ra = rankMap.get(a.id) ?? Infinity;
            const rb = rankMap.get(b.id) ?? Infinity;
            return ra - rb;
          });
        } else if (ordenActual === 'distancia' && origen) {
          filtrados = filtrados.slice().sort((a, b) => {
            const da = calcularD(origen.lat, origen.lon, a.lat, a.lon);
            const db = calcularD(origen.lat, origen.lon, b.lat, b.lon);
            return da - db;
          });
        }
        return filtrados;
      }

      function limpiarOrigen() {
        if (markerOrigen) { mapaCofiteca.removeLayer(markerOrigen); markerOrigen = null; }
        origen = null;
        $('cofi-status').classList.add('hidden');
        $('opt-distancia').disabled = true;
        if (ordenActual === 'distancia') { ordenActual = 'nombre'; $('select-orden').value = 'nombre'; }
      }

      function aplicarFiltros(recentrar) {
        const filtrados = filtrarDatos();
        setLista(filtrados);
        dibujarMapa(filtrados, recentrar);
        sincronizarURL();
      }

      let debounceFiltro = null;
      window.cofiFiltrar = function (recentrar) {
        clearTimeout(debounceFiltro);
        debounceFiltro = setTimeout(() => {
          if (recentrar === true) limpiarOrigen();
          aplicarFiltros(recentrar === true);
        }, 150);
      };

      window.cofiQuitarOrigen = function () { limpiarOrigen(); aplicarFiltros(true); };

      // ==========================================
      // URL STATE
      // ==========================================
      function sincronizarURL() {
        const p = new URLSearchParams(location.search);
        const c = $('select-ciudad').value;
        const q = $('input-busqueda').value.trim();
        const tab = document.querySelector('.view-tab-btn.active').id.replace('btn-tab-', '');
        if (c !== 'Todas') p.set('c', c); else p.delete('c');
        if (q) p.set('q', q); else p.delete('q');
        if (tab !== 'mapa') p.set('v', tab); else p.delete('v');
        const nueva = p.toString() ? '?' + p : location.pathname;
        history.replaceState(null, '', nueva);
      }

      function hidratarDesdeURL() {
        const p = new URLSearchParams(location.search);
        const c = p.get('c');
        const q = p.get('q');
        const v = p.get('v');
        if (c) {
          const opt = Array.from($('select-ciudad').options).find(o => o.value === c);
          if (opt) { $('select-ciudad').value = c; window.cofiActualizarZonas(); }
        }
        if (q) $('input-busqueda').value = q;
        if (v && ['ranking', 'tostadores'].includes(v)) {
          setTimeout(() => window.cofiSwitchTab(v), 50);
        }
      }

      // ==========================================
      // RANKING
      // ==========================================
      function getRankingColor(rank) {
        if (!rank || isNaN(rank)) return '#34495e';
        if (rank <= 3) return '#D4AF37';
        if (rank <= 10) return '#E86A33';
        if (rank <= 20) return '#009FBD';
        if (rank <= 30) return '#8e44ad';
        if (rank <= 40) return '#27ae60';
        if (rank <= 50) return '#f39c12';
        if (rank <= 60) return '#d35400';
        if (rank <= 70) return '#c0392b';
        if (rank <= 80) return '#16a085';
        if (rank <= 90) return '#7f8c8d';
        return '#2c3e50';
      }

      function initMapaRanking() {
        mapaRanking = L.map('ranking-map', { minZoom: 2 }).setView(VISTA_ARGENTINA, 4);
        L.tileLayer(TILES, { attribution: 'Tiles &copy; Esri', maxZoom: 16 }).addTo(mapaRanking);
        markerClusterRanking = L.markerClusterGroup({ maxClusterRadius: 35, disableClusteringAtZoom: 12, spiderfyOnMaxZoom: true }).addTo(mapaRanking);
      }

      window.cofiActualizarRankingCiudades = function () {
        const tipo = $('select-ranking-tipo').value;
        const data = rankingDatos[tipo] || [];
        const lugares = [...new Set(data.map(c => c.lugar))].sort((a, b) => a.localeCompare(b, 'es'));
        const texto = tipo === 'arg' ? 'Todas las Ciudades' : 'Todos los Países';
        $('select-ranking-ciudad').innerHTML = '<option value="Todas">' + texto + '</option>' + lugares.map(c => '<option value="' + esc(c) + '">' + esc(c) + '</option>').join('');
      };

      window.cofiFiltrarRanking = function () {
        if (!markerClusterRanking) return;
        const tipo = $('select-ranking-tipo').value;
        const lugar = $('select-ranking-ciudad').value;
        const filtrados = (rankingDatos[tipo] || []).filter(c => lugar === 'Todas' || c.lugar === lugar);

        const markers = filtrados.map(c => {
          const color = getRankingColor(c.rank);
          const icon = L.divIcon({
            html: '<div style="background-color:' + color + '; color:white; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; font-weight:800; border:2px solid white; box-shadow:0 3px 6px rgba(0,0,0,.3); font-size:13px; font-family:Inter,sans-serif;">' + esc(c.rank) + '</div>',
            className: 'custom-ranking-icon', iconSize: [28, 28], iconAnchor: [14, 14]
          });
          const ig = c.ig ? '<div class="popup-acciones"><a href="' + esc(c.ig) + '" target="_blank" rel="noopener noreferrer" class="popup-btn">Instagram</a></div>' : '';
          return L.marker([c.lat, c.lon], { icon }).bindPopup(
            '<div class="popup-cafe"><span class="rank-badge" style="background:' + color + ';">#' + esc(c.rank) + '</span><br><b>' + esc(c.nombre) + '</b><br><small>' + esc(c.ubicacion) + ' • ' + esc(c.lugar) + '</small>' + ig + '</div>'
          );
        });

        markerClusterRanking.clearLayers();
        markerClusterRanking.addLayers(markers);

        if (filtrados.length) {
          let zoom = 12;
          if (lugar === 'Todas') zoom = tipo === 'mun' ? 2 : 4;
          else if (tipo !== 'arg') zoom = 5;
          const lat = filtrados.reduce((s, c) => s + c.lat, 0) / filtrados.length;
          const lon = filtrados.reduce((s, c) => s + c.lon, 0) / filtrados.length;
          mapaRanking.setView([lat, lon], zoom);
        }

        const frag = document.createDocumentFragment();
        filtrados.forEach(c => {
          const color = getRankingColor(c.rank);
          const div = document.createElement('div');
          div.className = 'cafe-card';
          const ig = c.ig ? '<a href="' + esc(c.ig) + '" target="_blank" rel="noopener noreferrer">Instagram</a>' : '';
          div.innerHTML =
            '<div><h3><span class="rank-badge" style="background:' + color + ';">#' + esc(c.rank) + '</span> ' + esc(c.nombre) + '</h3>' +
            '<p>' + esc(c.ubicacion) + ' • <b>' + esc(c.lugar) + '</b></p></div>' +
            '<div class="cafe-actions">' + ig + '<a href="' + urlComoLlegar(c) + '" target="_blank" rel="noopener noreferrer">Cómo llegar</a></div>';
          frag.appendChild(div);
        });
        $('ranking-resultados').replaceChildren(frag);
      };

      // ==========================================
      // TOSTADORES
      // ==========================================
      window.cofiRenderizarTostadores = function () {
        const ciudad = $('select-ciudad-tostadores').value;
        const filtrados = tostadoresDatos.filter(t => ciudad === 'Todas' || t.ciudad === ciudad);
        const cont = $('lista-tostadores');

        if (!filtrados.length) {
          cont.innerHTML = '<p class="msg-vacio"><span class="emoji">🌱</span>Todavía no hay tostadores registrados en esta ciudad.</p>';
          return;
        }
        const frag = document.createDocumentFragment();
        filtrados.forEach(t => {
          const div = document.createElement('div');
          div.className = 'tostador-card';
          const img = t.foto || IMG_FALLBACK;
          let botones = '';
          if (t.ig) botones += '<a href="' + esc(t.ig) + '" target="_blank" rel="noopener noreferrer" class="btn-outline-mad" style="margin-bottom:8px;display:block;">Instagram</a>';
          if (t.tienda) botones += '<a href="' + esc(t.tienda) + '" target="_blank" rel="noopener noreferrer" class="btn-primary-mad" style="display:block;">Tienda Online</a>';
          div.innerHTML =
            '<img src="' + esc(img) + '" class="tostador-img" width="400" height="200" loading="lazy" decoding="async" alt="' + esc(t.nombre) + '" onerror="this.onerror=null;this.src=\'' + IMG_FALLBACK + '\'">' +
            '<div class="tostador-content"><div>' +
              '<h3>' + esc(t.nombre) + '</h3>' +
              '<p>📍 ' + esc(t.ciudad) + '</p>' +
            '</div><div>' + botones + '</div></div>';
          frag.appendChild(div);
        });
        cont.replaceChildren(frag);
      };

      // ==========================================
      // UBICACIÓN (GPS / DIRECCIÓN) + radio
      // ==========================================
      function cofiProcesarOrigen(lat, lon, label) {
        $('select-ciudad').value = 'Todas';
        window.cofiActualizarZonas();
        $('input-busqueda').value = '';
        limpiarOrigen();

        origen = { lat, lon, label };
        markerOrigen = L.circleMarker([lat, lon], { radius: 8, color: '#1a0f0a', fillColor: '#fff', weight: 3, fillOpacity: 1 })
          .addTo(mapaCofiteca).bindPopup(esc(label)).openPopup();

        // Lista: todos los cafés con dist, ordenados
        const conDist = baseDatos.map(c => ({ ...c, dist: calcularD(lat, lon, c.lat, c.lon) }))
          .sort((a, b) => a.dist - b.dist);
        setLista(conDist);

        // El mapa sigue mostrando todo para que el origen no quede aislado
        dibujarMapa(baseDatos, false);
        mapaCofiteca.setView([lat, lon], 15);

        $('opt-distancia').disabled = false;
        const st = $('cofi-status');
        st.innerHTML = '📍 Mostrando los locales más cercanos a <b>' + esc(label) + '</b>' +
          ' · <a href="#" onclick="cofiFiltrarRadio(1);return false;">1 km</a>' +
          ' · <a href="#" onclick="cofiFiltrarRadio(5);return false;">5 km</a>' +
          ' · <a href="#" onclick="cofiFiltrarRadio(15);return false;">15 km</a>' +
          ' · <a href="#" onclick="cofiFiltrarRadio(50);return false;">50 km</a>' +
          ' · <a onclick="cofiQuitarOrigen()">Quitar</a>';
        st.classList.remove('hidden');
        sincronizarURL();
      }

      window.cofiFiltrarRadio = function (km) {
        if (!origen) return;
        const dentro = baseDatos.map(c => ({ ...c, dist: calcularD(origen.lat, origen.lon, c.lat, c.lon) }))
          .filter(c => c.dist <= km).sort((a, b) => a.dist - b.dist);
        setLista(dentro);
        dibujarMapa(dentro, false);
        const st = $('cofi-status');
        st.innerHTML = '📍 Mostrando locales a menos de <b>' + km + ' km</b> de <b>' + esc(origen.label) + '</b>' +
          ' · <a onclick="cofiQuitarOrigen()">Quitar</a>';
      };

      window.cofiUsarMiGPS = function () {
        if (!navigator.geolocation) { ensureSwal().then(() => Swal.fire('Error', 'Tu navegador no soporta GPS.', 'error')); return; }
        navigator.geolocation.getCurrentPosition(
          p => cofiProcesarOrigen(p.coords.latitude, p.coords.longitude, 'tu ubicación'),
          () => ensureSwal().then(() => Swal.fire('Aviso', 'No pudimos obtener tu ubicación. Revisá los permisos.', 'warning')),
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
        );
      };

      window.cofiMedirDesdeDireccion = async function () {
        await ensureSwal();
        Swal.fire({
          title: '¿Dónde estás?',
          html: '<p style="font-size:.9rem;color:#5c3d2e;margin-bottom:15px;">Escribí tu calle y ciudad (Ej: Güemes, Mar del Plata)</p>' +
                '<input id="swal-autocomplete-input" class="input-moderno" placeholder="Escribir..." autocomplete="off" style="width:100%;box-sizing:border-box;">' +
                '<div id="autocomplete-results" style="text-align:left;margin-top:10px;max-height:200px;overflow-y:auto;"></div>',
          showConfirmButton: false, showCancelButton: true, cancelButtonText: 'Cerrar',
          customClass: { popup: 'swal-custom-popup', cancelButton: 'swal-custom-btn-cancel' },
          didOpen: () => {
            const input = $('swal-autocomplete-input');
            const resultsContainer = $('autocomplete-results');
            let timeout = null, solicitudId = 0;
            input.focus();
            input.addEventListener('input', () => {
              clearTimeout(timeout);
              const val = input.value.trim();
              if (val.length < 4) { resultsContainer.innerHTML = ''; return; }
              resultsContainer.innerHTML = '<div style="padding:10px;color:#1a0f0a;font-weight:bold;text-align:center;">Buscando...</div>';
              timeout = setTimeout(async () => {
                const miId = ++solicitudId;
                try {
                  const res = await fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(val) + '&countrycodes=ar&addressdetails=1&limit=6');
                  const data = await res.json();
                  if (miId !== solicitudId) return;
                  resultsContainer.innerHTML = '';
                  if (!data.length) { resultsContainer.innerHTML = '<div style="padding:10px;opacity:.7;text-align:center;">No encontramos la dirección.</div>'; return; }
                  data.forEach(item => {
                    const partes = [];
                    if (item.address.road) partes.push(item.address.road + (item.address.house_number ? ' ' + item.address.house_number : ''));
                    const localidad = item.address.city || item.address.town || item.address.village;
                    if (localidad) partes.push(localidad);
                    const nombreStr = partes.length ? partes.join(', ') : item.display_name.split(',').slice(0, 3).join(', ');
                    const btn = document.createElement('button');
                    btn.style.cssText = 'width:100%;text-align:left;background:rgba(255,255,255,.7);color:#1a0f0a;border:1px solid rgba(196,167,125,.5);padding:12px;border-radius:6px;cursor:pointer;margin-bottom:8px;font-family:Inter,sans-serif;font-size:.9rem;transition:.2s;';
                    btn.innerHTML = '📍 <b>' + esc(nombreStr) + '</b>';
                    btn.onmouseover = () => { btn.style.borderColor = '#1a0f0a'; };
                    btn.onmouseout = () => { btn.style.borderColor = 'rgba(196,167,125,.5)'; };
                    btn.onclick = () => { Swal.close(); cofiProcesarOrigen(parseFloat(item.lat), parseFloat(item.lon), nombreStr); };
                    resultsContainer.appendChild(btn);
                  });
                } catch { if (miId === solicitudId) resultsContainer.innerHTML = '<div style="padding:10px;color:red;text-align:center;">Error con el mapa.</div>'; }
              }, 800);
            });
          }
        });
      };

      // ==========================================
      // SORPRENDEME
      // ==========================================
      window.cofiSorprendeme = function () {
        window.cofiSwitchTab('mapa');
        const conIg = baseDatos.filter(c => c.instagram);
        const pool = conIg.length ? conIg : baseDatos;
        const c = pool[Math.floor(Math.random() * pool.length)];
        setTimeout(() => verEnMapa(c.id), 150);
      };

      // ==========================================
      // REPORTES / ALTAS
      // ==========================================
      window.cofiAbrirReporte = async function () {
        await ensureSwal();
        const { value: formValues } = await Swal.fire({
          title: 'Soporte',
          customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
          html: '<div style="text-align:left;">' +
                '<select id="swal-tipo" class="swal-custom-input" style="margin-bottom:10px;"><option value="Dato Incorrecto">Corrección de datos</option><option value="Local Cerrado">Local cerrado</option></select>' +
                '<input id="swal-local" class="swal-custom-input" placeholder="Nombre del local o tu teléfono" style="margin-bottom:10px;">' +
                '<textarea id="swal-detalle" class="swal-custom-input" placeholder="Detalle de la solicitud..." style="height:80px;resize:none;"></textarea></div>',
          showCancelButton: true, confirmButtonText: 'Enviar', cancelButtonText: 'Cancelar',
          preConfirm: () => {
            const local = $('swal-local').value.trim();
            if (!local) { Swal.showValidationMessage('Ingresá una referencia válida'); return false; }
            return { tipo: $('swal-tipo').value, local, detalle: $('swal-detalle').value.trim() };
          }
        });
        if (formValues) window.cofiEnviarReporteEmail(formValues);
      };

      window.cofiAbrirSumate = async function () {
        await ensureSwal();
        const { value: formValues } = await Swal.fire({
          title: 'Añadir Local',
          customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
          html: '<div style="text-align:left;">' +
                '<select id="sumate-tipo" class="swal-custom-input" style="margin-bottom:10px;"><option value="Cafetería / Tostaduría">Cafetería / Tostaduría</option></select>' +
                '<input id="sumate-nombre" class="swal-custom-input" placeholder="Nombre comercial" style="margin-bottom:10px;">' +
                '<input id="sumate-link" class="swal-custom-input" placeholder="Link a Instagram o Web" style="margin-bottom:10px;"></div>',
          showCancelButton: true, confirmButtonText: 'Enviar Solicitud', cancelButtonText: 'Cancelar',
          preConfirm: () => {
            const nombre = $('sumate-nombre').value.trim();
            if (!nombre) { Swal.showValidationMessage('Ingresá el nombre comercial'); return false; }
            return { tipo: 'ALTA NUEVA: ' + $('sumate-tipo').value, local: nombre, detalle: 'Link/IG: ' + $('sumate-link').value.trim() };
          }
        });
        if (formValues) window.cofiEnviarReporteEmail(formValues);
      };

      window.cofiEnviarReporteEmail = async function (datosForm) {
        try {
          await fetch('/api/reporte?t=' + Date.now(), {
            method: 'POST', mode: 'no-cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(datosForm)
          });
          Swal.fire({ title: 'Enviado', text: 'Tu solicitud fue recibida.', icon: 'success', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
        } catch {
          Swal.fire({ title: 'Error', text: 'Problemas de conexión con el servidor.', icon: 'error', customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } });
        }
      };

      // ==========================================
      // KEYBOARD SHORTCUTS
      // ==========================================
      document.addEventListener('keydown', e => {
        if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
          e.preventDefault();
          $('input-busqueda').focus();
        }
        if (e.key === 'Escape' && document.activeElement.id === 'input-busqueda') {
          $('input-busqueda').value = '';
          window.cofiFiltrar(false);
        }
      });

      // ==========================================
      // ARRANQUE
      // ==========================================
      const ciudades = [...new Set(baseDatos.map(c => c.ciudad))].sort((a, b) => a.localeCompare(b, 'es'));
      $('select-ciudad').innerHTML = '<option value="Todas">Región / Ciudad</option>' + ciudades.map(c => '<option value="' + esc(c) + '">' + esc(c) + '</option>').join('');

      const ciudadesTost = [...new Set(tostadoresDatos.map(t => t.ciudad))].sort((a, b) => a.localeCompare(b, 'es'));
      $('select-ciudad-tostadores').innerHTML = '<option value="Todas">Todas las Ciudades</option>' + ciudadesTost.map(c => '<option value="' + esc(c) + '">' + esc(c) + '</option>').join('');

      // Quick chips (regiones más grandes)
      const GRANDES = ['CABA y Gran Buenos Aires', 'Córdoba', 'Mar del Plata', 'Mendoza', 'La Plata'];
      $('quick-chips').innerHTML = GRANDES
        .filter(r => ciudades.includes(r))
        .map(r => '<button class="quick-chip" onclick="cofiQuickRegion(\'' + esc(r) + '\')">' + esc(r.replace(' y Gran Buenos Aires', '')) + '</button>')
        .join('');

      window.cofiQuickRegion = function (r) {
        $('select-ciudad').value = r;
        window.cofiActualizarZonas();
        window.cofiFiltrar(true);
      };

      persistirFavs();
      renderRecientes();
      window.cofiActualizarZonas();
      window.cofiActualizarMetricas();
      initMapa();
      hidratarDesdeURL();
      aplicarFiltros(false);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { iniciarBuscadorSeguro(); });
    else iniciarBuscadorSeguro();
    document.addEventListener('astro:page-load', function () { iniciarBuscadorSeguro(); });
  </script>
</body>
</html>
