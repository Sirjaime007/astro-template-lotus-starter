---
// src/pages/buscador.astro
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Base de Datos | Cofiteca x Mad</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

  <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  <script is:inline defer src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <style is:global>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background-color: #f5f0e8; color: #2c1810; font-family: 'Inter', sans-serif; }
    
    .nav-bar { padding: 1.5rem 2rem; display: flex; align-items: center; border-bottom: 1px solid rgba(196, 167, 125, 0.3); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: #8b4513; font-weight: 600; font-family: 'Inter', sans-serif; transition: 0.2s; }
    .btn-back:hover { color: #5c3d2e; transform: translateX(-5px); }
    
    .data-real-container { margin: 1rem auto 4rem auto; max-width: 1200px; padding: 0 1rem; display: grid; grid-template-columns: 280px 1fr; gap: 1rem; }
    @media (max-width: 1024px) { .data-real-container { grid-template-columns: 1fr; } }

    .metrics-sidebar { padding: 2rem; display: flex; flex-direction: column; justify-content: flex-start; gap: 2.5rem; background: rgba(255,255,255, 0.6); border-radius: 16px; border: 1px solid rgba(255,255,255,0.9); box-shadow: 0 10px 30px rgba(44, 24, 16, 0.05); }
    @media (max-width: 1024px) { .metrics-sidebar { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 1.5rem; } }
    
    .metric-item { text-align: center; }
    @media (max-width: 768px) { .metric-item { flex: 1 1 40%; min-width: 120px; } }
    .metric-number { font-size: 3rem; font-weight: 700; color: #1a0f0a; line-height: 1; display: inline-block; font-family: 'Georgia', serif; }
    .metric-symbol { font-size: 2rem; font-weight: 700; color: #c4a77d; font-family: 'Georgia', serif; }
    .metric-label { display: block; font-size: 0.85rem; color: #5c3d2e; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.5rem; font-weight: 700; }

    .buscador-main-panel { display: flex; flex-direction: column; background: rgba(255,255,255, 0.6); border-radius: 16px; border: 1px solid rgba(255,255,255,0.9); box-shadow: 0 10px 30px rgba(44, 24, 16, 0.05); overflow: hidden; }
    
    .data-header { padding: 2rem; border-bottom: 1px solid rgba(196, 167, 125, 0.3); text-align: center; }
    .view-tabs { display: flex; gap: 15px; justify-content: center; margin-top: 15px; flex-wrap: wrap;}
    .view-tab-btn { background: transparent; border: 2px solid transparent; color: #5c3d2e; font-size: 0.95rem; font-weight: 700; cursor: pointer; padding: 10px 20px; border-radius: 12px; transition: 0.2s; font-family: 'Inter', sans-serif; }
    .view-tab-btn:hover { background: rgba(196, 167, 125, 0.1); }
    .view-tab-btn.active { background: #8b4513; color: white; border-color: #8b4513; box-shadow: 0 4px 10px rgba(139, 69, 19, 0.2); }

    .buscador-ui { padding: 1.5rem 2rem 2rem; flex-grow: 1; display: flex; flex-direction: column; }
    @media (max-width: 768px) { .data-header { padding: 1.5rem 1rem; } .buscador-ui { padding: 1.5rem 1rem; } }
    
    .search-controls { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 1rem; margin-bottom: 1rem; }
    @media (max-width: 900px) { .search-controls { grid-template-columns: 1fr 1fr; } .search-controls input { grid-column: 1 / -1; } }
    @media (max-width: 576px) { .search-controls { grid-template-columns: 1fr; } }
    
    .search-buttons { display: flex; gap: 10px; margin-bottom: 1.5rem; }
    @media (max-width: 576px) { .search-buttons { flex-direction: column; } }

    .btn-outline-mad { flex: 1; background: transparent; color: #3d2317; border: 2px solid #c4a77d; padding: 12px 20px; border-radius: 10px; font-family: 'Inter', sans-serif; font-weight: 700; cursor: pointer; transition: 0.3s; font-size: 0.95rem; text-decoration: none; text-align: center; }
    .btn-outline-mad:hover { background: rgba(255,255,255,0.8); border-color: #8b4513; }
    .btn-primary-mad { flex: 1; background: #8b4513; color: white; border: 2px solid #8b4513; padding: 12px 20px; border-radius: 10px; font-family: 'Inter', sans-serif; font-weight: 700; cursor: pointer; transition: 0.3s; font-size: 0.95rem; text-decoration: none; text-align: center; }
    .btn-primary-mad:hover { background: #5c3d2e; border-color: #5c3d2e; }

    .input-moderno { width: 100%; padding: 14px 16px; border: 1px solid #c4a77d; border-radius: 12px; font-family: 'Inter', sans-serif; font-size: 0.95rem; background: rgba(255,255,255,0.9); color: #2A1F18; outline: none; transition: border-color 0.2s; }
    .input-moderno:focus { border-color: #8b4513; box-shadow: 0 0 0 3px rgba(139, 69, 19, 0.15); }
    
    .map-wrapper { width: 100%; height: 500px; border-radius: 12px; overflow: hidden; border: 1px solid #c4a77d; margin-bottom: 2rem; position: relative; z-index: 1;}
    @media (max-width: 768px) { .map-wrapper { height: 400px; } }
    #cofiteca-map { width: 100%; height: 100%; background: #e6e2db; }
    .cafe-label { background: transparent; border: none; box-shadow: none; color: #2c1810; font-weight: 800; font-size: 0.8rem; text-shadow: 2px 2px 0px white, -2px -2px 0px white, 2px -2px 0px white, -2px 2px 0px white; opacity: 0; transition: opacity 0.3s ease; pointer-events: none; }
    .show-labels .cafe-label { opacity: 1; }

    .resultados-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; max-height: 450px; overflow-y: auto; padding-right: 10px;}
    .resultados-grid::-webkit-scrollbar { width: 8px; }
    .resultados-grid::-webkit-scrollbar-track { background: rgba(196, 167, 125, 0.2); border-radius: 10px; }
    .resultados-grid::-webkit-scrollbar-thumb { background: #c4a77d; border-radius: 10px; }

    .cafe-card { background: white; padding: 18px; border-radius: 12px; border: 1px solid rgba(196, 167, 125, 0.4); box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s; display: flex; flex-direction: column; justify-content: space-between;}
    .cafe-card:hover { transform: translateY(-3px); border-color: #8b4513; box-shadow: 0 8px 25px rgba(139, 69, 19, 0.1); }
    .cafe-card h3 { margin: 0 0 5px 0; font-size: 1.1rem; color: #1a0f0a; font-family: 'Georgia', serif;}
    .cafe-card p { margin: 0 0 12px 0; font-size: 0.85rem; color: #5c3d2e; }
    .cafe-card a { text-align: center; display: block; padding: 8px; background: #f5f0e8; border-radius: 8px; font-weight: 600; font-size: 0.8rem; color: #8b4513; border: 1px solid #c4a77d;}
    .cafe-card a:hover { background: #8b4513; color: white; }

    /* ESTILOS PARA TOSTADORES */
    .tostadores-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
    .tostador-card { background: white; border: 1px solid rgba(196, 167, 125, 0.4); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column; transition: transform 0.2s; }
    .tostador-card:hover { transform: translateY(-3px); border-color: #8b4513; }
    .tostador-img { width: 100%; height: 180px; object-fit: cover; background-color: #f5f0e8; }
    .tostador-content { padding: 18px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }

    /* BOTONES FLOTANTES */
    .btn-flotante-reporte { position: fixed; bottom: 20px; right: 20px; background: #1E293B; color: white; border: none; padding: 14px 20px; border-radius: 30px; font-weight: 700; font-size: 0.9rem; cursor: pointer; box-shadow: 0 4px 15px rgba(0,0,0,0.3); z-index: 9997; transition: transform 0.2s; display: flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif;}
    .btn-flotante-sumate { position: fixed; bottom: 20px; left: 20px; background: #c4a77d; color: #1a0f0a; border: none; padding: 14px 20px; border-radius: 30px; font-weight: 700; font-size: 0.9rem; cursor: pointer; box-shadow: 0 4px 15px rgba(0,0,0,0.3); z-index: 9997; transition: transform 0.2s; display: flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif;}
    .btn-flotante-reporte:hover, .btn-flotante-sumate:hover { transform: scale(1.05); }
    @media (max-width: 600px) {
        .btn-flotante-reporte { bottom: 15px; right: 15px; font-size: 0.8rem; padding: 12px 16px; }
        .btn-flotante-sumate { bottom: 70px; right: 15px; left: auto; font-size: 0.8rem; padding: 12px 16px; }
    }
    
    .hidden { display: none !important; }

    /* ESTILOS SWEETALERT */
    .swal2-popup.swal-custom-popup { border-radius: 24px !important; padding: 30px !important; border: 1px solid #c4a77d !important; font-family: 'Inter', sans-serif; background: #f5f0e8 !important; }
    .swal-custom-input { width: 100% !important; padding: 14px 16px !important; border: 1px solid #c4a77d !important; border-radius: 12px !important; font-family: 'Inter', sans-serif !important; font-size: 0.95rem !important; box-sizing: border-box !important; background: white !important; color: #2A1F18 !important; margin: 0 !important; }
    .swal-custom-input:focus { border-color: #8b4513 !important; outline: none !important; box-shadow: 0 0 0 3px rgba(139, 69, 19, 0.15) !important; }
    .swal2-styled.swal-custom-btn-confirm { background-color: #8b4513 !important; border-radius: 10px !important; font-weight: 700 !important; }
    .swal2-styled.swal-custom-btn-cancel { background-color: transparent !important; border: 2px solid #c4a77d !important; color: #8b4513 !important; border-radius: 10px !important; font-weight: 700 !important;}
  </style>
</head>
<body>
  
  <nav class="nav-bar">
    <a href="/" class="btn-back">← Volver a Mad Diseño</a>
  </nav>

  <div class="data-real-container">
    <div class="metrics-sidebar">
      <div class="metric-item">
        <span class="metric-number" data-target="0" id="stat-cafes">0</span>
        <span class="metric-label">Cafeterías</span>
      </div>
      <div class="metric-item">
        <span class="metric-number" data-target="0" id="stat-tostadores">0</span>
        <span class="metric-label">Tostadores</span>
      </div>
      <div class="metric-item">
        <span class="metric-number" data-target="0" id="stat-provincias">0</span>
        <span class="metric-label">Provincias</span>
      </div>
      <div class="metric-item">
        <span class="metric-number" data-target="0" id="stat-ciudades">0</span>
        <span class="metric-label">Ciudades</span>
      </div>
    </div>

    <div class="buscador-main-panel">
      <div class="data-header">
        <p style="font-size: 1.25rem; font-weight: 800; margin: 0; color: #1a0f0a; font-family: 'Georgia', serif;">Base de Datos Nacional</p>
        <p id="cofi-status" style="font-size: 0.9rem; color: #8b4513; margin: 5px 0 0 0; font-weight: bold;">Sincronizando con el servidor...</p>
        
        <div class="view-tabs">
            <button class="view-tab-btn active" onclick="cofiSwitchTab('mapa')" id="btn-tab-mapa">📍 Mapa de Cafés</button>
            <button class="view-tab-btn" onclick="cofiSwitchTab('tostadores')" id="btn-tab-tostadores">☕ Catálogo de Tostadores</button>
        </div>
      </div>
      
      <div class="buscador-ui" id="vista-mapa">
        <div class="search-controls">
          <select id="select-ciudad" class="input-moderno" onchange="cofiActualizarZonas(); cofiFiltrar()"><option value="Todas">Región / Ciudad</option></select>
          <select id="select-zona" class="input-moderno" onchange="cofiFiltrar()"><option value="Todas">Zona / Barrio</option></select>
          <input type="text" id="input-busqueda" class="input-moderno" placeholder="Buscá por nombre o calle..." oninput="cofiFiltrar()">
        </div>
        
        <div class="search-buttons">
          <button class="btn-outline-mad" onclick="cofiMedirDesdeDireccion()">📍 Buscar por Dirección</button>
          <button class="btn-primary-mad" onclick="cofiUsarMiGPS()">🎯 Cerca de Mí</button>
        </div>
        
        <div class="map-wrapper">
          <div id="cofiteca-map"></div>
        </div>
        
        <div id="cofi-resultados" class="resultados-grid"></div>
      </div>

      <div class="buscador-ui hidden" id="vista-tostadores">
        <div class="search-controls" style="grid-template-columns: 1fr; margin-bottom: 2rem;">
            <select id="select-ciudad-tostadores" class="input-moderno" onchange="cofiRenderizarTostadores()"><option value="Todas">Todas las Ciudades</option></select>
        </div>
        <div id="lista-tostadores" class="tostadores-grid">
            <p style="text-align:center; opacity:0.7; grid-column:1/-1;">Sincronizando tostadores...</p>
        </div>
      </div>
    </div>
  </div>

  <button class="btn-flotante-reporte" onclick="cofiAbrirReporte()">💬 Reportar</button>
  <button class="btn-flotante-sumate" onclick="cofiAbrirSumate()">✨ ¡Sumar local!</button>

  <script is:inline>
    (function iniciarBuscadorSeguro() {
        if (typeof Papa === 'undefined' || typeof L === 'undefined' || typeof L.markerClusterGroup === 'undefined') {
            setTimeout(iniciarBuscadorSeguro, 50);
            return;
        }

        const mapContenedor = document.getElementById('cofiteca-map');
        if (!mapContenedor) {
            setTimeout(iniciarBuscadorSeguro, 50);
            return;
        }

        if (window.cofitecaInicializada) return;
        window.cofitecaInicializada = true;

        if (mapContenedor._leaflet_id) {
            mapContenedor.outerHTML = '<div id="cofiteca-map" style="width: 100%; height: 100%; background: #e6e2db;"></div>';
        }

        const SHEET_ID = "10vUOhRr7IAXlRrkBphxEP4ApXYBgrnuxJq6G83GnfHI";
        const urlSheet = gid => `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&gid=${gid}`;

        const GIDS = {
            "Mar del Plata": "0", "CABA y Gran Buenos Aires": "1296176686", "La Plata": "208452991", "Córdoba": "1250014567",
            "Santa Fe": "1691979590", "Mendoza": "2031963266", "Interior de BS AS": "1634818534", "Neuquén y Río Negro": "155647820",
            "Salta y Jujuy": "1993653328", "Chubut, Santa Cruz y Tierra del Fuego": "1650814085", "San Juan, San Luis, La Rioja y La Pampa": "1228328818",
            "Corrientes, Misiones, Entre Rios, Formosa y Chaco": "1097354687", "Catamarca, Tucuman y  Santiago del Estero": "1483010757"
        };
        const TOSTADORES_GID = "1590442133";
        const IMG_FALLBACK = 'https://images.unsplash.com/photo-1559525839-b184a4d698c7?w=600';

        let baseDatos = [];
        let tostadoresDatos = [];
        let mapaCofiteca = null;
        let markerCluster = null;
        let markerOrigen = null; 
        let tostadoresRenderizados = false;

        window.cofiSwitchTab = function(tab) {
            document.getElementById('vista-mapa').classList.toggle('hidden', tab !== 'mapa');
            document.getElementById('vista-tostadores').classList.toggle('hidden', tab !== 'tostadores');
            document.getElementById('btn-tab-mapa').classList.toggle('active', tab === 'mapa');
            document.getElementById('btn-tab-tostadores').classList.toggle('active', tab === 'tostadores');
            
            if (tab === 'mapa' && mapaCofiteca) {
                setTimeout(() => mapaCofiteca.invalidateSize(), 200);
            }
            
            if (tab === 'tostadores' && !tostadoresRenderizados) {
                window.cofiRenderizarTostadores();
                tostadoresRenderizados = true;
            }
        };

        function asegurarProtocolo(url) {
            if (!url || typeof url !== 'string') return "#";
            const u = url.trim();
            return (!u || u === "#") ? "#" : (/^https?:\/\//i.test(u) ? u : 'https://' + u);
        }

        const norm = s => (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        const esc = s => String(s ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));

        function calcularD(lat1, lon1, lat2, lon2) {
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
            return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        }

        function initMapa() {
            mapaCofiteca = L.map('cofiteca-map', { maxBoundsViscosity: 1.0, minZoom: 4 }).setView([-38.41, -63.61], 4);
            
            mapaCofiteca.on('zoomend', () => {
                const mapEl = document.getElementById('cofiteca-map');
                if(mapEl) mapEl.classList.toggle('show-labels', mapaCofiteca.getZoom() >= 15);
            });

            L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
              attribution: 'Tiles &copy; Esri',
              maxZoom: 16
            }).addTo(mapaCofiteca);

            markerCluster = L.markerClusterGroup({
                maxClusterRadius: 40, disableClusteringAtZoom: 14, spiderfyOnMaxZoom: true, showCoverageOnHover: false, chunkedLoading: true
            }).addTo(mapaCofiteca);
        }

        function dibujarMapa() {
            if (!markerCluster) return;
            const ciudadFiltro = document.getElementById('select-ciudad').value;
            const zonaFiltro = document.getElementById('select-zona').value;
            const texto = norm(document.getElementById('input-busqueda').value).trim();
            
            const filtrados = baseDatos.filter(c => 
                (ciudadFiltro === "Todas" || c.ciudad === ciudadFiltro) &&
                (zonaFiltro === "Todas" || c.zona === zonaFiltro) &&
                (!texto || norm(c.nombre).includes(texto) || norm(c.ubicacion).includes(texto))
            );

            const markers = filtrados.map(c => {
                return L.circleMarker([c.lat, c.lon], { radius: 6, color: '#f5f0e8', fillColor: '#8b4513', fillOpacity: 0.9, weight: 1.5 })
                .bindPopup(`<div style="text-align:center; font-family:'Inter', sans-serif;"><b>${esc(c.nombre)}</b><br><small>${esc(c.ubicacion)}</small><br><a href="${esc(c.instagram)}" target="_blank" style="display:inline-block; margin-top:5px; background:#8b4513; color:white; padding:5px 10px; border-radius:5px; font-size:0.8rem; text-decoration:none;">Instagram</a></div>`)
                .bindTooltip(esc(c.nombre), { permanent: true, direction: 'top', className: 'cafe-label', offset: [0, -10] });
            });

            markerCluster.clearLayers();
            markerCluster.addLayers(markers);

            if (!markerOrigen) {
              if (ciudadFiltro === "Todas" && texto === "") {
                  mapaCofiteca.setView([-38.41, -63.61], 4);
              } else if (filtrados.length > 0) {
                  let lat = 0, lon = 0;
                  filtrados.forEach(c => { lat += c.lat; lon += c.lon; });
                  mapaCofiteca.setView([lat / filtrados.length, lon / filtrados.length], zonaFiltro === "Todas" ? 12 : 14);
              }
            }
        }

        function renderizarResultados(datos, origen = null) {
            const contenedor = document.getElementById('cofi-resultados');
            const frag = document.createDocumentFragment();
            let lista = datos;
            
            if (origen) {
                lista = datos.map(c => ({ ...c, dist: calcularD(origen.lat, origen.lon, c.lat, c.lon) }))
                             .sort((a, b) => a.dist - b.dist)
                             .slice(0, 30); 
            } else {
                lista = datos.slice(0, 60); 
            }

            lista.forEach(c => {
                let txtDist = "";
                if (origen && c.dist !== undefined) {
                    const cuadras = Math.round(c.dist * 10);
                    txtDist = cuadras === 0 
                      ? `<br><b style="color:#8b4513;">📍 ¡A menos de 1 cuadra!</b>` 
                      : `<br><b style="color:#8b4513;">📍 A ${cuadras} cuadra${cuadras !== 1 ? 's' : ''}</b>`;
                }
                const div = document.createElement('div');
                div.className = 'cafe-card';
                div.innerHTML = `
                    <div>
                        <h3>${esc(c.nombre)}</h3>
                        <p>${esc(c.ubicacion)} • <b>${esc(c.ciudad)}</b>${txtDist}</p>
                    </div>
                    <a href="${esc(c.instagram)}" target="_blank" rel="noopener noreferrer">Ver Instagram</a>
                `;
                frag.appendChild(div);
            });
            contenedor.replaceChildren(frag);
            
            if(!origen && datos.length > 60) {
                const aviso = document.createElement('p');
                aviso.style.cssText = "grid-column: 1/-1; text-align:center; font-size:0.9rem; opacity:0.7;";
                aviso.innerText = `Mostrando 60 de ${datos.length} resultados. Refiná tu búsqueda.`;
                contenedor.appendChild(aviso);
            }
        }

        window.cofiActualizarZonas = function() {
            const ciudadFiltro = document.getElementById('select-ciudad').value;
            let zonas = [];
            if (ciudadFiltro === "Todas") {
                zonas = [...new Set(baseDatos.map(c => c.zona))];
            } else {
                zonas = [...new Set(baseDatos.filter(c => c.ciudad === ciudadFiltro).map(c => c.zona))];
            }
            zonas = zonas.filter(z => z && z !== "-" && z !== "Sin Zona").sort();
            
            document.getElementById('select-zona').innerHTML = `<option value="Todas">Zonas / Barrios</option>` + 
                zonas.map(z => `<option value="${esc(z)}">${esc(z)}</option>`).join('');
        };

        let debounceFiltro = null;
        window.cofiFiltrar = function() {
            clearTimeout(debounceFiltro);
            debounceFiltro = setTimeout(() => {
                if (markerOrigen) {
                    mapaCofiteca.removeLayer(markerOrigen);
                    markerOrigen = null;
                    document.getElementById('cofi-status').innerText = `${baseDatos.length} cafeterías mapeadas.`;
                }
                
                const ciu = document.getElementById('select-ciudad').value;
                const zon = document.getElementById('select-zona').value;
                const txt = norm(document.getElementById('input-busqueda').value).trim();
                
                const filtrados = baseDatos.filter(c => 
                    (ciu === "Todas" || c.ciudad === ciu) &&
                    (zon === "Todas" || c.zona === zon) &&
                    (!txt || norm(c.nombre).includes(txt) || norm(c.ubicacion).includes(txt))
                );
                
                renderizarResultados(filtrados);
                dibujarMapa();
            }, 150);
        };

        window.cofiRenderizarTostadores = function() {
            const ciudad = document.getElementById('select-ciudad-tostadores').value;
            const filtrados = tostadoresDatos.filter(t => ciudad === 'Todas' || t.ciudad === ciudad);
            const contenedor = document.getElementById('lista-tostadores');
            
            if (filtrados.length === 0) {
                contenedor.innerHTML = '<p style="grid-column:1/-1; text-align:center; opacity:0.7;">No hay tostadores registrados en esta ciudad.</p>';
                return;
            }

            const frag = document.createDocumentFragment();
            filtrados.forEach(t => {
                const div = document.createElement('div');
                div.className = 'tostador-card';
                let imgUrl = (t.foto && t.foto !== "#") ? t.foto : IMG_FALLBACK;
                
                let botones = `<a href="${esc(t.ig)}" target="_blank" class="btn-outline-mad" style="margin-bottom:8px; display:block;">Instagram</a>`;
                if (t.tienda && t.tienda !== "#") {
                    botones += `<a href="${esc(t.tienda)}" target="_blank" class="btn-primary-mad" style="display:block;">Tienda Online</a>`;
                }

                div.innerHTML = `
                    <img src="${esc(imgUrl)}" class="tostador-img" loading="lazy" decoding="async" onerror="this.src='${IMG_FALLBACK}'">
                    <div class="tostador-content">
                        <div>
                            <h3 style="margin: 0 0 5px 0; font-family:'Georgia', serif; font-size:1.2rem; color:#1a0f0a;">${esc(t.nombre)}</h3>
                            <p style="margin: 0 0 15px 0; font-size:0.85rem; color:#5c3d2e;">📍 ${esc(t.ciudad)}</p>
                        </div>
                        <div>${botones}</div>
                    </div>
                `;
                frag.appendChild(div);
            });
            contenedor.replaceChildren(frag);
        };

        function cofiProcesarOrigen(lat, lon, label) {
            if (markerOrigen) mapaCofiteca.removeLayer(markerOrigen);
            markerOrigen = L.circleMarker([lat, lon], { radius: 8, color: "#059669", fillColor: "#fff", weight: 3, fillOpacity: 1 })
              .addTo(mapaCofiteca).bindPopup(label).openPopup();
            
            mapaCofiteca.setView([lat, lon], 14);
            renderizarResultados(baseDatos, { lat, lon });
        }

        window.cofiUsarMiGPS = function() {
            if (!navigator.geolocation) return Swal.fire("Error", "Tu navegador no soporta GPS.", "error");
            document.getElementById('cofi-status').innerText = "Conectando con GPS...";
            navigator.geolocation.getCurrentPosition(
                p => { 
                    document.getElementById('cofi-status').innerText = "Mostrando cafés cerca de tu ubicación actual."; 
                    cofiProcesarOrigen(p.coords.latitude, p.coords.longitude, "📍 Estás acá"); 
                },
                () => { 
                    document.getElementById('cofi-status').innerText = `${baseDatos.length} cafeterías mapeadas.`;
                    Swal.fire("Aviso", "No pudimos obtener tu ubicación. Revisá los permisos.", "warning"); 
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
            );
        };

        window.cofiMedirDesdeDireccion = function() {
            Swal.fire({
                title: '¿Dónde estás?',
                html: `<p style="font-size:0.9rem; color:#5c3d2e; margin-bottom:15px;">Escribí tu calle y ciudad (Ej: Guemes, Mar del Plata)</p>
                       <input id="swal-autocomplete-input" class="input-moderno" placeholder="Escribir..." autocomplete="off" style="width:100%; box-sizing:border-box;">
                       <div id="autocomplete-results" style="text-align:left; margin-top:10px; max-height:200px; overflow-y:auto;"></div>`,
                showConfirmButton: false, showCancelButton: true, cancelButtonText: 'Cerrar',
                customClass: { popup: 'swal-custom-popup', cancelButton: 'swal-custom-btn-cancel' },
                didOpen: () => {
                    const input = document.getElementById('swal-autocomplete-input'); 
                    const resultsContainer = document.getElementById('autocomplete-results'); 
                    let timeout = null; let solicitudId = 0;
                    input.focus();
                    input.addEventListener('input', () => {
                        clearTimeout(timeout); const val = input.value.trim();
                        if (val.length < 4) { resultsContainer.innerHTML = ''; return; }
                        resultsContainer.innerHTML = '<div style="padding:10px; color:#8b4513; font-weight:bold; text-align:center;">Buscando...</div>';
                        timeout = setTimeout(async () => {
                            const miId = ++solicitudId;
                            try {
                                const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(val)}&countrycodes=ar&addressdetails=1&limit=6`);
                                const data = await res.json();
                                if (miId !== solicitudId) return;
                                resultsContainer.innerHTML = '';
                                if (!data.length) { resultsContainer.innerHTML = '<div style="padding:10px; opacity:0.7; text-align:center;">No encontramos la dirección.</div>'; return; }
                                data.forEach(item => {
                                    const partes = [];
                                    if (item.address.road) partes.push(item.address.road + (item.address.house_number ? " " + item.address.house_number : ""));
                                    const localidad = item.address.city || item.address.town || item.address.village;
                                    if (localidad) partes.push(localidad);
                                    
                                    const nombreStr = partes.length > 0 ? partes.join(", ") : item.display_name.split(',').slice(0, 3).join(', ');
                                    const btn = document.createElement('button');
                                    btn.style.cssText = 'width: 100%; text-align: left; background: rgba(255,255,255,0.7); color: #2c1810; border: 1px solid #c4a77d; padding: 12px; border-radius: 10px; cursor: pointer; margin-bottom: 8px; font-family: "Inter", sans-serif; font-size:0.9rem; transition: 0.2s;';
                                    btn.innerHTML = `📍 <b>${esc(nombreStr)}</b>`;
                                    btn.onmouseover = () => btn.style.borderColor = '#8b4513';
                                    btn.onmouseout = () => btn.style.borderColor = '#c4a77d';
                                    btn.onclick = () => { 
                                        Swal.close(); 
                                        document.getElementById('cofi-status').innerText = `Lugares cerca de ${nombreStr}`; 
                                        cofiProcesarOrigen(parseFloat(item.lat), parseFloat(item.lon), nombreStr); 
                                    };
                                    resultsContainer.appendChild(btn);
                                });
                            } catch (e) { if (miId !== solicitudId) return; resultsContainer.innerHTML = '<div style="padding:10px; color:red; text-align:center;">Error con el mapa.</div>'; }
                        }, 800);
                    });
                }
            });
        };

        window.cofiAbrirReporte = async function() {
            const { value: formValues } = await Swal.fire({
                title: 'Reportar Novedad',
                customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
                html: `<div style="text-align: left;">
                        <select id="swal-tipo" class="swal-custom-input" style="margin-bottom:10px;">
                            <option value="Nuevo Local">☕ Sugerir nuevo local</option>
                            <option value="Local Cerrado">🚪 Local cerrado</option>
                            <option value="Dato Incorrecto">✏️ Dato incorrecto</option>
                        </select>
                        <input id="swal-local" class="swal-custom-input" placeholder="Ej: Café Gascón, MDQ" style="margin-bottom:10px;">
                        <textarea id="swal-detalle" class="swal-custom-input" placeholder="Detalles extras..." style="height:80px; resize:none;"></textarea>
                       </div>`,
                showCancelButton: true, confirmButtonText: 'Enviar', cancelButtonText: 'Cancelar',
                preConfirm: () => {
                    const local = document.getElementById('swal-local').value.trim();
                    if (!local) { Swal.showValidationMessage('Contanos el nombre del local'); return false; }
                    return { tipo: document.getElementById('swal-tipo').value, local, detalle: document.getElementById('swal-detalle').value.trim() };
                }
            });
            if (formValues) cofiEnviarReporteEmail(formValues);
        };

        window.cofiAbrirSumate = async function() {
            const { value: formValues } = await Swal.fire({
                title: '¡Sumate al Buscador!',
                customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm', cancelButton: 'swal-custom-btn-cancel' },
                html: `<div style="text-align: left;">
                        <select id="sumate-tipo" class="swal-custom-input" style="margin-bottom:10px;">
                            <option value="Cafetería / Tostaduría">☕ Cafetería / Tostaduría</option>
                        </select>
                        <input id="sumate-nombre" class="swal-custom-input" placeholder="Nombre de tu proyecto" style="margin-bottom:10px;">
                        <input id="sumate-link" class="swal-custom-input" placeholder="Instagram o Link" style="margin-bottom:10px;">
                       </div>`,
                showCancelButton: true, confirmButtonText: 'Enviar', cancelButtonText: 'Cancelar',
                preConfirm: () => {
                    const nombre = document.getElementById('sumate-nombre').value.trim();
                    if (!nombre) { Swal.showValidationMessage('Contanos el nombre de tu proyecto'); return false; }
                    return { tipo: "✨ ALTA NUEVA: " + document.getElementById('sumate-tipo').value, local: nombre, detalle: "Link/IG: " + document.getElementById('sumate-link').value.trim() };
                }
            });
            if (formValues) cofiEnviarReporteEmail(formValues);
        };

        window.cofiEnviarReporteEmail = async function(datos) {
            try {
                const URL_DESTINO = '/api/reporte'; 
                
                await fetch(URL_DESTINO + '?t=' + Date.now(), { 
                    method: 'POST', 
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, 
                    body: new URLSearchParams(datos) 
                });
                
                Swal.fire({ 
                    title: '¡Enviado!', 
                    text: 'Gracias por ayudar a mejorar la comunidad.', 
                    icon: 'success', 
                    customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } 
                }); 
            } catch (error) { 
                Swal.fire({ 
                    title: 'Error', 
                    text: 'Revisá tu conexión, el servidor no pudo procesarlo.', 
                    icon: 'error', 
                    customClass: { popup: 'swal-custom-popup', confirmButton: 'swal-custom-btn-confirm' } 
                }); 
            }
        };

        function animarContadores(cafesTotal, tostadoresTotal) {
            const cCafes = document.getElementById('stat-cafes');
            const cTostadores = document.getElementById('stat-tostadores');
            const cProvincias = document.getElementById('stat-provincias');
            const cCiudades = document.getElementById('stat-ciudades');
            
            if(cCafes) cCafes.setAttribute('data-target', cafesTotal);
            if(cTostadores) cTostadores.setAttribute('data-target', tostadoresTotal);
            if(cProvincias) cProvincias.setAttribute('data-target', 24);
            if(cCiudades) cCiudades.setAttribute('data-target', 102);

            const counters = document.querySelectorAll('.metric-number');
            const counterObserver = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  const target = +entry.target.getAttribute('data-target');
                  let current = 0;
                  const updateCounter = () => {
                    current += target / 30;
                    if (current < target) {
                      entry.target.innerText = Math.ceil(current);
                      requestAnimationFrame(updateCounter);
                    } else {
                      entry.target.innerText = target;
                    }
                  };
                  updateCounter();
                  counterObserver.unobserve(entry.target);
                }
              });
            }, { threshold: 0.3 });
            counters.forEach(c => counterObserver.observe(c));
        }

        function encenderInterfaz(datosMap, tostadoresMap) {
            const totalCafes = datosMap.length;
            const totalTostadores = tostadoresMap ? tostadoresMap.length : 0;
            document.getElementById('cofi-status').innerText = `${totalCafes} cafeterías y tostadores mapeados.`;
            
            animarContadores(totalCafes, totalTostadores);

            const ciudades = [...new Set(datosMap.map(c => c.ciudad))].sort();
            document.getElementById('select-ciudad').innerHTML = `<option value="Todas">Región / Ciudad</option>` + 
                ciudades.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
            
            window.cofiActualizarZonas();
            initMapa();
            cofiFiltrar();
            
            if (tostadoresMap && tostadoresMap.length > 0) {
                const ciudadesTost = [...new Set(tostadoresMap.map(t => t.ciudad))].sort();
                document.getElementById('select-ciudad-tostadores').innerHTML = `<option value="Todas">Todas las Ciudades</option>` + ciudadesTost.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
            }
        }

        async function cargarBaseDatos() {
            const CACHE_KEY = 'cofi_data_cache_v3';
            const CACHE_TTL = 15 * 60 * 1000; 
            
            try {
                const cacheStr = localStorage.getItem(CACHE_KEY);
                if (cacheStr) {
                    const cacheData = JSON.parse(cacheStr);
                    if (Date.now() - cacheData.time < CACHE_TTL && cacheData.data.length > 0) {
                        baseDatos = cacheData.data;
                        tostadoresDatos = cacheData.tostadores || [];
                        
                        encenderInterfaz(baseDatos, tostadoresDatos);
                        return; 
                    }
                }
            } catch (e) {
                console.warn("Caché vacía o inválida, descargando...");
            }

            try {
                const mapFetchPromises = Object.entries(GIDS).map(([ciu, gid]) =>
                    new Promise((resolve, reject) => {
                        Papa.parse(urlSheet(gid), {
                            download: true, header: true, skipEmptyLines: true,
                            transformHeader: h => h.trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''),
                            complete: res => resolve({ ciu, filas: res.data }),
                            error: reject
                        });
                    })
                );

                const tostadoresFetchPromise = new Promise((resolve, reject) => {
                    Papa.parse(urlSheet(TOSTADORES_GID), {
                        download: true, header: true, skipEmptyLines: true,
                        transformHeader: h => h.trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''),
                        complete: res => resolve(res.data),
                        error: reject
                    });
                });

                const [mapResults, tostadoresDataRaw] = await Promise.all([
                    Promise.allSettled(mapFetchPromises),
                    tostadoresFetchPromise.catch(() => [])
                ]);

                let tempData = [];
                mapResults.forEach(r => {
                    if (r.status === 'fulfilled') {
                        r.value.filas.forEach(f => {
                            if (!f.CAFE) return;
                            const latClean = parseFloat((f.LAT || f.LATITUD || '').toString().replace(',', '.'));
                            const lonClean = parseFloat((f.LONG || f.LNG || f.LONGITUD || '').toString().replace(',', '.'));
                            if (isNaN(latClean) || isNaN(lonClean)) return;
                            tempData.push({
                                nombre: f.CAFE.trim(), ciudad: r.value.ciu,
                                zona: f.ZONA || f.BARRIO || "Sin Zona",
                                ubicacion: f.UBICACION || "-", instagram: asegurarProtocolo(f.INSTAGRAM || "#"),
                                lat: latClean, lon: lonClean
                            });
                        });
                    }
                });

                tostadoresDatos = tostadoresDataRaw.map(f => ({ 
                    nombre: f.TOSTADOR || f.TOSTADORES || f.NOMBRE, 
                    ig: asegurarProtocolo(f.INSTAGRAM || f.IG || "#"), 
                    tienda: asegurarProtocolo(f['TIENDA ONLINE'] || f.TIENDA || f.LINK || "#"), 
                    ciudad: (f.CIUDAD || 'Varias').trim(), 
                    foto: asegurarProtocolo(f.IMAGENES || f.IMAGEN || f.FOTO || f.FOTOS || "#") 
                })).filter(t => t.nombre);

                if (tempData.length > 0) {
                    tempData.sort((a, b) => a.nombre.localeCompare(b.nombre));
                    baseDatos = tempData;
                    
                    try {
                        localStorage.setItem(CACHE_KEY, JSON.stringify({ time: Date.now(), data: baseDatos, tostadores: tostadoresDatos }));
                    } catch(e) { console.warn("No se pudo guardar la caché"); }

                    encenderInterfaz(baseDatos, tostadoresDatos);
                } else {
                    document.getElementById('cofi-status').innerText = 'Hubo un error al procesar las cafeterías.';
                }
            } catch (err) {
                console.error("Error global de carga:", err);
                document.getElementById('cofi-status').innerText = 'Error al cargar los datos. Revisá la conexión.';
            }
        }

        cargarBaseDatos();
    })();

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
        if (!window.cofitecaInicializada) iniciarBuscadorSeguro();
    } else {
        document.addEventListener('DOMContentLoaded', iniciarBuscadorSeguro);
    }

    document.addEventListener('astro:page-load', () => {
        window.cofitecaInicializada = false;
        iniciarBuscadorSeguro();
    });
  </script>
</body>
</html>
